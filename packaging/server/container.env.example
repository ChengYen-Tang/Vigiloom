# Copy to .env and replace all values. Keep this file private.
VIGILOOM_RUNTIME_SQL_CONNECTION=Server=sql.example;Database=Vigiloom;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=Vigiloom;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_TLS_CERT_PATH=./tls.pfx
VIGILOOM_TLS_CERT_PASSWORD=replace
VIGILOOM_SETUP_TOKEN=replace-with-a-random-value-of-at-least-32-characters
