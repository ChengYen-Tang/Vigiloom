# Copy to .env and replace all values. Keep this file private.
VIGILOOM_RUNTIME_SQL_CONNECTION=Server=sql.example;Database=Vigiloom;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=Vigiloom;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_TLS_CERT_PATH=./tls.pfx
VIGILOOM_TLS_CERT_PASSWORD=replace
VIGILOOM_SETUP_TOKEN=replace-with-a-random-value-of-at-least-32-characters
# Separate service databases for the microservices Compose deployment.
VIGILOOM_IDENTITY_SQL_CONNECTION=Server=sql.example;Database=VigiloomIdentity;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_RESOURCES_SQL_CONNECTION=Server=sql.example;Database=VigiloomResources;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_NETWORK_SQL_CONNECTION=Server=sql.example;Database=VigiloomNetwork;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_HOST_SQL_CONNECTION=Server=sql.example;Database=VigiloomHost;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_OBSERVABILITY_SQL_CONNECTION=Server=sql.example;Database=VigiloomObservability;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_OPERATIONS_SQL_CONNECTION=Server=sql.example;Database=VigiloomOperations;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_SECURITY_SQL_CONNECTION=Server=sql.example;Database=VigiloomSecurity;User ID=runtime;Password=replace;Encrypt=True
VIGILOOM_IDENTITY_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomIdentity;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_RESOURCES_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomResources;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_NETWORK_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomNetwork;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_HOST_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomHost;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_OBSERVABILITY_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomObservability;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_OPERATIONS_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomOperations;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_SECURITY_MIGRATION_SQL_CONNECTION=Server=sql.example;Database=VigiloomSecurity;User ID=deployment;Password=replace;Encrypt=True
VIGILOOM_TEMPORAL_DB_PASSWORD=replace-with-a-random-password
