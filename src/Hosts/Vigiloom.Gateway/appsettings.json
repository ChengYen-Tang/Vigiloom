{
  "Services": {
    "vigiloom-web": { "http": ["localhost:5043"] },
    "vigiloom-agent": { "http": ["localhost:5043"] },
    "vigiloom-observability": { "http": ["localhost:5043"] }
  },
  "ReverseProxy": {
    "Routes": {
      "agent": {
        "ClusterId": "agent",
        "Match": { "Path": "/api/v1/agent/{**remainder}" }
      },
      "otlp": {
        "ClusterId": "observability",
        "Match": { "Path": "/api/v1/otlp/{**remainder}" }
      },
      "web": {
        "ClusterId": "web",
        "Match": { "Path": "/{**remainder}" }
      }
    },
    "Clusters": {
      "web": {
        "Destinations": { "web": { "Address": "http://vigiloom-web/" } }
      },
      "agent": {
        "Destinations": { "agent": { "Address": "http://vigiloom-agent/" } }
      },
      "observability": {
        "Destinations": { "observability": { "Address": "http://vigiloom-observability/" } }
      }
    }
  }
}
