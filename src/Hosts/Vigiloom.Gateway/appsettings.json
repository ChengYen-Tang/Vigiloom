{
  "Services": {
    "vigiloom-web": {
      "http": [
        "localhost:5043"
      ]
    },
    "vigiloom-agent": {
      "http": [
        "localhost:5043"
      ]
    },
    "vigiloom-observability": {
      "http": [
        "localhost:5043"
      ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "agent": {
        "ClusterId": "agent",
        "Match": {
          "Path": "/api/v1/agent/{**remainder}"
        }
      },
      "otlp": {
        "ClusterId": "observability",
        "Match": {
          "Path": "/api/v1/otlp/{**remainder}"
        }
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**remainder}"
        }
      },
      "devices-read": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "MonitoringApiRead",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "devices-write": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "DeviceWrite",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "devices-unmapped": {
        "ClusterId": "web",
        "Order": -9,
        "AuthorizationPolicy": "DenyUnmappedDeviceMethod",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}"
        }
      }
    },
    "Clusters": {
      "web": {
        "Destinations": {
          "web": {
            "Address": "http://vigiloom-web/"
          }
        }
      },
      "agent": {
        "Destinations": {
          "agent": {
            "Address": "http://vigiloom-agent/"
          }
        }
      },
      "observability": {
        "Destinations": {
          "observability": {
            "Address": "http://vigiloom-observability/"
          }
        }
      }
    }
  }
}
