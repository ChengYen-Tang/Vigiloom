{
  "Services": {
    "vigiloom-web": {
      "http": [
        "localhost:5043"
      ]
    },
    "vigiloom-agent": {
      "http": [
        "localhost:5043"
      ]
    },
    "vigiloom-observability": {
      "http": [
        "localhost:5057"
      ]
    },
    "vigiloom-network": {
      "http": [
        "localhost:5056"
      ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "observability-service-detail": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-details/{id:guid}", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-service-instances": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-details/{id:guid}/instances", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-service-logs": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-details/{id:guid}/logs", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-service-traces": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-details/{id:guid}/traces", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-service-http-metrics": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-details/{id:guid}/http-metrics", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-service-health-observations": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-details/{id:guid}/health-observations", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-health-status": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-health/{id:guid}/status", "Methods": [ "GET", "HEAD" ] }
      },
      "observability-health-history": {
        "ClusterId": "observability", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/service-health/{id:guid}/history", "Methods": [ "GET", "HEAD" ] }
      },
      "network-public-ping": {
        "ClusterId": "network", "Order": -20,
        "Match": { "Path": "/api/v1/public/devices/{id:guid}/ping/{**remainder}", "Methods": [ "GET", "HEAD" ] }
      },
      "network-ping": {
        "ClusterId": "network", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/devices/{id:guid}/ping/{**remainder}", "Methods": [ "GET", "HEAD" ] }
      },
      "network-speed-read": {
        "ClusterId": "network", "Order": -20, "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/speed-tests/{**remainder}", "Methods": [ "GET", "HEAD" ] }
      },
      "network-speed-cancel": {
        "ClusterId": "network", "Order": -20, "AuthorizationPolicy": "GatewayAdministrator",
        "Match": { "Path": "/api/v1/speed-tests/{id:guid}/cancel", "Methods": [ "POST" ] }
      },
      "network-ping-settings": {
        "ClusterId": "network", "Order": -20, "AuthorizationPolicy": "GatewayAdministrator",
        "Match": { "Path": "/api/v1/settings/ping/{**remainder}" }
      },
      "network-speed-settings": {
        "ClusterId": "network", "Order": -20, "AuthorizationPolicy": "GatewayAdministrator",
        "Match": { "Path": "/api/v1/settings/speed-tests/{**remainder}" }
      },
      "network-speed-retention": {
        "ClusterId": "network", "Order": -20, "AuthorizationPolicy": "GatewayAdministrator",
        "Match": { "Path": "/api/v1/settings/speed-retention/{**remainder}" }
      },
      "agent": {
        "ClusterId": "agent",
        "Order": -15,
        "Match": {
          "Path": "/api/v1/agent/{**remainder}"
        },
        "AuthorizationPolicy": "GatewayAgent"
      },
      "otlp": {
        "ClusterId": "observability",
        "Order": -15,
        "Match": {
          "Path": "/api/v1/otlp/{**remainder}"
        },
        "AuthorizationPolicy": "GatewaySource"
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**remainder}"
        }
      },
      "public-status": {
        "ClusterId": "web",
        "Order": -15,
        "Match": { "Path": "/api/v1/public/{**remainder}" }
      },
      "line-webhook": {
        "ClusterId": "web",
        "Order": -15,
        "Match": { "Path": "/api/v1/line/webhook", "Methods": [ "POST" ] }
      },
      "api": {
        "ClusterId": "web",
        "AuthorizationPolicy": "MonitoringApiRead",
        "Match": { "Path": "/api/v1/{**remainder}" }
      },
      "devices-read": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "MonitoringApiRead",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "devices-write": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "DeviceWrite",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "devices-unmapped": {
        "ClusterId": "web",
        "Order": -9,
        "AuthorizationPolicy": "DenyUnmappedDeviceMethod",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}"
        }
      },
      "groups-read": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "MonitoringApiRead",
        "Match": {
          "Path": "/api/v1/groups/{**remainder}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "groups-write": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "DeviceWrite",
        "Match": {
          "Path": "/api/v1/groups/{**remainder}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "groups-unmapped": {
        "ClusterId": "web",
        "Order": -9,
        "AuthorizationPolicy": "DenyUnmappedDeviceMethod",
        "Match": {
          "Path": "/api/v1/groups/{**remainder}"
        }
      },
      "administrator-accounts": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "GatewayAdministrator",
        "Match": {
          "Path": "/api/v1/accounts/{**remainder}"
        }
      },
      "administrator-agent-management": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "GatewayAdministrator",
        "Match": {
          "Path": "/api/v1/agent-management/{**remainder}"
        }
      },
      "administrator-settings": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "GatewayAdministrator",
        "Match": {
          "Path": "/api/v1/settings/{**remainder}"
        }
      },
      "agent-enrollment": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/enroll",
          "Methods": [
            "POST"
          ]
        }
      },
      "agent-recovery": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/recover",
          "Methods": [
            "POST"
          ]
        }
      },
      "agent-rotation-start": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/rotation/start",
          "Methods": [
            "POST"
          ]
        }
      },
      "agent-rotation-finish": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/rotation/finish",
          "Methods": [
            "POST"
          ]
        }
      },
      "source-observation": {
        "ClusterId": "observability",
        "Order": -15,
        "AuthorizationPolicy": "GatewaySource",
        "Match": {
          "Path": "/api/v1/service-discovery/observations",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "network": {
        "Destinations": { "network": { "Address": "http://vigiloom-network/" } }
      },
      "web": {
        "SessionAffinity": {
          "Enabled": true,
          "AffinityKeyName": ".Vigiloom.WebAffinity"
        },
        "Destinations": {
          "web": {
            "Address": "http://vigiloom-web/"
          }
        }
      },
      "agent": {
        "Destinations": {
          "agent": {
            "Address": "http://vigiloom-agent/"
          }
        }
      },
      "observability": {
        "Destinations": {
          "observability": {
            "Address": "http://vigiloom-observability/"
          }
        }
      }
    }
  }
}
