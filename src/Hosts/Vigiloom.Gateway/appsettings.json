{
  "Services": {
    "vigiloom-web": { "http": ["localhost:5043"] }
  },
  "ReverseProxy": {
    "Routes": {
      "web": {
        "ClusterId": "web",
        "Match": { "Path": "/{**remainder}" }
      }
    },
    "Clusters": {
      "web": {
        "Destinations": {
          "web": { "Address": "http://vigiloom-web/" }
        }
      }
    }
  }
}
