{
  "Services": {
    "vigiloom-web": {
      "http": [
        "localhost:5043"
      ]
    },
    "vigiloom-agent": {
      "http": [
        "localhost:5043"
      ]
    },
    "vigiloom-observability": {
      "http": [
        "localhost:5043"
      ]
    }
  },
  "ReverseProxy": {
    "Routes": {
      "agent": {
        "ClusterId": "agent",
        "Match": {
          "Path": "/api/v1/agent/{**remainder}"
        },
        "AuthorizationPolicy": "GatewayAgent"
      },
      "otlp": {
        "ClusterId": "observability",
        "Match": {
          "Path": "/api/v1/otlp/{**remainder}"
        },
        "AuthorizationPolicy": "GatewaySource"
      },
      "web": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**remainder}"
        }
      },
      "devices-read": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "MonitoringApiRead",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "devices-write": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "DeviceWrite",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "devices-unmapped": {
        "ClusterId": "web",
        "Order": -9,
        "AuthorizationPolicy": "DenyUnmappedDeviceMethod",
        "Match": {
          "Path": "/api/v1/devices/{**remainder}"
        }
      },
      "groups-read": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "MonitoringApiRead",
        "Match": {
          "Path": "/api/v1/groups/{**remainder}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "groups-write": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "DeviceWrite",
        "Match": {
          "Path": "/api/v1/groups/{**remainder}",
          "Methods": [
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "groups-unmapped": {
        "ClusterId": "web",
        "Order": -9,
        "AuthorizationPolicy": "DenyUnmappedDeviceMethod",
        "Match": {
          "Path": "/api/v1/groups/{**remainder}"
        }
      },
      "administrator-accounts": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "GatewayAdministrator",
        "Match": {
          "Path": "/api/v1/accounts/{**remainder}"
        }
      },
      "administrator-agent-management": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "GatewayAdministrator",
        "Match": {
          "Path": "/api/v1/agent-management/{**remainder}"
        }
      },
      "administrator-settings": {
        "ClusterId": "web",
        "Order": -10,
        "AuthorizationPolicy": "GatewayAdministrator",
        "Match": {
          "Path": "/api/v1/settings/{**remainder}"
        }
      },
      "agent-enrollment": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/enroll",
          "Methods": [
            "POST"
          ]
        }
      },
      "agent-recovery": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/recover",
          "Methods": [
            "POST"
          ]
        }
      },
      "agent-rotation-start": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/rotation/start",
          "Methods": [
            "POST"
          ]
        }
      },
      "agent-rotation-finish": {
        "ClusterId": "agent",
        "Order": -20,
        "Match": {
          "Path": "/api/v1/agent/rotation/finish",
          "Methods": [
            "POST"
          ]
        }
      },
      "source-observation": {
        "ClusterId": "observability",
        "AuthorizationPolicy": "GatewaySource",
        "Match": {
          "Path": "/api/v1/service-discovery/observations",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "web": {
        "Destinations": {
          "web": {
            "Address": "http://vigiloom-web/"
          }
        }
      },
      "agent": {
        "Destinations": {
          "agent": {
            "Address": "http://vigiloom-agent/"
          }
        }
      },
      "observability": {
        "Destinations": {
          "observability": {
            "Address": "http://vigiloom-observability/"
          }
        }
      }
    }
  }
}
