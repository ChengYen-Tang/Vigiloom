@page "/account/two-factor"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-login")]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Http.HttpResults
@using Microsoft.AspNetCore.Identity
@using Vigiloom.Modules.IdentityAccess.Domain
@inject Vigiloom.Web.Authentication.TwoFactorChallenge Challenge
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<TwoFactorText> L

<PageTitle>@L["Title"] - Vigiloom</PageTitle>
<section class="account-card" aria-labelledby="two-factor-title">
    <h1 id="two-factor-title">@L["Title"]</h1>
    <p class="account-description">@L["Description"]</p>
    @if (error is not null) { <p class="account-error" role="alert">@error</p> }
    <EditForm Model="TotpInput" FormName="totp-login" method="post" OnValidSubmit="LoginWithAuthenticatorAsync">
        <DataAnnotationsValidator />
        <div class="account-field"><label for="totp-code">@L["VerificationCode"]</label><input id="totp-code" name="TotpInput.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="16" required /><ValidationMessage For="() => TotpInput.Code" /></div>
        <button class="account-primary" type="submit">@L["VerifyAndSignIn"]</button>
    </EditForm>
    <details class="account-secondary"><summary>@L["UseRecovery"]</summary>
        <EditForm Model="RecoveryInput" FormName="recovery-login" method="post" OnValidSubmit="LoginWithRecoveryAsync">
            <DataAnnotationsValidator />
            <div class="account-field"><label for="recovery-code">@L["RecoveryCode"]</label><input id="recovery-code" name="RecoveryInput.Code" autocomplete="off" maxlength="64" required /><ValidationMessage For="() => RecoveryInput.Code" /></div>
            <button class="management-button" type="submit">@L["SignInWithRecovery"]</button>
        </EditForm>
    </details>
    <p class="account-footer"><a href="/account/login">@L["BackToSignIn"]</a></p>
</section>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string? error;
    [SupplyParameterFromForm(FormName = "totp-login")] private CodeModel TotpInput { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "recovery-login")] private CodeModel RecoveryInput { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private bool Remember { get; set; }
    protected override async Task OnInitializedAsync()
    {
        TotpInput ??= new(); RecoveryInput ??= new();
        if (!await Challenge.HasPendingAsync(HttpContext))
            Navigation.NavigateTo("/account/login", forceLoad: true);
    }
    private async Task LoginWithAuthenticatorAsync()
    {
        var code = TotpInput.Code.Replace(" ", "", StringComparison.Ordinal).Replace("-", "", StringComparison.Ordinal);
        var result = await Challenge.CompleteAsync(HttpContext, code, recovery: false, Remember, HttpContext.RequestAborted);
        Complete(result);
    }
    private async Task LoginWithRecoveryAsync()
    {
        var result = await Challenge.CompleteAsync(HttpContext, RecoveryInput.Code.Trim(), recovery: true, Remember, HttpContext.RequestAborted);
        Complete(result);
    }
    private void Complete(SignInResult result)
    {
        TotpInput.Code = RecoveryInput.Code = "";
        if (result.Succeeded)
        {
            Navigation.NavigateTo(RedirectHttpResult.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/", forceLoad: true);
            return;
        }
        error = L["InvalidCode"];
    }
    private sealed class CodeModel
    {
        [Required(ErrorMessageResourceType = typeof(TwoFactorText), ErrorMessageResourceName = nameof(TwoFactorText.RequiredCode))]
        [StringLength(64, ErrorMessageResourceType = typeof(TwoFactorText), ErrorMessageResourceName = nameof(TwoFactorText.CodeLength))]
        public string Code { get; set; } = "";
    }
}
