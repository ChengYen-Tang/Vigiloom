@page "/account/reset-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-login")]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Vigiloom.Web.Authentication
@inject AccountPasswordReset PasswordReset
@inject NavigationManager Navigation

<PageTitle>設定密碼 - Vigiloom</PageTitle>
<section class="account-card" aria-labelledby="reset-title">
    <h1 id="reset-title">設定密碼</h1>
    <p class="account-description">請輸入管理員提供的一次性代碼。</p>
    @if (error is not null) { <p class="account-error" role="alert">@error</p> }
    <EditForm Model="Input" FormName="reset-password" method="post" OnValidSubmit="ResetAsync">
        <DataAnnotationsValidator />
        <div class="account-field"><label for="reset-name">帳號</label><InputText id="reset-name" @bind-Value="Input.UserName" autocomplete="username" maxlength="256" required /><ValidationMessage For="() => Input.UserName" /></div>
        <div class="account-field"><label for="reset-code">一次性代碼</label><textarea id="reset-code" name="Input.Code" rows="4" maxlength="2048" required></textarea><ValidationMessage For="() => Input.Code" /></div>
        <div class="account-field"><label for="reset-password">新密碼</label><input id="reset-password" name="Input.Password" type="password" autocomplete="new-password" maxlength="1024" required /><ValidationMessage For="() => Input.Password" /><span class="account-hint">至少 12 個字元，包含大小寫英文字母、數字及符號。</span></div>
        <div class="account-field"><label for="reset-confirm">確認新密碼</label><input id="reset-confirm" name="Input.ConfirmPassword" type="password" autocomplete="new-password" maxlength="1024" required /><ValidationMessage For="() => Input.ConfirmPassword" /></div>
        <button class="account-primary" type="submit">設定密碼</button>
    </EditForm>
    <p class="account-footer"><a href="/account/login">返回登入</a></p>
</section>

@code {
    private string? error;
    [SupplyParameterFromForm] private ResetInput Input { get; set; } = default!;
    protected override void OnInitialized() => Input ??= new();
    private async Task ResetAsync()
    {
        var success = await PasswordReset.RedeemAsync(Input.UserName, Input.Code, Input.Password);
        Input.Code = Input.Password = Input.ConfirmPassword = "";
        if (success) { Navigation.NavigateTo("/account/login?setup=complete", forceLoad: true); return; }
        error = "無法設定密碼，請確認帳號、代碼與密碼規則，或向管理員取得新代碼。";
    }
    private sealed class ResetInput
    {
        [Required(ErrorMessage = "請輸入帳號。"), StringLength(256)] public string UserName { get; set; } = "";
        [Required(ErrorMessage = "請輸入一次性代碼。"), StringLength(2048)] public string Code { get; set; } = "";
        [Required(ErrorMessage = "請輸入新密碼。"), StringLength(1024)] public string Password { get; set; } = "";
        [Required, StringLength(1024), Compare(nameof(Password), ErrorMessage = "兩次密碼不一致。")] public string ConfirmPassword { get; set; } = "";
    }
}
