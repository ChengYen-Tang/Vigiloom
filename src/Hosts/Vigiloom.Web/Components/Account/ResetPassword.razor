@page "/account/reset-password"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-login")]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Vigiloom.Web.Authentication
@inject Vigiloom.Web.Authentication.AccountPasswordOperations PasswordReset
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<ResetPasswordText> L
@inject Microsoft.Extensions.Localization.IStringLocalizer<SetupText> SetupL

<PageTitle>@L["Title"] - Vigiloom</PageTitle>
<section class="account-card" aria-labelledby="reset-title">
    <h1 id="reset-title">@L["Title"]</h1>
    <p class="account-description">@L["Description"]</p>
    @if (error is not null) { <p class="account-error" role="alert">@error</p> }
    <EditForm Model="Input" FormName="reset-password" method="post" OnValidSubmit="ResetAsync">
        <DataAnnotationsValidator />
        <div class="account-field"><label for="reset-name">@L["UserName"]</label><InputText id="reset-name" @bind-Value="Input.UserName" autocomplete="username" maxlength="256" required /><ValidationMessage For="() => Input.UserName" /></div>
        <div class="account-field"><label for="reset-code">@L["Code"]</label><textarea id="reset-code" name="Input.Code" rows="4" maxlength="2048" required></textarea><ValidationMessage For="() => Input.Code" /></div>
        <div class="account-field"><label for="reset-password">@L["NewPassword"]</label><input id="reset-password" name="Input.Password" type="password" autocomplete="new-password" maxlength="1024" required /><ValidationMessage For="() => Input.Password" /><span class="account-hint">@SetupL["PasswordHint"]</span></div>
        <div class="account-field"><label for="reset-confirm">@L["ConfirmPassword"]</label><input id="reset-confirm" name="Input.ConfirmPassword" type="password" autocomplete="new-password" maxlength="1024" required /><ValidationMessage For="() => Input.ConfirmPassword" /></div>
        <button class="account-primary" type="submit">@L["Title"]</button>
    </EditForm>
    <p class="account-footer"><a href="/account/login">@L["BackToSignIn"]</a></p>
</section>

@code {
    private string? error;
    [SupplyParameterFromForm] private ResetInput Input { get; set; } = default!;
    protected override void OnInitialized() => Input ??= new();
    private async Task ResetAsync()
    {
        var success = await PasswordReset.RedeemAsync(Input.UserName, Input.Code, Input.Password);
        Input.Code = Input.Password = Input.ConfirmPassword = "";
        if (success) { Navigation.NavigateTo("/account/login?setup=complete", forceLoad: true); return; }
        error = L["ResetFailed"];
    }
    private sealed class ResetInput
    {
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredUserName))]
        [StringLength(256, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.UserNameLength))] public string UserName { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ResetPasswordText), ErrorMessageResourceName = nameof(ResetPasswordText.RequiredCode))]
        [StringLength(2048, ErrorMessageResourceType = typeof(ResetPasswordText), ErrorMessageResourceName = nameof(ResetPasswordText.CodeLength))] public string Code { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(ResetPasswordText), ErrorMessageResourceName = nameof(ResetPasswordText.RequiredPassword))]
        [StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))] public string Password { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(SetupText), ErrorMessageResourceName = nameof(SetupText.RequiredConfirmation))]
        [StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(SetupText), ErrorMessageResourceName = nameof(SetupText.PasswordMismatch))] public string ConfirmPassword { get; set; } = "";
    }
}
