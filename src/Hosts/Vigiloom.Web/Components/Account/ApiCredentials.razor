@page "/account/api-credentials"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = AccessPolicies.Administrator)]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-login")]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Vigiloom.Web.Authentication
@inject Microsoft.Extensions.Localization.IStringLocalizer<CredentialText> L
@inject Vigiloom.Web.Authentication.CredentialManagement Credentials

<PageTitle>@L["API 憑證 - Vigiloom"]</PageTitle>
<main class="management-page">
    <h1>@L["API 憑證"]</h1>
    <p class="management-intro">@L["讓外部程式以獨立憑證呼叫授權的監控 API。帳號管理仍需管理員登入。"]</p>
    @if (error is not null) { <p class="account-error" role="alert">@error</p> }
    @if (message is not null) { <p class="account-success" role="status">@message</p> }
    @if (secret is not null)
    {
        <section class="management-notice" aria-labelledby="credential-created">
            <h2 id="credential-created">@L["請立即保存憑證"]</h2>
            <p>@L["完整憑證只顯示這一次。請安全交給呼叫程式，勿貼到網址或公開記錄；遺失時請建立新憑證並撤銷舊憑證。"]</p>
            <textarea readonly rows="3" aria-label="@L["一次性 API 憑證"]">@secret</textarea>
        </section>
    }
    <section class="management-panel" aria-labelledby="issue-title">
        <h2 id="issue-title">@L["建立憑證"]</h2>
        <EditForm Model="IssueInput" FormName="issue-api-credential" method="post" OnValidSubmit="IssueAsync">
            <DataAnnotationsValidator />
            <div class="management-form">
                <div class="account-field"><label for="credential-name">@L["用途名稱"]</label><InputText id="credential-name" @bind-Value="IssueInput.Name" maxlength="128" required /><ValidationMessage For="() => IssueInput.Name" /></div>
                <div class="account-field"><label for="credential-days">@L["有效天數（1–365）"]</label><InputNumber id="credential-days" @bind-Value="IssueInput.Days" min="1" max="365" /><ValidationMessage For="() => IssueInput.Days" /></div>
                <label class="account-checkbox"><InputCheckbox @bind-Value="IssueInput.CanWrite" /> @L["允許管理監控設定（含讀取）"]</label>
                <div class="account-field"><label for="issue-password">@L["管理員密碼"]</label><input id="issue-password" name="IssueInput.Password" type="password" autocomplete="current-password" maxlength="1024" required /></div>
                <button class="management-button" type="submit">@L["建立並顯示憑證"]</button>
            </div>
        </EditForm>
    </section>
    <section class="management-panel" aria-labelledby="credentials-title">
        <h2 id="credentials-title">@L["憑證列表"]</h2>
        <p>@L["輪替時先建立並部署新憑證，確認可用後再撤銷舊憑證。撤銷後會立即生效。"]</p>
        @if (credentials.Credentials.Count == 0)
        {
            <p>@L["此頁沒有憑證。建立憑證後，即可在此查看狀態。"]</p>
        }
        else
        {
            <div class="management-table-wrap"><table><thead><tr><th scope="col">@L["用途"]</th><th scope="col">@L["權限"]</th><th scope="col">@L["到期時間（UTC）"]</th><th scope="col">@L["狀態"]</th></tr></thead><tbody>
                @foreach (var credential in credentials.Credentials)
                {
                    <tr><td>@credential.Name</td><td>@(credential.CanWrite ? L["讀取及管理監控"].Value : L["唯讀監控"].Value)</td><td>@credential.ExpiresAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td><td>@Status(credential)</td></tr>
                }
            </tbody></table></div>
        }
        <nav class="management-pagination" aria-label="@L["憑證列表分頁"]">
            <span>@L["共 {0} 個憑證", credentials.TotalCount]</span>
            @if (credentials.Page > 1) { <a href="@($"/account/api-credentials?page={credentials.Page - 1}")">@L["上一頁"]</a> }
            @if ((long)credentials.Page * credentials.PageSize < credentials.TotalCount) { <a href="@($"/account/api-credentials?page={credentials.Page + 1}")">@L["下一頁"]</a> }
        </nav>
    </section>
    @if (credentials.Credentials.Any(x => x.RevokedAt is null))
    {
    <section class="management-panel" aria-labelledby="revoke-title">
        <h2 id="revoke-title">@L["撤銷憑證"]</h2>
        <EditForm Model="RevokeInput" FormName="revoke-api-credential" method="post" OnValidSubmit="RevokeAsync">
            <DataAnnotationsValidator />
            <div class="management-form">
                <div class="account-field"><label for="credential-revoke">@L["選擇本頁憑證"]</label><InputSelect id="credential-revoke" @bind-Value="RevokeInput.Id"><option value="">@L["請選擇"]</option>@foreach (var credential in credentials.Credentials.Where(x => x.RevokedAt is null)) { <option value="@credential.Id">@credential.Name (@credential.Id)</option> }</InputSelect><ValidationMessage For="() => RevokeInput.Id" /></div>
                <div class="account-field"><label for="revoke-password">@L["管理員密碼"]</label><input id="revoke-password" name="RevokeInput.Password" type="password" autocomplete="current-password" maxlength="1024" required /></div>
                <label class="account-checkbox"><InputCheckbox @bind-Value="RevokeInput.Confirmed" /> @L["我了解撤銷後使用此憑證的程式會立即無法存取"]</label>
                <button class="management-danger" type="submit">@L["撤銷憑證"]</button>
            </div>
        </EditForm>
    </section>
    }
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "issue-api-credential")] private IssueModel IssueInput { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "revoke-api-credential")] private RevokeModel RevokeInput { get; set; } = default!;
    private ApiCredentialPage credentials = new([], 0, 1, 50);
    [SupplyParameterFromQuery] private int? Page { get; set; }
    private string? secret;
    private string? error;
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        IssueInput ??= new(); RevokeInput ??= new();
        HttpContext.Response.Headers.CacheControl = "no-store";
        await LoadAsync();
    }
    private Task LoadAsync() => LoadCoreAsync();
    private async Task LoadCoreAsync() => credentials = await Credentials.ListAsync(HttpContext.User, Math.Clamp(Page ?? 1, 1, int.MaxValue / 50), HttpContext.RequestAborted);
    private async Task IssueAsync()
    {
        var result = await Credentials.IssueAsync(HttpContext.User, IssueInput.Name, IssueInput.CanWrite, IssueInput.Days, IssueInput.Password, HttpContext.RequestAborted);
        IssueInput.Password = "";
        if (result.Status != ApiCredentialStatus.Success) { error = L["無法建立憑證，請確認輸入及管理員密碼。"].Value; return; }
        secret = result.Secret;
        IssueInput.Name = "";
        await LoadAsync();
    }
    private async Task RevokeAsync()
    {
        if (!RevokeInput.Confirmed || !Guid.TryParse(RevokeInput.Id, out var id)) { error = L["請選擇憑證並確認撤銷影響。"].Value; return; }
        var result = await Credentials.RevokeAsync(HttpContext.User, id, RevokeInput.Password, HttpContext.RequestAborted);
        RevokeInput.Password = "";
        if (result != ApiCredentialStatus.Success) { error = L["無法撤銷憑證，請確認選擇及管理員密碼。"].Value; return; }
        message = L["憑證已撤銷。"].Value;
        await LoadAsync();
    }
    private string Status(ApiCredentialSummary credential) => credential.RevokedAt is not null ? L["已撤銷"].Value : credential.ExpiresAt <= DateTimeOffset.UtcNow ? L["已到期"].Value : L["有效"].Value;
    private sealed class IssueModel
    {
        [Required(ErrorMessageResourceType = typeof(CredentialText), ErrorMessageResourceName = nameof(CredentialText.RequiredName)), StringLength(128, ErrorMessageResourceType = typeof(CredentialText), ErrorMessageResourceName = nameof(CredentialText.NameLength))] public string Name { get; set; } = "";
        [Range(1, 365, ErrorMessageResourceType = typeof(CredentialText), ErrorMessageResourceName = nameof(CredentialText.ValidityRange))] public int Days { get; set; } = 90;
        public bool CanWrite { get; set; }
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredPassword)), StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))] public string Password { get; set; } = "";
    }
    private sealed class RevokeModel
    {
        [Required(ErrorMessageResourceType = typeof(CredentialText), ErrorMessageResourceName = nameof(CredentialText.RequiredSelection))] public string Id { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredPassword)), StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))] public string Password { get; set; } = "";
        public bool Confirmed { get; set; }
    }
}
