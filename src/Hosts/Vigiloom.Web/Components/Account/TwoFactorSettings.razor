@page "/account/two-factor-settings"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-login")]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using QRCoder
@using Vigiloom.Modules.IdentityAccess.Domain
@using Vigiloom.Web.Authentication
@inject Microsoft.Extensions.Localization.IStringLocalizer<AccountActionText> L
@inject Vigiloom.Web.Authentication.TwoFactorSettings Management

<PageTitle>@L["雙重驗證設定 - Vigiloom"]</PageTitle>
<section class="account-card" aria-labelledby="settings-title">
    <h1 id="settings-title">@L["雙重驗證"]</h1>
    <p class="account-description">@L["使用驗證器 App 為帳號增加一層保護。"]</p>
    @if (message is not null) { <p class="@(isError ? "account-error" : "account-success")" role="status">@message</p> }
    @if (recoveryCodes is not null)
    {
        <div class="management-notice"><h2>@L["保存復原碼"]</h2><p>@L["每個復原碼僅能使用一次。請妥善保存；離開後無法再次查看。"]</p><textarea readonly rows="10" aria-label="@L["雙重驗證復原碼"]">@string.Join(Environment.NewLine, recoveryCodes)</textarea></div>
    }
    @if (!enabled)
    {
        <EditForm Model="BeginInput" FormName="begin-two-factor" method="post" OnValidSubmit="BeginAsync">
            <DataAnnotationsValidator />
            <div class="account-field"><label for="begin-password">@L["目前密碼"]</label><input id="begin-password" name="BeginInput.Password" type="password" autocomplete="current-password" maxlength="1024" required /><ValidationMessage For="() => BeginInput.Password" /></div>
            <button class="account-primary" type="submit">@L["設定驗證器"]</button>
        </EditForm>
        @if (key is not null)
        {
            <div class="account-qr"><p>@L["使用驗證器 App 掃描 QR code，或手動輸入下方密鑰。"]</p><img src="@qrData" alt="@L["驗證器設定 QR code"]" /><code>@key</code></div>
        }
        @if (pending)
        {
            <EditForm Model="ConfirmInput" FormName="enable-two-factor" method="post" OnValidSubmit="EnableAsync">
                <DataAnnotationsValidator />
                <div class="account-field"><label for="confirm-totp">@L["驗證器代碼"]</label><input id="confirm-totp" name="ConfirmInput.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="16" required /><ValidationMessage For="() => ConfirmInput.Code" /></div>
                <button class="account-primary" type="submit">@L["啟用雙重驗證"]</button>
            </EditForm>
        }
    }
    else
    {
        <p>@L["雙重驗證已啟用。"]</p>
        <EditForm Model="DisableInput" FormName="disable-two-factor" method="post" OnValidSubmit="DisableAsync">
            <DataAnnotationsValidator />
            <div class="account-field"><label for="disable-password">@L["目前密碼"]</label><input id="disable-password" name="DisableInput.Password" type="password" autocomplete="current-password" maxlength="1024" required /><ValidationMessage For="() => DisableInput.Password" /></div>
            <div class="account-field"><label for="disable-code">@L["驗證器代碼或復原碼"]</label><input id="disable-code" name="DisableInput.Code" autocomplete="one-time-code" maxlength="64" required /><ValidationMessage For="() => DisableInput.Code" /></div>
            <button class="management-danger" type="submit">@L["停用雙重驗證"]</button>
        </EditForm>
    }
    <p class="account-footer"><a href="/">@L["返回總覽"]</a></p>
</section>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "begin-two-factor")] private PasswordModel BeginInput { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "enable-two-factor")] private CodeModel ConfirmInput { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "disable-two-factor")] private DisableModel DisableInput { get; set; } = default!;
    private bool enabled;
    private bool pending;
    private bool isError;
    private string? message;
    private string? key;
    private string? qrData;
    private IReadOnlyList<string>? recoveryCodes;
    protected override async Task OnInitializedAsync()
    {
        BeginInput ??= new(); ConfirmInput ??= new(); DisableInput ??= new();
        HttpContext.Response.Headers.CacheControl = "no-store";
        var state = await Management.StateAsync(HttpContext.User, HttpContext.RequestAborted);
        enabled = state.Enabled;
        pending = state.Pending;
    }
    private async Task BeginAsync()
    {
        var persistent = (await HttpContext.AuthenticateAsync(IdentityConstants.ApplicationScheme)).Properties?.IsPersistent ?? false;
        var result = await Management.BeginAsync(HttpContext.User, BeginInput.Password, HttpContext.RequestAborted);
        BeginInput.Password = "";
        if (result.Status != TwoFactorStatus.Success || result.Key is null) { Fail(); return; }
        await RenewCookieAsync(persistent);
        key = result.Key;
        pending = true;
        var accountName = HttpContext.User.Identity?.Name ?? "account";
        var uri = $"otpauth://totp/Vigiloom:{Uri.EscapeDataString(accountName)}?secret={Uri.EscapeDataString(key)}&issuer=Vigiloom&digits=6&period=30";
        using var generator = new QRCodeGenerator();
        using var qr = generator.CreateQrCode(uri, QRCodeGenerator.ECCLevel.Q);
        using var png = new PngByteQRCode(qr);
        qrData = "data:image/png;base64," + Convert.ToBase64String(png.GetGraphic(6));
    }
    private async Task EnableAsync()
    {
        var persistent = (await HttpContext.AuthenticateAsync(IdentityConstants.ApplicationScheme)).Properties?.IsPersistent ?? false;
        var result = await Management.EnableAsync(HttpContext.User, ConfirmInput.Code.Replace(" ", "", StringComparison.Ordinal), HttpContext.RequestAborted);
        ConfirmInput.Code = "";
        if (result.Status != TwoFactorStatus.Success) { Fail(); return; }
        await RenewCookieAsync(persistent);
        enabled = true;
        recoveryCodes = result.RecoveryCodes;
        message = L["雙重驗證已啟用。"].Value;
    }
    private async Task DisableAsync()
    {
        var persistent = (await HttpContext.AuthenticateAsync(IdentityConstants.ApplicationScheme)).Properties?.IsPersistent ?? false;
        var result = await Management.DisableAsync(HttpContext.User, DisableInput.Password, DisableInput.Code.Trim(), HttpContext.RequestAborted);
        DisableInput.Password = DisableInput.Code = "";
        if (result.Status != TwoFactorStatus.Success) { Fail(); return; }
        await RenewCookieAsync(persistent);
        enabled = false;
        message = L["雙重驗證已停用。"].Value;
    }
    private async Task RenewCookieAsync(bool persistent)
    {
        await Management.RenewCookieAsync(HttpContext, persistent);
    }
    private void Fail() { isError = true; message = L["無法完成操作，請確認密碼或驗證碼。"].Value; }
    private sealed class PasswordModel { [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredPassword)), StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))] public string Password { get; set; } = ""; }
    private sealed class CodeModel { [Required(ErrorMessageResourceType = typeof(TwoFactorText), ErrorMessageResourceName = nameof(TwoFactorText.RequiredCode)), StringLength(64, ErrorMessageResourceType = typeof(TwoFactorText), ErrorMessageResourceName = nameof(TwoFactorText.CodeLength))] public string Code { get; set; } = ""; }
    private sealed class DisableModel
    {
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredPassword)), StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))] public string Password { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(TwoFactorText), ErrorMessageResourceName = nameof(TwoFactorText.RequiredCode)), StringLength(64, ErrorMessageResourceType = typeof(TwoFactorText), ErrorMessageResourceName = nameof(TwoFactorText.CodeLength))] public string Code { get; set; } = "";
    }
}
