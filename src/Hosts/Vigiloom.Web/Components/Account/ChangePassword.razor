@page "/account/change-password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Vigiloom.Modules.IdentityAccess.Domain
@using Vigiloom.Web.Authentication
@inject SelfPasswordChange PasswordChange
@inject SignInManager<Account> SignInManager
@inject NavigationManager Navigation

<PageTitle>修改密碼 - Vigiloom</PageTitle>
<section class="account-card" aria-labelledby="change-title">
    <h1 id="change-title">修改密碼</h1>
    <p class="account-description">修改後請使用新密碼重新登入。</p>
    @if (error is not null) { <p class="account-error" role="alert">@error</p> }
    <EditForm Model="Input" FormName="change-password" method="post" OnValidSubmit="ChangeAsync">
        <DataAnnotationsValidator />
        <div class="account-field"><label for="current-password">目前密碼</label><input id="current-password" name="Input.CurrentPassword" type="password" autocomplete="current-password" maxlength="1024" required /><ValidationMessage For="() => Input.CurrentPassword" /></div>
        <div class="account-field"><label for="new-password">新密碼</label><input id="new-password" name="Input.NewPassword" type="password" autocomplete="new-password" maxlength="1024" required /><ValidationMessage For="() => Input.NewPassword" /><span class="account-hint">至少 12 個字元，包含大小寫英文字母、數字及符號。</span></div>
        <div class="account-field"><label for="confirm-password">確認新密碼</label><input id="confirm-password" name="Input.ConfirmPassword" type="password" autocomplete="new-password" maxlength="1024" required /><ValidationMessage For="() => Input.ConfirmPassword" /></div>
        <button class="account-primary" type="submit">修改密碼</button>
    </EditForm>
    <p class="account-footer"><a href="/">返回總覽</a></p>
</section>

@code {
    private string? error;
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private ChangeInput Input { get; set; } = default!;
    protected override void OnInitialized() => Input ??= new();
    private async Task ChangeAsync()
    {
        var result = await PasswordChange.ChangeAsync(HttpContext.User, Input.CurrentPassword, Input.NewPassword);
        Input.CurrentPassword = Input.NewPassword = Input.ConfirmPassword = "";
        if (result.Status == AccountOperationStatus.Success)
        {
            await SignInManager.SignOutAsync();
            Navigation.NavigateTo("/account/login?password=changed", forceLoad: true);
            return;
        }
        error = "無法修改密碼，請確認目前密碼與新密碼規則。";
    }
    private sealed class ChangeInput
    {
        [Required, StringLength(1024)] public string CurrentPassword { get; set; } = "";
        [Required, StringLength(1024)] public string NewPassword { get; set; } = "";
        [Required, StringLength(1024), Compare(nameof(NewPassword), ErrorMessage = "兩次密碼不一致。")] public string ConfirmPassword { get; set; } = "";
    }
}
