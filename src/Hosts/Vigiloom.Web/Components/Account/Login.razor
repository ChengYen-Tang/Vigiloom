@page "/account/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-login")]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Http.HttpResults
@using Microsoft.AspNetCore.Identity
@using Vigiloom.Modules.IdentityAccess.Domain
@inject Vigiloom.Web.Authentication.AccountLogin AccountLogin
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<LoginText> L

<PageTitle>@L["PageTitle"] - Vigiloom</PageTitle>
<section class="account-card" aria-labelledby="login-title">
    <h1 id="login-title">@L["Heading"]</h1>
    <p class="account-description">@L["Description"]</p>
    @if ((Setup == "complete" || Password == "changed") && error is null)
    {
        <p class="account-success" role="status">@L["SetupComplete"]</p>
    }
    @if (error is not null)
    {
        <p class="account-error" role="alert">@error</p>
    }
    <EditForm Model="Input" FormName="login" method="post" OnValidSubmit="LoginAsync">
        <DataAnnotationsValidator />
        <div class="account-field">
            <label for="login-name">@L["UserName"]</label>
            <InputText id="login-name" @bind-Value="Input.UserName" autocomplete="username" maxlength="256" required />
            <ValidationMessage For="() => Input.UserName" />
        </div>
        <div class="account-field">
            <label for="login-password">@L["Password"]</label>
            <input id="login-password" name="Input.Password" type="password" autocomplete="current-password" maxlength="1024" required />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <label class="account-checkbox"><InputCheckbox @bind-Value="Input.RememberMe" /> @L["RememberMe"]</label>
        <button class="account-primary" type="submit">@L["SignIn"]</button>
    </EditForm>
    <p class="account-footer"><a href="/account/reset-password">@L["ResetPassword"]</a> · <a href="/account/setup">@L["FirstSetup"]</a></p>
</section>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private string? error;
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Setup { get; set; }
    [SupplyParameterFromQuery] private string? Password { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        var result = await AccountLogin.PasswordAsync(HttpContext, Input.UserName, Input.Password, Input.RememberMe, HttpContext.RequestAborted);
        Input.Password = string.Empty;
        if (result.RequiresTwoFactor)
        {
            var destination = RedirectHttpResult.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";
            Navigation.NavigateTo($"/account/two-factor?returnUrl={Uri.EscapeDataString(destination)}&remember={Input.RememberMe}", forceLoad: true);
            return;
        }
        if (result.Succeeded)
        {
            var destination = RedirectHttpResult.IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";
            Navigation.NavigateTo(destination, forceLoad: true);
            return;
        }
        error = L["LoginFailed"];
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredUserName))]
        [StringLength(256, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.UserNameLength))]
        public string UserName { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredPassword))]
        [StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))]
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }
}
