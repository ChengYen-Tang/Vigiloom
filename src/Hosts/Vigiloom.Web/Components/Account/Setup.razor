@page "/account/setup"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("identity-setup")]
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout
@using System.ComponentModel.DataAnnotations
@using Vigiloom.Web.Authentication
@inject Vigiloom.Web.Authentication.AccountPasswordOperations SetupAdministrator
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<SetupText> L

<PageTitle>@L["Title"] - Vigiloom</PageTitle>
<section class="account-card" aria-labelledby="setup-title">
    <h1 id="setup-title">@L["Title"]</h1>
    <p class="account-description">@L["Description"]</p>
    @if (error is not null)
    {
        <p class="account-error" role="alert">@error</p>
    }
    <EditForm Model="Input" FormName="setup" method="post" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator />
        <div class="account-field">
            <label for="setup-token">@L["SetupToken"]</label>
            <input id="setup-token" name="Input.SetupToken" type="password" autocomplete="off" maxlength="256" required />
            <ValidationMessage For="() => Input.SetupToken" />
            <span class="account-hint">@L["TokenHint"]</span>
        </div>
        <div class="account-field">
            <label for="setup-name">@L["Administrator"]</label>
            <InputText id="setup-name" @bind-Value="Input.UserName" autocomplete="username" maxlength="256" required />
            <ValidationMessage For="() => Input.UserName" />
        </div>
        <div class="account-field">
            <label for="setup-password">@L["Password"]</label>
            <input id="setup-password" name="Input.Password" type="password" autocomplete="new-password" maxlength="1024" required />
            <ValidationMessage For="() => Input.Password" />
            <span class="account-hint">@L["PasswordHint"]</span>
        </div>
        <div class="account-field">
            <label for="setup-confirm">@L["ConfirmPassword"]</label>
            <input id="setup-confirm" name="Input.ConfirmPassword" type="password" autocomplete="new-password" maxlength="1024" required />
            <ValidationMessage For="() => Input.ConfirmPassword" />
        </div>
        <button class="account-primary" type="submit">@L["Title"]</button>
        <p class="account-footer"><a href="/account/login">@L["AlreadyHaveAccount"]</a></p>
    </EditForm>
</section>

@code {
    private string? error;
    [SupplyParameterFromForm] private SetupInput Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task CreateAsync()
    {
        var result = await SetupAdministrator.CreateAsync(Input.SetupToken, Input.UserName, Input.Password);
        Input.SetupToken = Input.Password = Input.ConfirmPassword = string.Empty;
        if (result.Status == InitialAdministratorStatus.Created)
        {
            Navigation.NavigateTo("/account/login?setup=complete", forceLoad: true);
            return;
        }
        error = result.Status switch
        {
            InitialAdministratorStatus.ValidationFailed => string.Join(" ", result.Errors),
            _ => L["SetupFailed"]
        };
    }

    private sealed class SetupInput
    {
        [Required(ErrorMessageResourceType = typeof(SetupText), ErrorMessageResourceName = nameof(SetupText.RequiredToken))]
        [StringLength(256, ErrorMessageResourceType = typeof(SetupText), ErrorMessageResourceName = nameof(SetupText.TokenLength))] public string SetupToken { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredUserName))]
        [StringLength(256, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.UserNameLength))] public string UserName { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.RequiredPassword))]
        [StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))] public string Password { get; set; } = "";
        [Required(ErrorMessageResourceType = typeof(SetupText), ErrorMessageResourceName = nameof(SetupText.RequiredConfirmation))]
        [StringLength(1024, ErrorMessageResourceType = typeof(LoginText), ErrorMessageResourceName = nameof(LoginText.PasswordLength))]
        [Compare(nameof(Password), ErrorMessageResourceType = typeof(SetupText), ErrorMessageResourceName = nameof(SetupText.PasswordMismatch))] public string ConfirmPassword { get; set; } = "";
    }
}
