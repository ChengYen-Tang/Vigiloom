@page "/settings/agent-packages"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Contracts.Agent
@using Vigiloom.Modules.AgentManagement.Application
@using Vigiloom.UpdateSecurity.AgentPackages
@inject IAgentPackageQuery Packages
@inject GitHubAgentReleases Releases
@inject ILogger<AgentPackages> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<ServiceAdminText> L

<PageTitle>@L["Agent 套件管理"] - Vigiloom</PageTitle>
<main class="device-page package-page">
    <header class="device-heading"><div><h1>@L["Agent 套件管理"]</h1><p>@L["從 GitHub 下載需要的版本，供設備更新或回滾。"]</p></div></header>
    <section class="device-panel" aria-labelledby="release-title">
        <h2 id="release-title">@L["GitHub 發布版本"]</h2>
        <a href="?releases=1">@L["同步 GitHub 發布版本"]</a>
        @if (downloadMessage is not null) { <p class="package-status" role="status">@downloadMessage</p> }
        @if (releaseError) { <p role="alert">@L["無法取得 GitHub 發布版本，請稍後重試；已下載的套件仍可使用。"]</p> }
        else if (releases is not null)
        {
            @if (releases.Items.Count == 0) { <p>@L["此頁沒有 Agent 發布版本。"]</p> }
            else
            {
                <div class="device-table-wrap" role="region" aria-label="@L["GitHub Agent 發布版本"]" tabindex="0"><table>
                    <thead><tr><th>@L["版本"]</th><th>@L["類型"]</th><th>@L["平台與下載"]</th></tr></thead>
                    <tbody>@foreach (var release in releases.Items)
                    {
                        <tr @key="release.Version"><td>@release.Version</td><td>@(release.Preview ? "Preview" : L["正式版"].Value)</td><td>
                            @if (release.Assets.Count == 0) { <span>@L["此版本沒有可下載的更新套件。"]</span> }
                            else
                            {
                                @foreach (var asset in release.Assets)
                                {
                                    var cached = releasePackages.Any(item => item.Version == release.Version && item.RuntimeIdentifier == asset.RuntimeIdentifier && item.Cached);
                                    <div>@asset.RuntimeIdentifier · @(cached ? L["已下載"].Value : L["未下載"].Value)
                                        @if (!cached)
                                        {
                                            <form method="post" action="/settings/agent-packages/download" data-pending="@L["下載中…"]" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent=this.dataset.pending">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="version" value="@release.Version" />
                                                <input type="hidden" name="runtimeIdentifier" value="@asset.RuntimeIdentifier" />
                                                <button type="submit" aria-label="@L["下載 {0} {1}", release.Version, asset.RuntimeIdentifier]">@L["下載"]</button>
                                            </form>
                                        }
                                    </div>
                                }
                            }
                        </td></tr>
                    }</tbody>
                </table></div>
            }
            @if (releases.Page > 1) { <a href="@($"?releases={releases.Page - 1}")">@L["上一頁"]</a> }
            @if (releases.HasMore) { <a href="@($"?releases={releases.Page + 1}")">@L["下一頁"]</a> }
        }
    </section>
    <section class="device-panel" aria-labelledby="cached-title">
        <h2 id="cached-title">@L["已下載版本"]</h2>
        @if (removeMessage is not null) { <p class="package-status" role="status">@removeMessage</p> }
        @if (packageError) { <p role="alert">@L["無法讀取套件清單，請稍後重試。"]</p> }
        else if (page?.Items.Count > 0)
        {
            <div class="device-table-wrap" role="region" aria-label="@L["已下載的 Agent 套件"]" tabindex="0"><table>
                <thead><tr><th>@L["版本"]</th><th>@L["平台"]</th><th>@L["大小"]</th><th>@L["狀態"]</th><th>@L["操作"]</th></tr></thead>
                <tbody>@foreach (var item in page.Items)
                {
                    <tr @key="item.Id"><td>@item.Version</td><td>@item.RuntimeIdentifier</td><td>@((item.Size / 1048576d).ToString("N1")) MiB</td><td>@(item.Cached ? L["已下載"].Value : L["未下載"].Value)</td><td>
                        @if (item.Cached) { <form method="post" action="@($"/settings/agent-packages/{item.Id:D}/remove")"><AntiforgeryToken /><button type="submit" aria-label="@L["刪除 {0} {1}", item.Version, item.RuntimeIdentifier]">@L["刪除"]</button></form> }
                    </td></tr>
                }</tbody>
            </table></div>
            <nav class="device-pagination" aria-label="@L["套件清單分頁"]">@if (page.Page > 1) { <a href="@($"?page={page.Page - 1}")">@L["上一頁"]</a> }<span>@L["第 {0} 頁", page.Page]</span>@if (page.HasMore) { <a href="@($"?page={page.Page + 1}")">@L["下一頁"]</a> }</nav>
        }
        else { <p>@L["目前沒有已下載的版本。"]</p> }
    </section>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "page")] private int? PageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "releases")] private int? ReleasePageNumber { get; set; }
    [SupplyParameterFromQuery(Name = "download")] private string? DownloadResult { get; set; }
    [SupplyParameterFromQuery(Name = "remove")] private string? RemoveResult { get; set; }
    private AgentPackagePage? page;
    private AgentReleasePage? releases;
    private IReadOnlyList<AgentPackageView> releasePackages = [];
    private bool releaseError;
    private bool packageError;
    private string? downloadMessage => DownloadResult switch { "saved" => L["套件已下載。"].Value, "unavailable" => L["找不到指定的套件。"].Value, "conflict" => L["版本內容已變更，或舊套件資訊遺失但仍被指派。請確認版本，必要時先清除指派。"].Value, "error" => L["下載或驗證失敗，請稍後重試。"].Value, _ => null };
    private string? removeMessage => RemoveResult switch { "removed" => L["已刪除套件。"].Value, "in-use" => L["此版本仍在使用或已被指派，無法刪除。"].Value, "error" => L["無法刪除套件，請稍後重試。"].Value, _ => null };

    protected override async Task OnInitializedAsync()
    {
        try { page = await Packages.GetAsync(PageNumber.GetValueOrDefault(1), HttpContext.RequestAborted); }
        catch (Exception error) when (error is not OperationCanceledException) { Logger.LogWarning(error, "Could not read Agent packages."); packageError = true; }
        if (ReleasePageNumber is null) return;
        try
        {
            releases = await Releases.GetAsync(ReleasePageNumber.GetValueOrDefault(1), HttpContext.RequestAborted);
            releasePackages = await Packages.GetVersionsAsync(releases.Items.Select(item => item.Version).ToArray(), HttpContext.RequestAborted);
        }
        catch (Exception error) when (error is not OperationCanceledException) { Logger.LogWarning(error, "Could not read Agent releases."); releaseError = true; }
    }
}
