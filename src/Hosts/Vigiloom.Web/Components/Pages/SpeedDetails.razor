@using Microsoft.AspNetCore.Components.Authorization
@page "/speed-tests/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.MonitoringRead)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Contracts.SpeedTests
@using Vigiloom.Modules.NetworkMonitoring.Application.SpeedTests
@using Vigiloom.Web.Client.Components.SpeedTests
@inject SpeedHistory History
@inject SpeedQueue Queue
@inject NavigationManager Navigation
@inject ILogger<SpeedDetails> Logger
<PageTitle>測速結果 - Vigiloom</PageTitle>
<main class="device-page">
    <a href="@BackUrl">← 返回測速紀錄</a>
    @if (error) { <p class="device-alert" role="alert">無法載入測速結果，請稍後重新整理。</p> }
    else if (result is null) { <section class="device-panel"><h1>找不到測速結果</h1><p>此筆紀錄不存在。</p></section> }
    else
    {
        <header class="device-heading"><div><h1>測速結果</h1><p>@result.Summary.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC · @(result.Summary.Automatic ? "自動" : "手動") · @result.Summary.Location</p></div><SpeedStateBadge State="result.Summary.State" /></header>
        @if (result.Summary.State != SpeedTestState.Success) { <p class="device-alert">@(result.Summary.State is SpeedTestState.Queued or SpeedTestState.Running ? "測試尚未完成，請重新整理查看最新狀態。" : "此測試未完整完成；已觀測數值僅代表部分結果，缺資料不代表 0。")</p> }
        @if (result.Summary.CancellationRequested && result.Summary.State == SpeedTestState.Running) { <p role="status">已要求取消，Worker 正在停止測試。</p> }
        <section class="device-panel"><h2>量測數據</h2><dl class="device-details">
            <div><dt>下載</dt><dd>@SpeedPresentation.Value(result.Summary.DownloadMbps, "Mbps")</dd></div><div><dt>上傳</dt><dd>@SpeedPresentation.Value(result.Summary.UploadMbps, "Mbps")</dd></div><div><dt>服務端 HTTP 延遲</dt><dd>@SpeedPresentation.Value(result.Summary.LatencyMilliseconds, "ms")</dd></div>
            <div><dt>已觀測流量</dt><dd>@(result.Summary.Bytes is { } bytes ? $"{bytes / 1048576d:0.###} MiB" : "未知")</dd></div>
            <div><dt>測試開始（UTC）</dt><dd>@(result.Summary.StartedAt?.ToString("u") ?? "尚未開始")</dd></div><div><dt>完成／中止（UTC）</dt><dd>@(result.Summary.CompletedAt?.ToString("u") ?? "尚未完成")</dd></div>
        </dl><p>十進位 Mbps；預算 @result.MaxMiB MiB，最長 @result.TimeoutSeconds 秒。數值代表中央到選定服務端的單一路徑。</p></section>
        <section class="device-panel"><h2>服務端與來源</h2><dl class="device-details">
            <div><dt>Provider</dt><dd>@result.Provider</dd></div><div><dt>服務端</dt><dd>@(result.Summary.Server ?? "未選定")</dd></div><div><dt>ISP</dt><dd>@(result.Isp ?? "供應商未提供")</dd></div><div><dt>位置</dt><dd>@(string.Join(" · ", new[] { result.City, result.Country }.Where(x => !string.IsNullOrWhiteSpace(x))) is { Length: > 0 } location ? location : "供應商未提供")</dd></div>
            <div><dt>座標</dt><dd>@(result.Latitude is { } lat && result.Longitude is { } lon ? $"{lat:0.####}, {lon:0.####}" : "供應商未提供")</dd></div><div><dt>診斷代碼</dt><dd>@(result.DiagnosticCode ?? "無")</dd></div>
        </dl><p>沒有座標或 ISP 時不推測補值。</p></section>
        <AuthorizeView Policy="Administrator"><Authorized Context="administrator">
        @if (result.Summary.State is SpeedTestState.Queued or SpeedTestState.Running)
        {
            <section class="device-panel"><h2>取消測試</h2><p>已使用的流量無法退回。</p>
            @if (message is not null) { <p role="status">@message</p> }
            <EditForm Model="Input" FormName="speed-cancel" method="post" OnValidSubmit="CancelAsync"><label><InputCheckbox @bind-Value="Input.Confirm" /> 我了解取消的影響</label><button type="submit" disabled="@result.Summary.CancellationRequested">取消這筆測試</button></EditForm>
            </section>
        }
        </Authorized></AuthorizeView>
    }
</main>
@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    private string BackUrl => ReturnUrl is { Length: <= 2048 } && ReturnUrl.StartsWith("/speed-tests?", StringComparison.Ordinal) ? ReturnUrl : "/speed-tests";
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "speed-cancel")] private CancelForm Input { get; set; } = default!;
    private SpeedRunDetails? result;
    private bool error;
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        try { result = await History.GetAsync(Id, HttpContext.RequestAborted); }
        catch (Exception ex) { Logger.LogWarning("Could not read speed result: {ExceptionType}", ex.GetType().Name); error = true; }
    }
    private async Task CancelAsync()
    {
        if (!HttpContext.User.IsInRole("Administrator")) return;
        if (!Input.Confirm) { message = "請先確認取消影響。"; return; }
        var success = false;
        try { success = await Queue.CancelAsync(Id, HttpContext.RequestAborted); }
        catch (Exception ex) { Logger.LogWarning("Could not cancel speed result: {ExceptionType}", ex.GetType().Name); message = "無法確認取消結果，請重新整理檢查。"; }
        if (success) Navigation.NavigateTo($"/speed-tests/{Id:D}", forceLoad: true);
    }
    private sealed class CancelForm { public bool Confirm { get; set; } }
}
