@page "/settings/jobs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Infrastructure.Scheduling
@using Vigiloom.Web.Authentication
@inject SchedulingOverview Overview
@inject OutboxScheduleManager Schedule
@inject DashboardAuditStore Audit
@inject ILogger<Jobs> Logger

<PageTitle>背景工作 - Vigiloom</PageTitle>
<main class="jobs-page">
    <header class="jobs-heading">
        <div><h1>背景工作</h1><p>查看排程執行狀態與最近結果。</p></div>
        <nav aria-label="背景工作操作"><a href="/settings/jobs">重新整理</a><a class="jobs-primary" href="/admin/jobs/">進階管理</a></nav>
    </header>
    @if (unavailable)
    {
        <section class="jobs-notice" role="alert"><h2>暫時無法取得背景工作狀態</h2><p>請確認資料庫與 Worker 連線後重新整理。</p></section>
    }
    else if (overview is not null)
    {
        @if (saved) { <p class="jobs-success" role="status">背景工作檢查頻率已儲存。</p> }
        @if (conflict) { <p class="jobs-notice" role="alert">設定已被其他管理員修改，請重新整理後再試。</p> }
        @if (pending) { <p class="jobs-notice" role="status">設定已儲存，正在等待背景服務套用。</p> }
        @if (refreshRequired) { <p class="jobs-notice" role="alert">無法取得最新設定，請重新整理後再操作。</p> }
        @if (saveError) { <p class="jobs-notice" role="alert">無法確認儲存結果，請重新整理並檢查設定。</p> }
        @if (overview.Workers == 0)
        {
            <section class="jobs-notice" role="status"><strong>目前沒有已連線的背景服務。</strong> 工作可能無法執行，請確認 Vigiloom 背景服務狀態。</section>
        }
        <section aria-label="工作狀態" class="jobs-stats">
            <div><span>已連線背景服務</span><strong>@overview.Workers</strong></div>
            <div><span>排程工作等待中</span><strong>@overview.Queued</strong></div>
            <div><span>執行中</span><strong>@overview.Processing</strong></div>
            <div><span>排程工作失敗</span><strong>@overview.Failed</strong></div>
            <div><span>待處理內部工作</span><strong>@overview.PendingMessages</strong></div>
            <div><span>內部工作失敗</span><strong>@overview.FailedMessages</strong></div>
        </section>
        <section class="jobs-panel" aria-labelledby="recent-jobs-title">
            <h2 id="recent-jobs-title">最近執行結果</h2>
            <p>時間以 UTC 顯示；進階管理可查看工作詳細資料。</p>
            @if (overview.Recent.Count == 0) { <p>目前沒有執行結果。</p> }
            else
            {
                <div class="jobs-table-wrap"><table><thead><tr><th scope="col">工作</th><th scope="col">結果</th><th scope="col">時間（UTC）</th><th scope="col">說明</th></tr></thead><tbody>
                    @foreach (var entry in overview.Recent)
                    {
                        <tr><td>@entry.Name</td><td>@entry.Result</td><td>@(entry.OccurredAt?.ToUniversalTime().ToString("u") ?? "未知")</td><td>@(entry.Detail ?? "—")</td></tr>
                    }
                </tbody></table></div>
            }
        </section>
        <section class="jobs-panel jobs-settings" aria-labelledby="schedule-title">
            <h2 id="schedule-title">背景工作檢查頻率</h2>
            <p>設定平台檢查待處理內部工作的頻率；此設定不影響設備 Ping 頻率。</p>
            @if (!scheduleApplied && !refreshRequired) { <p role="status">目前排程尚未套用；背景服務啟動後會自動同步。</p> }
            <EditForm Model="Input" FormName="job-schedule" method="post" OnValidSubmit="SaveAsync">
                <InputHidden @bind-Value="Input.Version" />
                <label for="schedule-interval">檢查間隔</label>
                <InputSelect id="schedule-interval" @bind-Value="Input.Minutes">
                    @foreach (var minutes in new[] { 1, 2, 5, 10, 15, 30, 60 }) { <option value="@minutes">@minutes 分鐘</option> }
                </InputSelect>
                <button type="submit" disabled="@(refreshRequired || conflict || saveError)">儲存設定</button>
            </EditForm>
        </section>
    }
</main>

@code {
    private WorkOverview? overview;
    private bool unavailable;
    private bool saved;
    private bool saveError;
    private bool conflict;
    private bool pending;
    private bool refreshRequired;
    private bool scheduleApplied;
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "job-schedule")] private ScheduleInput Input { get; set; } = default!;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        try
        {
            overview = await Overview.GetAsync();
            var snapshot = Schedule.GetSnapshot();
            scheduleApplied = snapshot.Applied;
            if (HttpMethods.IsGet(HttpContext.Request.Method)) { Input.Minutes = snapshot.Minutes; Input.Version = snapshot.Version; }
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Could not load background work overview: {ExceptionType}", exception.GetType().Name);
            unavailable = true;
        }
    }
    private async Task SaveAsync()
    {
        if (!Guid.TryParse(HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var actor) || actor == Guid.Empty || !OutboxScheduleManager.IsValidInterval(Input.Minutes)) { saveError = true; return; }
        long[]? auditIds = null;
        try
        {
            auditIds = await Audit.BeginAsync(actor, "/settings/jobs/schedule", [OutboxScheduleManager.ScheduleId], HttpContext.RequestAborted);
            Schedule.SetIntervalMinutes(Input.Minutes, Input.Version ?? "", actor);
            saved = true;
            await RecordOutcomeAsync(auditIds, "accepted");
        }
        catch (ScheduleConflictException)
        {
            conflict = true;
            if (auditIds is not null) await RecordOutcomeAsync(auditIds, "rejected");
        }
        catch (ScheduleApplyPendingException)
        {
            pending = true;
            scheduleApplied = false;
            if (auditIds is not null) await RecordOutcomeAsync(auditIds, "pending");
        }
        catch (Exception exception)
        {
            Logger.LogWarning("Could not save background schedule: {ExceptionType}", exception.GetType().Name);
            if (auditIds is not null) await RecordOutcomeAsync(auditIds, "unknown");
            saveError = true;
        }
        if (saved || pending)
        {
            try
            {
                var snapshot = Schedule.GetSnapshot();
                scheduleApplied = snapshot.Applied;
                Input.Version = snapshot.Version;
            }
            catch (Exception exception)
            {
                Logger.LogWarning("Could not refresh background schedule: {ExceptionType}", exception.GetType().Name);
                refreshRequired = true;
            }
        }
    }

    private async Task RecordOutcomeAsync(long[] auditIds, string result)
    {
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
        try { await Audit.CompleteAsync(auditIds, result, timeout.Token); }
        catch (Exception exception) { Logger.LogError("Could not record schedule outcome: {ExceptionType}", exception.GetType().Name); }
    }

    private sealed class ScheduleInput { public int Minutes { get; set; } = 1; public string? Version { get; set; } = ""; }
}
