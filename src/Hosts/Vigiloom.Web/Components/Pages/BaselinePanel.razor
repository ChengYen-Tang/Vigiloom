@using Vigiloom.Contracts.Agent.Baseline
@using Microsoft.AspNetCore.Components.Authorization
@using Vigiloom.Contracts.Intelligence
@using Vigiloom.Modules.SecurityAnalysis.Application.Baseline
@inject Vigiloom.Web.HostMonitoring.BaselineAccess Query
@inject ILogger<BaselinePanel> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<ServiceAdminText> L

<section class="baseline-panel" aria-labelledby="baseline-title">
    <h2 id="baseline-title">@L["安全設定基準"]</h2>
    <p class="baseline-intro">@L["唯讀檢查已選用的安全設定，不會自動修改設備；檢查結果不代表設備沒有其他風險。"]</p>
    @if (error)
    {
        <p class="baseline-error" role="alert">@L["無法載入基準檢查結果，請稍後重新整理。"]</p>
    }
    else if (view is null)
    {
        <p>@L["目前沒有基準檢查資料。"]</p>
    }
    else
    {
        <p class="baseline-meta">@L["檢查間隔與盤點設定相同：{0} 秒。", view.ScanIntervalSeconds] @if (view.AgentId is null) { <span>@L["此設備尚無可用 Agent。"]</span> }</p>
        @if (view.Sync is { } sync && view.AgentId is not null)
        {
            <details class="baseline-meta">
                <summary>@L["Agent 設定：{0}", SyncStatus(sync.State)]</summary>
                <p>@L["期望版本：{0}", ShortVersion(sync.DesiredRevision)]</p>
                <p>@L["已套用版本：{0}", sync.AppliedRevision is { } applied ? ShortVersion(applied) : L["尚未回報"].Value]</p>
                <p>@L["最後成功同步（UTC）：{0}", sync.LastSyncedAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? L["尚未回報"].Value]</p>
                @if (sync.Failure is { } failure) { <p>@L["同步問題：{0}", SyncFailure(failure)]</p> }
            </details>
        }
        <p class="baseline-scroll-hint">@L["左右滑動查看完整檢查資訊。"]</p>
        <div class="baseline-table" tabindex="0" role="region" aria-label="@L["基準檢查，可左右捲動"]">
            <table>
                <thead><tr><th scope="col">@L["檢查項目"]</th><th scope="col">@L["狀態"]</th><th scope="col">@L["上次檢查（UTC）"]</th><th scope="col">@L["目前選用版本"]</th></tr></thead>
                <tbody>
                @foreach (var check in view.Checks)
                {
                    <tr>
                        <td>
                            <strong>@Title(check)</strong><div class="baseline-detail">@Source(check) · @check.CheckId</div>
                            @if (check.Latest is { } latest)
                            {
                                <details><summary>@L["查看最近紀錄"]</summary>
                                    <p>@L["結果：{0}", Outcome(latest.Outcome)]@if (!latest.Current) { <span>@L["（非目前有效結果）"]</span> }</p>
                                    <p>@L["作業系統：{0}", latest.OperatingSystem]</p>
                                    @if (!string.IsNullOrWhiteSpace(latest.Evidence)) { <p>@latest.Evidence</p> }
                                    <p>@L["當時預期：{0}", Expected(check, latest.Definition)]</p>
                                    @if (latest.Outcome == BaselineOutcome.Fail) { <p class="baseline-guidance">@L["建議：{0}", Guidance(check, latest.Definition)]</p> }
                                    <p>@L["來源版本 ID：{0}", latest.RevisionId]</p>
                                </details>
                            }
                            @if (check.Notes is { Count: > 0 } notes)
                            {
                                <details><summary>@L["最近的例外說明（{0}）", notes.Count]</summary>
                                    @foreach (var note in notes)
                                    {
                                        <p class="baseline-guidance">@(note.RevisionId == check.ActiveRevisionId ? L["目前版本"].Value : L["其他版本"].Value) · @note.RecordedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC · @note.ActorId<br />@L["版本：{0}", note.RevisionId]<br />@note.Reason</p>
                                    }
                                </details>
                            }
                            @if (check.ActiveRevisionId is { } revision && check.SourceAvailability == BaselineSourceAvailability.Ready)
                            {
                                <AuthorizeView Policy="Administrator"><Authorized><a href="@($"/devices/{DeviceId:D}/baseline-exception?source={Uri.EscapeDataString(check.SourceKey)}&revision={revision:D}")">@L["新增例外說明"]</a></Authorized></AuthorizeView>
                            }
                        </td>
                        <td><span class="baseline-status @StatusClass(check)">@Status(check, view.AgentId)</span></td>
                        <td>@(check.Latest?.ObservedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? L["尚無紀錄"].Value)</td>
                        <td>@if (check.UpstreamVersion is { } version) { <span title="@version">@ShortVersion(version)</span> } else { <span>—</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid DeviceId { get; set; }
    private DeviceBaselineView? view;
    private bool error;

    protected override async Task OnParametersSetAsync()
    {
        error = false;
        try { view = await Query.GetAsync(DeviceId, CancellationToken.None); }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            Logger.LogWarning("Unable to load baseline results: {ErrorType}.", ex.GetType().Name);
            error = true;
        }
    }

    private string Title(BaselineCheckView check) => check.SourceKey switch
    {
        BaselineSources.LinuxShadow => L["密碼檔案權限"].Value,
        BaselineSources.WindowsNetworkSelection => L["登入畫面網路選擇"].Value,
        _ => check.Title
    };

    private string Source(BaselineCheckView check) => check.SourceKey switch
    {
        BaselineSources.LinuxShadow => "ComplianceAsCode",
        BaselineSources.WindowsNetworkSelection => "PowerSTIG",
        _ when check.SourceKey.StartsWith(BaselineSources.LocalPrefix, StringComparison.Ordinal) => L["本機自訂"].Value,
        _ => check.SourceKey
    };

    private static string ShortVersion(string value) => value.Length > 12 ? value[..12] : value;

    private string SyncStatus(BaselineSyncState state) => state switch
    {
        BaselineSyncState.Applied => L["已套用"].Value, BaselineSyncState.Pending => L["等待套用"].Value, BaselineSyncState.Failed => L["同步失敗"].Value,
        BaselineSyncState.Offline => L["Agent 離線"].Value, _ => L["等待回報"].Value
    };

    private string SyncFailure(Vigiloom.Contracts.Agent.AgentConfigurationFailure failure) => failure switch
    {
        Vigiloom.Contracts.Agent.AgentConfigurationFailure.Unauthorized => L["Agent 身分驗證失敗"].Value,
        Vigiloom.Contracts.Agent.AgentConfigurationFailure.Invalid => L["設定資料無效"].Value,
        Vigiloom.Contracts.Agent.AgentConfigurationFailure.LocalStorage => L["無法讀寫 Agent 本機設定"].Value,
        Vigiloom.Contracts.Agent.AgentConfigurationFailure.Conflict => L["設定同步衝突，稍後會重試"].Value,
        _ => L["暫時無法取得設定，稍後會重試"].Value
    };

    private string Expected(BaselineCheckView check, BaselineCheck? definition) => check.SourceKey switch
    {
        BaselineSources.LinuxShadow => L["/etc/shadow 為一般檔案，權限不寬於 0640，且沒有額外 ACL。"].Value,
        BaselineSources.WindowsNetworkSelection => L["64 位元登錄檢視中的 DontDisplayNetworkSelectionUI 為 DWORD 1。"].Value,
        _ when definition is { Operation: BaselineSources.LinuxShadowOperation } => L["{0} 權限不寬於 {1}，且沒有額外 ACL。", definition.Target, definition.Expected].Value,
        _ when definition is { Operation: BaselineSources.WindowsRegistryOperation } => L["{0} 的 DWORD 值為 {1}。", definition.Target, definition.Expected].Value,
        _ => L["無法取得此紀錄當時的檢查定義。"].Value
    };

    private string Guidance(BaselineCheckView check, BaselineCheck? definition) => check.SourceKey switch
    {
        BaselineSources.LinuxShadow => L["請由主機管理員檢查檔案權限與 ACL，確認影響後依組織政策調整。"].Value,
        BaselineSources.WindowsNetworkSelection => L["請由主機管理員檢查登入畫面網路選擇的群組原則設定。"].Value,
        _ when !string.IsNullOrWhiteSpace(definition?.Guidance) => definition.Guidance!,
        _ => L["請由主機管理員參考此紀錄的來源版本。"].Value
    };

    private string Status(BaselineCheckView check, Guid? agentId)
    {
        if (agentId is null) return L["尚無 Agent"].Value;
        if (check.SourceAvailability != BaselineSourceAvailability.Ready) return check.SourceAvailability switch
        {
            BaselineSourceAvailability.Disabled => L["來源未啟用"].Value,
            BaselineSourceAvailability.NoActiveRevision => L["來源尚未發布"].Value,
            BaselineSourceAvailability.Stale => L["來源已過期"].Value,
            _ => L["來源無法使用"].Value
        };
        if (check.Latest is null) return L["尚未評估"].Value;
        return check.Latest.Current ? Outcome(check.Latest.Outcome) : L["結果過期或版本已變更"].Value;
    }

    private static string StatusClass(BaselineCheckView check) => check.Latest is { Current: true } latest && check.SourceAvailability == BaselineSourceAvailability.Ready
        ? latest.Outcome switch { BaselineOutcome.Pass => "pass", BaselineOutcome.Fail => "fail", _ => "neutral" } : "neutral";

    private string Outcome(BaselineOutcome outcome) => outcome switch
    {
        BaselineOutcome.Pass => L["通過"].Value, BaselineOutcome.Fail => L["未通過"].Value, BaselineOutcome.NotApplicable => L["不適用"].Value,
        BaselineOutcome.PermissionDenied => L["權限不足"].Value, BaselineOutcome.Error => L["檢查錯誤"].Value, _ => L["無法判斷"].Value
    };
}
