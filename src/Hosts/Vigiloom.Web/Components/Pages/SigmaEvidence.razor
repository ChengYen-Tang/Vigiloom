@page "/events/rules/{TestId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.MonitoringRead)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Vigiloom.Contracts.Intelligence
@using Vigiloom.Contracts.Operations
@using Vigiloom.Modules.SecurityAnalysis.Application.Detection
@using Vigiloom.Web.Events
@inject Vigiloom.Web.HostMonitoring.SigmaEvidenceAccess Security
@inject EventTimelineAudit Audit
@inject ILogger<SigmaEvidence> Logger

<PageTitle>行為規則證據 - Vigiloom</PageTitle>
<main class="evidence-page">
    <a href="/notifications">← 返回通知紀錄</a>
    <h1>行為規則證據</h1>
    @if (error is not null) { <p role="alert">@error</p> }
    else if (evidence is null) { <p>找不到此規則版本，相關資料可能已不再保留。</p> }
    else
    {
        <section class="evidence-panel">
            <p>規則：@evidence.Path · 情報版本：@evidence.RevisionId · 試跑：@TestId</p>
            <p>此處顯示告警使用的上游規則與本機排除條件，並非目前設定的即時狀態。</p>
            <h2>規則與匹配條件</h2>
            <pre>@evidence.Content</pre>
            @if (evidence.BaseSpecified)
            {
                <h2>關聯規則的基礎事件條件</h2>
                @if (evidence.BaseRule is null) { <p>無法取得符合版本的基礎規則。</p> }
                else { <pre>@evidence.BaseRule</pre> }
            }
            <h2>本機排除條件</h2>
            @if (evidence.Exceptions is null) { <p>無法讀取排除條件。</p> }
            else if (evidence.Exceptions.Count == 0) { <p>無。</p> }
            else { <ul>@foreach (var item in evidence.Exceptions) { <li>@item.Field = @item.Value</li> }</ul> }
        </section>
    }
</main>

@code {
    [Parameter] public Guid TestId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private Vigiloom.Modules.SecurityAnalysis.Application.Detection.SigmaEvidence? evidence;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        HttpContext.Response.Headers.CacheControl = "private, no-store";
        try
        {
            evidence = await Security.GetAsync(TestId, HttpContext.RequestAborted);
            if (evidence is not null)
            {
                if (!Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor) || actor == Guid.Empty) throw new InvalidOperationException("Missing actor.");
                await Audit.RecordEvidenceAsync(actor, new EventEvidenceAccessed("sigma-rule", TestId), HttpContext.RequestAborted);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning("Sigma evidence query failed: {ExceptionType}", ex.GetType().Name);
            error = "無法載入規則證據，請稍後再試。";
        }
    }

}
