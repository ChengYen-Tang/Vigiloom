@page "/events/rules/{TestId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.MonitoringRead)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Text
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Vigiloom.Contracts.Intelligence
@using Vigiloom.Modules.SecurityAnalysis.Application.Detection
@using Vigiloom.Modules.SecurityAnalysis.Persistence
@inject IDbContextFactory<SecurityAnalysisDbContext> Security
@inject ILogger<SigmaEvidence> Logger

<PageTitle>行為規則證據 - Vigiloom</PageTitle>
<main class="evidence-page">
    <a href="/notifications">← 返回通知紀錄</a>
    <h1>行為規則證據</h1>
    @if (error is not null) { <p role="alert">@error</p> }
    else if (evidence is null) { <p>找不到此規則版本，相關資料可能已不再保留。</p> }
    else
    {
        <section class="evidence-panel">
            <p>規則：@evidence.Path · 情報版本：@evidence.RevisionId · 試跑：@TestId</p>
            <p>此處顯示告警使用的上游規則與本機排除條件，並非目前設定的即時狀態。</p>
            <h2>規則與匹配條件</h2>
            <pre>@Encoding.UTF8.GetString(evidence.Content)</pre>
            @if (baseSpecified)
            {
                <h2>關聯規則的基礎事件條件</h2>
                @if (baseRule is null) { <p>無法取得符合版本的基礎規則。</p> }
                else { <pre>@baseRule</pre> }
            }
            <h2>本機排除條件</h2>
            @if (exceptions is null) { <p>無法讀取排除條件。</p> }
            else if (exceptions.Count == 0) { <p>無。</p> }
            else { <ul>@foreach (var item in exceptions) { <li>@item.Field = @item.Value</li> }</ul> }
        </section>
    }
</main>

@code {
    [Parameter] public Guid TestId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private Evidence? evidence;
    private IReadOnlyList<SigmaRuleException>? exceptions;
    private bool baseSpecified;
    private string? baseRule;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        HttpContext.Response.Headers.CacheControl = "private, no-store";
        try
        {
            await using var db = await Security.CreateDbContextAsync(HttpContext.RequestAborted);
            evidence = await (from test in db.SigmaRuleTests.AsNoTracking()
                join rule in db.SigmaRules.AsNoTracking() on new { test.RevisionId, test.Path } equals new { rule.RevisionId, rule.Path }
                where test.Id == TestId
                select new Evidence(test.RevisionId, test.Path, test.Digest, test.SamplesJson, rule.Content, rule.Digest)).SingleOrDefaultAsync(HttpContext.RequestAborted);
            if (evidence is not null && !string.Equals(evidence.Digest, Convert.ToHexStringLower(evidence.RuleDigest), StringComparison.OrdinalIgnoreCase)) evidence = null;
            if (evidence is not null)
            {
                if (SigmaExceptions.TryRead(evidence.SamplesJson, out var items)) exceptions = items;
                using var json = JsonDocument.Parse(evidence.SamplesJson);
                if (json.RootElement.ValueKind == JsonValueKind.Object && json.RootElement.TryGetProperty("BasePath", out var path))
                {
                    baseSpecified = true;
                    if (path.ValueKind == JsonValueKind.String && json.RootElement.TryGetProperty("BaseSha256", out var digest) && digest.ValueKind == JsonValueKind.String)
                    {
                        var basePath = path.GetString();
                        var source = await db.SigmaRules.AsNoTracking().Where(x => x.RevisionId == evidence.RevisionId && x.Path == basePath)
                            .Select(x => new { x.Content, x.Digest }).SingleOrDefaultAsync(HttpContext.RequestAborted);
                        if (source is not null && string.Equals(digest.GetString(), Convert.ToHexStringLower(source.Digest), StringComparison.OrdinalIgnoreCase))
                            baseRule = Encoding.UTF8.GetString(source.Content);
                    }
                }
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning("Sigma evidence query failed: {ExceptionType}", ex.GetType().Name);
            error = "無法載入規則證據，請稍後再試。";
        }
    }

    private sealed record Evidence(Guid RevisionId, string Path, string Digest, string SamplesJson, byte[] Content, byte[] RuleDigest);
}
