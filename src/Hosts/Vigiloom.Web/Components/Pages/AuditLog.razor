@page "/settings/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Vigiloom.Contracts.Operations
@using Vigiloom.Contracts.Agent
@using Vigiloom.Modules.AlertingOperations.Application
@using Vigiloom.Modules.IdentityAccess.Domain
@using Vigiloom.Web.Diagnostics
@inject OperationAuditQueryService Audit
@inject AuditFeedReader Feeds
@inject UserManager<Account> Users
@inject TimeProvider Clock
@inject ILogger<AuditLog> Logger

<PageTitle>操作稽核 - Vigiloom</PageTitle>
<main class="audit-page">
    <header class="audit-heading"><h1>操作稽核</h1><p>依來源查看操作紀錄。時間以 UTC 顯示。</p></header>
    <section class="audit-panel" aria-labelledby="audit-filter-title">
        <h2 id="audit-filter-title">查詢紀錄</h2>
        <form method="get" action="/settings/audit">
            <div class="audit-date-field"><label for="audit-source">紀錄來源</label><select id="audit-source" name="source">
                <option value="instance-policy" selected="@(sourceText == "instance-policy")">執行個體容量</option><option value="service-instances" selected="@(sourceText == "service-instances")">服務執行個體</option>
                <option value="log-quota" selected="@(sourceText == "log-quota")">Log 配額</option>
                <option value="trace-quota" selected="@(sourceText == "trace-quota")">Trace 配額</option>
                <option value="service-collections" selected="@(sourceText == "service-collections")">服務收集</option>
                <option value="health-targets" selected="@(sourceText == "health-targets")">服務健康檢查</option>
                <option value="health-networks" selected="@(sourceText == "health-networks")">健康檢查網段</option>
                <option value="publications" selected="@(sourceText == "publications")">公開設定</option>
                <option value="collectors" selected="@(sourceText == "collectors")">Collector 管理</option>
                <option value="agent-inbox" selected="@(sourceText == "agent-inbox")">Agent 收據保存</option>
                <option value="agent-packages" selected="@(sourceText == "agent-packages")">Agent 套件管理</option>
                <option value="speed" selected="@(sourceText == "speed")">網路測速設定</option><option value="ping" selected="@(sourceText == "ping")">Ping 設定</option><option value="accounts" selected="@(sourceText == "accounts")">帳號</option><option value="api-credentials" selected="@(sourceText == "api-credentials")">API 憑證</option>
                <option value="devices" selected="@(sourceText == "devices")">設備</option><option value="groups" selected="@(sourceText == "groups")">群組</option><option value="agent-identity" selected="@(sourceText == "agent-identity")">Agent 身分</option><option value="agent-settings" selected="@(sourceText == "agent-settings")">Agent 設定</option><option value="agent-queue-capacity" selected="@(sourceText == "agent-queue-capacity")">Agent 佇列容量</option><option value="agent-metric-settings" selected="@(sourceText == "agent-metric-settings")">Agent 指標設定</option><option value="host-metric-thresholds" selected="@(sourceText == "host-metric-thresholds")">主機效能閾值</option><option value="host-log-sources" selected="@(sourceText == "host-log-sources")">主機日誌來源</option><option value="agent-replay" selected="@(sourceText == "agent-replay")">Agent 補送政策</option><option value="service-approvals" selected="@(sourceText == "service-approvals")">服務核准</option><option value="service-sources" selected="@(sourceText == "service-sources")">服務來源憑證</option><option value="scheduling" selected="@(sourceText == "scheduling")">背景工作</option>
                <option value="inventory-settings" selected="@(sourceText == "inventory-settings")">主機盤點設定</option>
            </select></div>
            <div class="audit-date-field"><label for="audit-from">開始日期（UTC）</label><input id="audit-from" name="from" type="date" value="@fromText" aria-invalid="@(dateError is not null ? "true" : null)" aria-describedby="@(dateError is not null ? "audit-date-error" : null)" required /></div>
            <div class="audit-date-field"><label for="audit-to">結束日期（UTC）</label><input id="audit-to" name="to" type="date" value="@toText" aria-invalid="@(dateError is not null ? "true" : null)" aria-describedby="@(dateError is not null ? "audit-date-error" : null)" required /></div>
            <button type="submit">查詢</button>
        </form>
        @if (dateError is not null) { <p id="audit-date-error" class="audit-error" role="alert">@dateError</p> }
        @if (pageError is not null) { <p class="audit-error" role="alert">@pageError</p> }
        <p>一次最多查詢 31 天，包含所選結束日期。</p>
    </section>
    @if (unavailable) { <section class="audit-notice" role="alert">暫時無法讀取稽核紀錄，請稍後重新整理。</section> }
    else if (result is not null)
    {
        <section class="audit-panel" aria-labelledby="audit-results-title">
            <h2 id="audit-results-title">查詢結果</h2>
            <p>此來源收錄成功儲存的@(sourceText switch { "ping" => " Ping 設定", "agent-replay" => " Agent 補送政策", "agent-inbox" => " Agent 收據保存及清理啟用", "agent-packages" => " Agent 套件來源、信任初始化及清單刷新", "service-approvals" => "服務核准", "service-sources" => "服務來源憑證", "groups" => "群組操作", "publications" => "公開設定", "instance-policy" => "執行個體容量設定", "log-quota" => "Log 配額設定", "trace-quota" => "Trace 配額設定", "service-instances" => "執行個體操作", "service-collections" => "服務收集操作", "health-targets" => "健康檢查設定", "health-networks" => "健康檢查網段", "collectors" => "Collector 管理", _ => "網路測速設定" })紀錄。其他來源可由上方選擇。</p>
            @if (actorLookupFailed) { <p role="status">目前無法取得帳號名稱，改以帳號 ID 顯示。</p> }
            @if (result.Items.Count == 0) { <p>@(result.Page > 1 ? "此頁沒有紀錄，請返回上一頁。" : "此日期範圍沒有稽核紀錄。")</p> }
            else
            {
                <p class="audit-scroll-hint">← 左右滑動查看完整表格 →</p>
                <div class="audit-table-wrap" role="region" aria-label="稽核紀錄表，可左右捲動" tabindex="0"><table><thead><tr><th scope="col">時間（UTC）</th><th scope="col">操作者</th><th scope="col">操作</th><th scope="col">對象</th><th scope="col">變更內容</th><th scope="col">結果</th></tr></thead><tbody>
                    @foreach (var entry in result.Items)
                    {
                        <tr>
                            <td>@entry.OccurredAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@Actor(entry.ActorId)</td>
                            <td><span class="audit-badge audit-badge-action">@Operation(entry)</span></td>
                            <td>@(entry.PublicationTemplate is not null ? "公開範本" : entry.Publication is not null ? "公開設定" : entry.PingSettings is not null ? "Ping 設定" : entry.SpeedSettings is not null ? "網路測速設定" : entry.SpeedRetention is not null ? "測速保存期限" : entry.AgentReplayPolicy is not null ? "Agent 補送政策" : entry.AgentInboxSettings is not null || entry.AgentInboxActivation is not null ? "Agent 收據保存" : entry.AgentPackageSource is not null || entry.AgentPackageCatalogue is not null || entry.AgentPackageTrust is not null ? "Agent 套件管理" : entry.HealthNetworkPolicy is not null ? "健康檢查網段" : entry.HealthTarget is not null ? "健康檢查" : entry.ServiceApproval is not null || entry.ServiceCollection is not null ? "應用服務" : entry.ServiceSource is not null ? "服務來源" : entry.Group is not null ? "群組" : entry.InstancePolicy is not null ? "執行個體容量" : entry.LogQuota is not null ? "Log 配額" : entry.TraceQuota is not null ? "Trace 配額" : entry.ServiceInstance is not null ? "服務執行個體" : entry.Collector is not null ? "Collector" : "未知")</td>
                            <td>
                                @if (entry.SpeedSettings is { } change)
                                {
                                    <div>排程：@Enabled(change.Previous.Automatic) → @Enabled(change.Current.Automatic)</div>
                                    <div>間隔：@change.Previous.IntervalHours → @change.Current.IntervalHours 小時</div>
                                    <div>流量：@change.Previous.MaxMiB → @change.Current.MaxMiB MiB</div>
                                    <div>逾時：@change.Previous.TimeoutSeconds → @change.Current.TimeoutSeconds 秒</div>
                                    <details><summary>版本資訊</summary><span>@change.PreviousVersion → @change.CurrentVersion</span></details>
                                }
                                else if (entry.SpeedRetention is { } retention)
                                {
                                    <div>保存期限：@retention.PreviousDays → @retention.CurrentDays 天</div>
                                    <details><summary>版本資訊</summary><span>@retention.PreviousVersion → @retention.CurrentVersion</span></details>
                                }
                                else if (entry.PingSettings is { } ping)
                                {
                                    <div>間隔：@ping.Previous.IntervalSeconds → @ping.Current.IntervalSeconds 秒</div>
                                    <div>逾時：@ping.Previous.TimeoutSeconds → @ping.Current.TimeoutSeconds 秒</div>
                                    <div>失敗門檻：@ping.Previous.FailureThreshold → @ping.Current.FailureThreshold</div>
                                    <div>成功門檻：@ping.Previous.SuccessThreshold → @ping.Current.SuccessThreshold</div>
                                    <div>並行上限：@ping.Previous.MaxConcurrency → @ping.Current.MaxConcurrency</div>
                                    <details><summary>版本資訊</summary><span>@(string.IsNullOrEmpty(ping.PreviousVersion) ? "初始設定" : ping.PreviousVersion) → @ping.CurrentVersion</span></details>
                                }
                                else if (entry.AgentReplayPolicy is { } replay)
                                {
                                    <div>狀態：@ReplayPhase(replay.Previous) → @ReplayPhase(replay.Current)</div>
                                    <div>過渡期截止（UTC）：@replay.GraceUntil.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    <details><summary>版本資訊</summary><span>@replay.PreviousVersion → @replay.CurrentVersion</span></details>
                                }
                                else if (entry.AgentInboxSettings is { } inbox)
                                {
                                    <div>重送期限：@inbox.PreviousReplaySeconds → @inbox.CurrentReplaySeconds 秒</div>
                                    <div>收據保存：@inbox.PreviousRetentionDays → @inbox.CurrentRetentionDays 天</div>
                                    <details><summary>版本資訊</summary><span>@inbox.PreviousVersion → @inbox.CurrentVersion</span></details>
                                }
                                else if (entry.AgentInboxActivation is { } activation)
                                {
                                    <div>收據清理已啟用</div>
                                    <div>舊收據保護至（UTC）：@activation.LegacyRetainUntil.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    <details><summary>版本資訊</summary><span>@activation.PreviousVersion → @activation.CurrentVersion</span></details>
                                }
                                else if (entry.AgentPackageSource is { } source)
                                {
                                    <div>來源網址：@(source.AddressChanged ? "已變更" : "未變更")</div>
                                    <div>來源憑證：@(source.CredentialChanged ? "已變更" : "未變更")</div>
                                    <details><summary>版本資訊</summary><span>@source.PreviousVersion → @source.CurrentVersion</span></details>
                                }
                                else if (entry.AgentPackageCatalogue is { } catalogue)
                                {
                                    <div>已驗證套件：@catalogue.PackageCount 個</div>
                                    <details><summary>版本資訊</summary><span>@catalogue.SourceVersion</span></details>
                                }
                                else if (entry.AgentPackageTrust is { } trust)
                                {
                                    <div>信任根版本：@trust.RootVersion</div>
                                    <details><summary>SHA-256 指紋</summary><span>@trust.Sha256</span></details>
                                }
                                else if (entry.ServiceApproval is { } approval)
                                {
                                    <div>服務識別碼：@entry.ResourceId</div><div>來源識別碼：@approval.SourceId</div>
                                }
                                else if (entry.ServiceSource is not null)
                                {
                                    <div>來源識別碼：@entry.ResourceId</div>
                                }
                                else if (entry.Group is { } groupChange)
                                {
                                    <div>群組識別碼：@entry.ResourceId</div>
                                    @if (groupChange.Action is GroupAction.DevicesChanged or GroupAction.ServicesChanged) { <div>加入 @groupChange.Added，移出 @groupChange.Removed</div> }
                                }
                                else if (entry.InstancePolicy is { } instancePolicy)
                                {
                                    <div>每個服務：@instancePolicy.Previous.PerService → @instancePolicy.Current.PerService</div>
                                    <div>全平台：@instancePolicy.Previous.Total → @instancePolicy.Current.Total</div>
                                    <details><summary>版本資訊</summary><span>@(string.IsNullOrEmpty(instancePolicy.PreviousVersion) ? "初始設定" : instancePolicy.PreviousVersion) → @instancePolicy.CurrentVersion</span></details>
                                }
                                else if (entry.ServiceInstance is { } instance)
                                {
                                    <div>服務識別碼：@instance.ServiceId</div><div>執行個體識別碼：@entry.ResourceId</div>
                                }
                                else if (entry.LogQuota is { } quota)
                                {
                                    <div>每來源：@quota.Previous.SourceRate → @quota.Current.SourceRate 筆／秒，突發 @quota.Previous.SourceBurst → @quota.Current.SourceBurst 筆</div>
                                    <div>全平台：@quota.Previous.GlobalRate → @quota.Current.GlobalRate 筆／秒，突發 @quota.Previous.GlobalBurst → @quota.Current.GlobalBurst 筆</div>
                                    <details><summary>版本資訊</summary><span>@(string.IsNullOrEmpty(quota.PreviousVersion) ? "初始設定" : quota.PreviousVersion) → @quota.CurrentVersion</span></details>
                                }
                                else if (entry.TraceQuota is { } traceQuota)
                                {
                                    <div>每服務來源：@traceQuota.Previous.SourceRate → @traceQuota.Current.SourceRate 筆／秒，突發 @traceQuota.Previous.SourceBurst → @traceQuota.Current.SourceBurst 筆</div>
                                    <div>全平台：@traceQuota.Previous.GlobalRate → @traceQuota.Current.GlobalRate 筆／秒，突發 @traceQuota.Previous.GlobalBurst → @traceQuota.Current.GlobalBurst 筆</div>
                                    <details><summary>版本資訊</summary><span>@(string.IsNullOrEmpty(traceQuota.PreviousVersion) ? "初始設定" : traceQuota.PreviousVersion) → @traceQuota.CurrentVersion</span></details>
                                }
                                else if (entry.ServiceCollection is not null) { <div>服務識別碼：@entry.ResourceId</div> }
                                else if (entry.HealthTarget is { } health)
                                {
                                    <div>檢查識別碼：@entry.ResourceId</div><div>服務識別碼：@health.ServiceId</div>
                                    <div>間隔：@health.Current.IntervalSeconds 秒，逾時：@health.Current.TimeoutSeconds 秒</div>
                                    <div>失敗／恢復門檻：@health.Current.FailureThreshold／@health.Current.RecoveryThreshold，@Enabled(health.Current.Enabled)</div>
                                    @if (health.EndpointChanged) { <div>檢查網址已變更。</div> }
                                    <details><summary>版本資訊</summary><span>@(string.IsNullOrEmpty(health.PreviousVersion) ? "初始設定" : health.PreviousVersion) → @health.CurrentVersion</span></details>
                                }
                                else if (entry.Publication is { } publication) { <div>類型：@publication.ResourceKind</div><div>公開：@Enabled(publication.PreviousPublic) → @Enabled(publication.CurrentPublic)</div>@if (publication.NameChanged) { <div>公開名稱已變更。</div> } @if (publication.TemplateChanged) { <div>公開範本已變更。</div> } @if (publication.PolicyChanged) { <div>公開歷史設定已變更。</div> } }
                                else if (entry.PublicationTemplate is { } template) { <div>範本識別碼：@entry.ResourceId</div><div>受影響設備：@template.AffectedDevices</div> }
                                else if (entry.HealthNetworkPolicy is { } networks) { <div>網段政策版本：@networks.PreviousGeneration → @networks.CurrentGeneration</div> }
                                else if (entry.Collector is { } collector) { <div>Collector 識別碼：@entry.ResourceId</div><div>監控服務識別碼：@collector.MonitoringServiceId</div>@if (collector.SourceId is { } sourceId) { <div>來源識別碼：@sourceId</div> } }
                                else { <span>無法顯示此紀錄的內容。</span> }
                            </td>
                            <td>@if (Operation(entry) == "未支援的紀錄") { <span>未知</span> } else { <span class="audit-badge audit-badge-success">已儲存</span> }</td>
                        </tr>
                    }
                </tbody></table></div>
            }
            @if (result.Items.Count > 0 || result.Page > 1) { <nav class="audit-pagination" aria-label="稽核紀錄分頁">
                @if (result.Page > 1) { <a href="@PageUrl(result.Page - 1)">上一頁</a> }
                <span>第 @result.Page 頁</span>
                @if (result.HasMore) { <a href="@PageUrl(result.Page + 1)">下一頁</a> }
            </nav> }
            @if (result.LimitReached) { <p role="status">已達查詢頁數上限，請縮小日期範圍。</p> }
        </section>
    }
    else if (feedResult is not null)
    {
        <section class="audit-panel" aria-labelledby="audit-feed-title">
            <h2 id="audit-feed-title">查詢結果</h2>
            <p>每次只查詢所選來源；紀錄不一定包含變更前的值。背景工作「已接受」不代表工作執行成功。</p>
            @if (actorLookupFailed) { <p role="status">目前無法取得帳號名稱，改以帳號 ID 顯示。</p> }
            @if (feedResult.Items.Count == 0) { <p>@(feedResult.Page > 1 ? "此頁沒有紀錄，請返回上一頁。" : "此日期範圍沒有稽核紀錄。")</p> }
            else
            {
                <p class="audit-scroll-hint">← 左右滑動查看完整表格 →</p>
                <div class="audit-table-wrap" role="region" aria-label="稽核紀錄表，可左右捲動" tabindex="0"><table><thead><tr><th scope="col">時間（UTC）</th><th scope="col">操作者</th><th scope="col">操作</th><th scope="col">對象</th><th scope="col">詳細資訊</th><th scope="col">結果</th></tr></thead><tbody>
                @foreach (var entry in feedResult.Items)
                {
                    <tr>
                        <td>@entry.OccurredAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(entry.ActorId is { } actor ? Actor(actor) : "系統／機器流程")</td>
                        <td>@ActionText(entry.Action)</td>
                        <td>@(entry.SubjectId?.ToString("D") ?? (feedResult.Source is AuditFeedSource.AgentSettings or AuditFeedSource.AgentQueueCapacity or AuditFeedSource.AgentMetricSettings or AuditFeedSource.InventorySettings ? "平台設定" : "—"))</td>
                        <td>
                            @if (entry.AgentId is { } agentId) { <div>Agent：@agentId</div> }
                            @if (entry.Reference is { } reference) { <div>工作：@reference</div> }
                            @if (entry.MetricThreshold is { } threshold) { <div>閾值 ID：@threshold.ThresholdId</div><div>Agent：@threshold.AgentId · 指標：@((Vigiloom.Contracts.Agent.AgentMetricKind)threshold.Kind) · 來源：@threshold.Source @(threshold.Dimension is null ? "" : $"· {threshold.Dimension}")</div><div>@(threshold.Enabled ? "啟用" : "停用") · @(threshold.Comparison == 1 ? "大於等於" : "小於等於") @threshold.Value · 有效時間 @threshold.FreshnessSeconds 秒</div><details><summary>設定版本</summary>@threshold.Version</details> }
                            @if (entry.HostLogSource is { } logSource) { <div>來源：@logSource.SourceId</div><div>設定：@(logSource.Enabled ? "啟用" : "停用")</div><details><summary>來源版本</summary><div>代次：@logSource.Generation</div><div>版本：@logSource.Version</div></details> }
                            @if (entry.AgentSettings is { } settings)
                            {
                                <div>有效心跳：@settings.EffectiveHeartbeatSeconds 秒</div><div>有效設定同步：@settings.EffectiveSettingsPollSeconds 秒</div><div>有效批次間隔：@settings.EffectiveBatchIntervalSeconds 秒</div>
                                <details><summary>設定與版本</summary><div>覆寫：@(settings.HeartbeatSeconds?.ToString() ?? "繼承")／@(settings.SettingsPollSeconds?.ToString() ?? "繼承")／@(settings.BatchIntervalSeconds?.ToString() ?? "繼承")</div><div>版本：@settings.Version</div><div>有效版本：@settings.Revision</div></details>
                            }
                            @if (entry.QueueCapacity is { } capacity)
                            {
                                <div>有效容量：@(capacity.EffectivePayloadBytes / 1048576) MiB</div><div>有效批次上限：@capacity.EffectiveBatchCount</div>
                                <details><summary>設定與版本</summary><div>覆寫：@(capacity.PayloadBytes is { } bytes ? $"{bytes / 1048576} MiB" : "繼承")／@(capacity.BatchCount?.ToString() ?? "繼承")</div><div>版本：@capacity.Version</div><div>有效版本：@capacity.Revision</div></details>
                            }
                            @if (entry.MetricSettings is { } metrics)
                            {
                                <div>有效主機採樣：@metrics.EffectiveHostIntervalSeconds 秒</div><div>有效程序採樣：@metrics.EffectiveProcessIntervalSeconds 秒</div>
                                <div>有效採樣 CPU 預算：@metrics.EffectiveCpuMillisecondsPerMinute 毫秒／分鐘</div>
                                <div>有效 Agent 記憶體門檻：@metrics.EffectiveWorkingSetLimitMiB MiB</div>
                                <div>有效程序採集時間預算：@metrics.EffectiveProcessCollectionBudgetMs 毫秒</div>
                                <div>有效採樣 I/O 預算：@metrics.EffectiveIoLimitMiBPerMinute MiB／分鐘</div>
                                <details><summary>設定與版本</summary><div>覆寫：@(metrics.HostIntervalSeconds?.ToString() ?? "繼承")／@(metrics.ProcessIntervalSeconds?.ToString() ?? "繼承")</div><div>CPU 預算覆寫：@(metrics.CpuMillisecondsPerMinute?.ToString() ?? "繼承")</div><div>記憶體門檻覆寫：@(metrics.WorkingSetLimitMiB?.ToString() ?? "繼承")</div><div>程序時間預算覆寫：@(metrics.ProcessCollectionBudgetMs?.ToString() ?? "繼承")</div><div>採樣 I/O 預算覆寫：@(metrics.IoLimitMiBPerMinute?.ToString() ?? "繼承")</div><div>版本：@metrics.Version</div><div>有效版本：@metrics.Revision</div></details>
                            }
                            @if (entry.InventorySettings is { } inventory) { <div>有效盤點間隔：@inventory.EffectiveScanIntervalSeconds 秒</div><div>程序執行資訊：@(inventory.EffectiveCollectCommandLine ? "收集路徑，參數遮罩" : "不收集")</div><details><summary>設定與版本</summary><div>覆寫：@(inventory.ScanIntervalSeconds?.ToString() ?? "繼承")</div><div>執行資訊覆寫：@(inventory.CollectCommandLine is null ? "繼承" : inventory.CollectCommandLine.Value ? "收集路徑" : "不收集")</div><div>版本：@inventory.Version</div><div>有效版本：@inventory.Revision</div></details> }
                            @if (entry.AgentId is null && entry.Reference is null && entry.AgentSettings is null && entry.QueueCapacity is null && entry.MetricSettings is null && entry.HostLogSource is null && entry.InventorySettings is null && entry.MetricThreshold is null) { <span>—</span> }
                        </td>
                        <td>@OutcomeText(entry.Outcome)</td>
                    </tr>
                }
                </tbody></table></div>
            }
            @if (feedResult.Items.Count > 0 || feedResult.Page > 1) { <nav class="audit-pagination" aria-label="稽核紀錄分頁">
                @if (feedResult.Page > 1) { <a href="@PageUrl(feedResult.Page - 1)">上一頁</a> }
                <span>第 @feedResult.Page 頁</span>
                @if (feedResult.HasMore) { <a href="@PageUrl(feedResult.Page + 1)">下一頁</a> }
            </nav> }
            @if (feedResult.LimitReached) { <p role="status">已達查詢頁數上限，請縮小日期範圍。</p> }
        </section>
    }
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? Source { get; set; }
    private string fromText = "", toText = "";
    private string sourceText = "speed";
    private string? dateError, pageError;
    private bool unavailable, actorLookupFailed;
    private OperationAuditPage? result;
    private AuditFeedPage? feedResult;
    private Dictionary<Guid, string> actors = [];

    protected override async Task OnParametersSetAsync()
    {
        var today = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        sourceText = Source ?? "speed";
        var selected = AuditFeedReader.Parse(sourceText);
        if (sourceText is not ("speed" or "ping" or "agent-replay" or "agent-inbox" or "agent-packages" or "service-approvals" or "service-sources" or "groups" or "publications" or "instance-policy" or "log-quota" or "trace-quota" or "service-instances" or "service-collections" or "health-targets" or "health-networks" or "collectors") && selected is null) { pageError = "紀錄來源無效，請重新查詢。"; return; }
        fromText = From ?? today.AddDays(-6).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        toText = To ?? today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if (!DateOnly.TryParseExact(fromText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var from) ||
            !DateOnly.TryParseExact(toText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var to) ||
            to == DateOnly.MaxValue)
        { dateError = "請選擇有效的日期。"; return; }
        if (from > to) { dateError = "開始日期不能晚於結束日期。"; return; }
        if (to.DayNumber - from.DayNumber >= 31) { dateError = "一次最多查詢 31 天。"; return; }
        var page = 1;
        if (Page is not null && (!int.TryParse(Page, NumberStyles.None, CultureInfo.InvariantCulture, out page) || page is < 1 or > 1000))
        { pageError = "頁碼無效，請重新查詢。"; return; }
        var query = new OperationAuditQuery(new DateTimeOffset(from.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc)),
            new DateTimeOffset(to.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc)), page);
        if (!OperationAuditQueryService.Valid(query)) { dateError = "請選擇有效的日期範圍。"; return; }
        try
        {
            Guid[] ids;
            if (sourceText is "speed" or "ping" or "agent-replay" or "agent-inbox" or "agent-packages" or "service-approvals" or "service-sources" or "groups" or "publications" or "instance-policy" or "log-quota" or "trace-quota" or "service-instances" or "service-collections" or "health-targets" or "health-networks" or "collectors")
            {
                result = sourceText switch
                {
                    "ping" => await Audit.QueryPingAsync(query, HttpContext.RequestAborted),
                    "agent-replay" => await Audit.QueryAgentReplayAsync(query, HttpContext.RequestAborted),
                    "agent-inbox" => await Audit.QueryAgentInboxAsync(query, HttpContext.RequestAborted),
                    "agent-packages" => await Audit.QueryAgentPackagesAsync(query, HttpContext.RequestAborted),
                    "service-approvals" => await Audit.QueryServiceApprovalsAsync(query, HttpContext.RequestAborted),
                    "service-sources" => await Audit.QueryServiceSourcesAsync(query, HttpContext.RequestAborted),
                    "groups" => await Audit.QueryGroupsAsync(query, HttpContext.RequestAborted),
                    "publications" => await Audit.QueryPublicationsAsync(query, HttpContext.RequestAborted),
                    "instance-policy" => await Audit.QueryInstancePoliciesAsync(query, HttpContext.RequestAborted),
                    "log-quota" => await Audit.QueryLogQuotaAsync(query, HttpContext.RequestAborted),
                    "trace-quota" => await Audit.QueryTraceQuotaAsync(query, HttpContext.RequestAborted),
                    "service-instances" => await Audit.QueryServiceInstancesAsync(query, HttpContext.RequestAborted),
                    "service-collections" => await Audit.QueryServiceCollectionsAsync(query, HttpContext.RequestAborted),
                    "health-targets" => await Audit.QueryHealthTargetsAsync(query, HttpContext.RequestAborted),
                    "health-networks" => await Audit.QueryHealthNetworkPoliciesAsync(query, HttpContext.RequestAborted),
                    "collectors" => await Audit.QueryCollectorsAsync(query, HttpContext.RequestAborted),
                    _ => await Audit.QueryAsync(query, HttpContext.RequestAborted)
                };
                ids = result.Items.Select(x => x.ActorId).Distinct().ToArray();
            }
            else
            {
                feedResult = await Feeds.QueryAsync(selected!.Value, query, HttpContext.RequestAborted);
                ids = feedResult.Items.Where(x => x.ActorId.HasValue).Select(x => x.ActorId!.Value).Distinct().ToArray();
            }
            try
            {
                actors = await Users.Users.AsNoTracking().Where(x => ids.Contains(x.Id) && x.UserName != null)
                    .ToDictionaryAsync(x => x.Id, x => x.UserName!, HttpContext.RequestAborted);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            { actorLookupFailed = true; Logger.LogWarning("Audit actor lookup failed: {ExceptionType}", ex.GetType().Name); }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        { unavailable = true; Logger.LogWarning("Audit query failed: {ExceptionType}", ex.GetType().Name); }
    }

    private string Actor(Guid id) => actors.TryGetValue(id, out var name) ? name : id.ToString("D");
    private string PageUrl(int page) => $"/settings/audit?source={Uri.EscapeDataString(sourceText)}&from={Uri.EscapeDataString(fromText)}&to={Uri.EscapeDataString(toText)}&page={page}";
    private static string Enabled(bool value) => value ? "啟用" : "停用";
    private static string Operation(OperationAuditEntry entry) => entry.Group?.Action switch
    {
        GroupAction.Created => "建立群組", GroupAction.Updated => "更新群組", GroupAction.Deleted => "刪除群組",
        GroupAction.DevicesChanged => "變更設備", GroupAction.ServicesChanged => "變更服務",
        _ => OtherOperation(entry)
    };
    private static string OtherOperation(OperationAuditEntry entry) => entry.ServiceApproval is not null ? "加入服務" : entry.ServiceSource?.Action switch
    {
        ServiceSourceAction.Issued => "建立來源",
        ServiceSourceAction.Revoked => "撤銷來源",
        ServiceSourceAction.CredentialRotated => "更換來源憑證",
        _ when entry.ServiceInstance?.Action == ServiceInstanceAction.Retired => "退役",
        _ when entry.ServiceInstance?.Action == ServiceInstanceAction.Restored => "恢復",
        _ when entry.ServiceCollection?.Action == ServiceCollectionAction.Stopped => "停止收集",
        _ when entry.ServiceCollection?.Action == ServiceCollectionAction.Resumed => "恢復收集",
        _ when entry.Publication is not null => "變更公開設定",
        _ when entry.PublicationTemplate?.Action == PublicationTemplateAction.Created => "建立公開範本",
        _ when entry.PublicationTemplate?.Action == PublicationTemplateAction.Updated => "修改公開範本",
        _ when entry.PublicationTemplate?.Action == PublicationTemplateAction.DefaultChanged => "設定預設範本",
        _ when entry.PublicationTemplate?.Action == PublicationTemplateAction.Retired => "刪除公開範本",
        _ when entry.PublicationTemplate?.Action == PublicationTemplateAction.DefaultCleared => "清除預設範本",
        _ when entry.HealthTarget?.Action == HealthTargetAction.Created => "新增檢查",
        _ when entry.HealthTarget?.Action == HealthTargetAction.Updated => "更新檢查",
        _ when entry.HealthNetworkPolicy is not null => "更新網段",
        _ when entry.Collector?.Action == CollectorAction.Registered => "登記 Collector",
        _ when entry.Collector?.Action == CollectorAction.RouteAdded => "加入來源對應",
        _ when entry.Collector?.Action == CollectorAction.RouteRemoved => "移除來源對應",
        _ when entry.AgentInboxActivation is not null => "啟用清理",
        _ when entry.AgentPackageCatalogue is not null => "刷新清單",
        _ when entry.AgentPackageTrust is not null => "初始化信任根",
        _ when entry.SpeedSettings is not null || entry.SpeedRetention is not null || entry.PingSettings is not null || entry.AgentReplayPolicy is not null || entry.AgentInboxSettings is not null || entry.AgentPackageSource is not null || entry.InstancePolicy is not null || entry.LogQuota is not null || entry.TraceQuota is not null => "更新",
        _ => "未支援的紀錄"
    };
    private static string ReplayPhase(AgentReplayPhase value) => value switch { AgentReplayPhase.Disabled => "尚未啟用期限", AgentReplayPhase.Grace => "過渡期間", AgentReplayPhase.Enforced => "期限已啟用", _ => "未知" };
    private static string OutcomeText(AuditFeedOutcome outcome) => outcome switch
    {
        AuditFeedOutcome.Recorded => "已記錄", AuditFeedOutcome.Started => "已開始", AuditFeedOutcome.Accepted => "已接受",
        AuditFeedOutcome.Pending => "待套用", AuditFeedOutcome.Rejected => "已拒絕", _ => "未知"
    };
    private static string ActionText(AuditFeedAction action) => action switch
    {
        AuditFeedAction.AccountCreated => "建立帳號", AuditFeedAction.AccountRenamed => "變更帳號名稱", AuditFeedAction.AccountRoleChanged => "變更角色", AuditFeedAction.AccountDeleted => "刪除帳號",
        AuditFeedAction.PasswordResetIssued => "核發重設密碼", AuditFeedAction.PasswordResetCompleted => "完成密碼重設", AuditFeedAction.PasswordChanged => "變更密碼",
        AuditFeedAction.TwoFactorEnrollmentStarted => "開始雙重驗證設定", AuditFeedAction.TwoFactorEnabled => "啟用雙重驗證", AuditFeedAction.TwoFactorDisabled => "停用雙重驗證", AuditFeedAction.TwoFactorResetByAdministrator => "管理員重設雙重驗證",
        AuditFeedAction.InitialAdministratorCreated => "建立首位管理員", AuditFeedAction.LocalAdministratorRecovery => "本機復原管理員",
        AuditFeedAction.ApiCredentialIssued => "核發 API 憑證", AuditFeedAction.ApiCredentialRevoked => "撤銷 API 憑證",
        AuditFeedAction.DeviceCreated => "建立設備", AuditFeedAction.DeviceUpdated => "更新設備", AuditFeedAction.DeviceArchived => "封存設備", AuditFeedAction.DeviceRestored => "還原設備",
        AuditFeedAction.EnrollmentIssued => "核發 Agent 註冊", AuditFeedAction.EnrollmentRevoked => "撤銷 Agent 註冊", AuditFeedAction.AgentEnrolled => "Agent 加入", AuditFeedAction.AgentRevoked => "撤銷 Agent", AuditFeedAction.RotationStarted => "開始憑證輪替", AuditFeedAction.RotationFinished => "完成憑證輪替",
        AuditFeedAction.HostMetricThresholdChanged => "變更主機效能閾值", AuditFeedAction.AgentSettingsChanged => "變更 Agent 設定", AuditFeedAction.AgentQueueCapacityChanged => "變更 Agent 佇列容量", AuditFeedAction.AgentMetricSettingsChanged => "變更 Agent 指標設定", AuditFeedAction.InventorySettingsChanged => "變更主機盤點設定", AuditFeedAction.HostLogSourceCreated => "新增主機日誌來源", AuditFeedAction.HostLogSourceUpdated => "更新主機日誌來源", AuditFeedAction.HostLogSourceRetired => "移除主機日誌來源", AuditFeedAction.ScheduleSettingsChanged => "變更排程設定", AuditFeedAction.JobDeleteRequested => "刪除工作", AuditFeedAction.JobRequeueRequested => "重新排入工作", AuditFeedAction.JobEnqueueRequested => "排入工作", AuditFeedAction.RecurringJobRemoveRequested => "移除週期工作", AuditFeedAction.RecurringJobTriggerRequested => "觸發週期工作",
        _ => "未支援的紀錄"
    };
}
