@page "/settings/audit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Globalization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Vigiloom.Contracts.Operations
@using Vigiloom.Contracts.Agent
@using Vigiloom.Modules.AlertingOperations.Application
@using Vigiloom.Modules.IdentityAccess.Domain
@using Vigiloom.Web.Diagnostics
@inject OperationAuditQueryService Audit
@inject AuditFeedReader Feeds
@inject UserManager<Account> Users
@inject TimeProvider Clock
@inject ILogger<AuditLog> Logger

<PageTitle>操作稽核 - Vigiloom</PageTitle>
<main class="audit-page">
    <header class="audit-heading"><h1>操作稽核</h1><p>依來源查看操作紀錄。時間以 UTC 顯示。</p></header>
    <section class="audit-panel" aria-labelledby="audit-filter-title">
        <h2 id="audit-filter-title">查詢紀錄</h2>
        <form method="get" action="/settings/audit">
            <div class="audit-date-field"><label for="audit-source">紀錄來源</label><select id="audit-source" name="source">
                <option value="speed" selected="@(sourceText == "speed")">網路測速設定</option><option value="ping" selected="@(sourceText == "ping")">Ping 設定</option><option value="accounts" selected="@(sourceText == "accounts")">帳號</option><option value="api-credentials" selected="@(sourceText == "api-credentials")">API 憑證</option>
                <option value="devices" selected="@(sourceText == "devices")">設備</option><option value="agent-identity" selected="@(sourceText == "agent-identity")">Agent 身分</option><option value="agent-settings" selected="@(sourceText == "agent-settings")">Agent 設定</option><option value="agent-queue-capacity" selected="@(sourceText == "agent-queue-capacity")">Agent 佇列容量</option><option value="agent-replay" selected="@(sourceText == "agent-replay")">Agent 補送政策</option><option value="scheduling" selected="@(sourceText == "scheduling")">背景工作</option>
            </select></div>
            <div class="audit-date-field"><label for="audit-from">開始日期（UTC）</label><input id="audit-from" name="from" type="date" value="@fromText" aria-invalid="@(dateError is not null ? "true" : null)" aria-describedby="@(dateError is not null ? "audit-date-error" : null)" required /></div>
            <div class="audit-date-field"><label for="audit-to">結束日期（UTC）</label><input id="audit-to" name="to" type="date" value="@toText" aria-invalid="@(dateError is not null ? "true" : null)" aria-describedby="@(dateError is not null ? "audit-date-error" : null)" required /></div>
            <button type="submit">查詢</button>
        </form>
        @if (dateError is not null) { <p id="audit-date-error" class="audit-error" role="alert">@dateError</p> }
        @if (pageError is not null) { <p class="audit-error" role="alert">@pageError</p> }
        <p>一次最多查詢 31 天，包含所選結束日期。</p>
    </section>
    @if (unavailable) { <section class="audit-notice" role="alert">暫時無法讀取稽核紀錄，請稍後重新整理。</section> }
    else if (result is not null)
    {
        <section class="audit-panel" aria-labelledby="audit-results-title">
            <h2 id="audit-results-title">查詢結果</h2>
            <p>此來源收錄成功儲存的@(sourceText == "ping" ? " Ping 設定" : sourceText == "agent-replay" ? " Agent 補送政策" : "網路測速設定")變更。其他來源可由上方選擇。</p>
            @if (actorLookupFailed) { <p role="status">目前無法取得帳號名稱，改以帳號 ID 顯示。</p> }
            @if (result.Items.Count == 0) { <p>@(result.Page > 1 ? "此頁沒有紀錄，請返回上一頁。" : "此日期範圍沒有稽核紀錄。")</p> }
            else
            {
                <p class="audit-scroll-hint">← 左右滑動查看完整表格 →</p>
                <div class="audit-table-wrap" role="region" aria-label="稽核紀錄表，可左右捲動" tabindex="0"><table><thead><tr><th scope="col">時間（UTC）</th><th scope="col">操作者</th><th scope="col">操作</th><th scope="col">對象</th><th scope="col">變更內容</th><th scope="col">結果</th></tr></thead><tbody>
                    @foreach (var entry in result.Items)
                    {
                        <tr>
                            <td>@entry.OccurredAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@Actor(entry.ActorId)</td>
                            <td>@if (entry.SpeedSettings is null && entry.PingSettings is null && entry.AgentReplayPolicy is null) { <span>未支援的紀錄</span> } else { <span class="audit-badge audit-badge-action">更新</span> }</td>
                            <td>@(entry.PingSettings is not null ? "Ping 設定" : entry.SpeedSettings is not null ? "網路測速設定" : entry.AgentReplayPolicy is not null ? "Agent 補送政策" : "未知")</td>
                            <td>
                                @if (entry.SpeedSettings is { } change)
                                {
                                    <div>排程：@Enabled(change.Previous.Automatic) → @Enabled(change.Current.Automatic)</div>
                                    <div>間隔：@change.Previous.IntervalHours → @change.Current.IntervalHours 小時</div>
                                    <div>流量：@change.Previous.MaxMiB → @change.Current.MaxMiB MiB</div>
                                    <div>逾時：@change.Previous.TimeoutSeconds → @change.Current.TimeoutSeconds 秒</div>
                                    <details><summary>版本資訊</summary><span>@change.PreviousVersion → @change.CurrentVersion</span></details>
                                }
                                else if (entry.PingSettings is { } ping)
                                {
                                    <div>間隔：@ping.Previous.IntervalSeconds → @ping.Current.IntervalSeconds 秒</div>
                                    <div>逾時：@ping.Previous.TimeoutSeconds → @ping.Current.TimeoutSeconds 秒</div>
                                    <div>失敗門檻：@ping.Previous.FailureThreshold → @ping.Current.FailureThreshold</div>
                                    <div>成功門檻：@ping.Previous.SuccessThreshold → @ping.Current.SuccessThreshold</div>
                                    <div>並行上限：@ping.Previous.MaxConcurrency → @ping.Current.MaxConcurrency</div>
                                    <details><summary>版本資訊</summary><span>@(string.IsNullOrEmpty(ping.PreviousVersion) ? "初始設定" : ping.PreviousVersion) → @ping.CurrentVersion</span></details>
                                }
                                else if (entry.AgentReplayPolicy is { } replay)
                                {
                                    <div>狀態：@ReplayPhase(replay.Previous) → @ReplayPhase(replay.Current)</div>
                                    <div>過渡期截止（UTC）：@replay.GraceUntil.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                                    <details><summary>版本資訊</summary><span>@replay.PreviousVersion → @replay.CurrentVersion</span></details>
                                }
                                else { <span>無法顯示此紀錄的內容。</span> }
                            </td>
                            <td>@if (entry.SpeedSettings is null && entry.PingSettings is null && entry.AgentReplayPolicy is null) { <span>未知</span> } else { <span class="audit-badge audit-badge-success">已儲存</span> }</td>
                        </tr>
                    }
                </tbody></table></div>
            }
            @if (result.Items.Count > 0 || result.Page > 1) { <nav class="audit-pagination" aria-label="稽核紀錄分頁">
                @if (result.Page > 1) { <a href="@PageUrl(result.Page - 1)">上一頁</a> }
                <span>第 @result.Page 頁</span>
                @if (result.HasMore) { <a href="@PageUrl(result.Page + 1)">下一頁</a> }
            </nav> }
            @if (result.LimitReached) { <p role="status">已達查詢頁數上限，請縮小日期範圍。</p> }
        </section>
    }
    else if (feedResult is not null)
    {
        <section class="audit-panel" aria-labelledby="audit-feed-title">
            <h2 id="audit-feed-title">查詢結果</h2>
            <p>每次只查詢所選來源；紀錄不一定包含變更前的值。背景工作「已接受」不代表工作執行成功。</p>
            @if (actorLookupFailed) { <p role="status">目前無法取得帳號名稱，改以帳號 ID 顯示。</p> }
            @if (feedResult.Items.Count == 0) { <p>@(feedResult.Page > 1 ? "此頁沒有紀錄，請返回上一頁。" : "此日期範圍沒有稽核紀錄。")</p> }
            else
            {
                <p class="audit-scroll-hint">← 左右滑動查看完整表格 →</p>
                <div class="audit-table-wrap" role="region" aria-label="稽核紀錄表，可左右捲動" tabindex="0"><table><thead><tr><th scope="col">時間（UTC）</th><th scope="col">操作者</th><th scope="col">操作</th><th scope="col">對象</th><th scope="col">詳細資訊</th><th scope="col">結果</th></tr></thead><tbody>
                @foreach (var entry in feedResult.Items)
                {
                    <tr>
                        <td>@entry.OccurredAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(entry.ActorId is { } actor ? Actor(actor) : "系統／機器流程")</td>
                        <td>@ActionText(entry.Action)</td>
                        <td>@(entry.SubjectId?.ToString("D") ?? (feedResult.Source is AuditFeedSource.AgentSettings or AuditFeedSource.AgentQueueCapacity ? "平台設定" : "—"))</td>
                        <td>
                            @if (entry.AgentId is { } agentId) { <div>Agent：@agentId</div> }
                            @if (entry.Reference is { } reference) { <div>工作：@reference</div> }
                            @if (entry.AgentSettings is { } settings)
                            {
                                <div>有效心跳：@settings.EffectiveHeartbeatSeconds 秒</div><div>有效設定同步：@settings.EffectiveSettingsPollSeconds 秒</div><div>有效批次間隔：@settings.EffectiveBatchIntervalSeconds 秒</div>
                                <details><summary>設定與版本</summary><div>覆寫：@(settings.HeartbeatSeconds?.ToString() ?? "繼承")／@(settings.SettingsPollSeconds?.ToString() ?? "繼承")／@(settings.BatchIntervalSeconds?.ToString() ?? "繼承")</div><div>版本：@settings.Version</div><div>有效版本：@settings.Revision</div></details>
                            }
                            @if (entry.QueueCapacity is { } capacity)
                            {
                                <div>有效容量：@(capacity.EffectivePayloadBytes / 1048576) MiB</div><div>有效批次上限：@capacity.EffectiveBatchCount</div>
                                <details><summary>設定與版本</summary><div>覆寫：@(capacity.PayloadBytes is { } bytes ? $"{bytes / 1048576} MiB" : "繼承")／@(capacity.BatchCount?.ToString() ?? "繼承")</div><div>版本：@capacity.Version</div><div>有效版本：@capacity.Revision</div></details>
                            }
                            @if (entry.AgentId is null && entry.Reference is null && entry.AgentSettings is null && entry.QueueCapacity is null) { <span>—</span> }
                        </td>
                        <td>@OutcomeText(entry.Outcome)</td>
                    </tr>
                }
                </tbody></table></div>
            }
            @if (feedResult.Items.Count > 0 || feedResult.Page > 1) { <nav class="audit-pagination" aria-label="稽核紀錄分頁">
                @if (feedResult.Page > 1) { <a href="@PageUrl(feedResult.Page - 1)">上一頁</a> }
                <span>第 @feedResult.Page 頁</span>
                @if (feedResult.HasMore) { <a href="@PageUrl(feedResult.Page + 1)">下一頁</a> }
            </nav> }
            @if (feedResult.LimitReached) { <p role="status">已達查詢頁數上限，請縮小日期範圍。</p> }
        </section>
    }
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? Source { get; set; }
    private string fromText = "", toText = "";
    private string sourceText = "speed";
    private string? dateError, pageError;
    private bool unavailable, actorLookupFailed;
    private OperationAuditPage? result;
    private AuditFeedPage? feedResult;
    private Dictionary<Guid, string> actors = [];

    protected override async Task OnParametersSetAsync()
    {
        var today = DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);
        sourceText = Source ?? "speed";
        var selected = AuditFeedReader.Parse(sourceText);
        if (sourceText is not ("speed" or "ping" or "agent-replay") && selected is null) { pageError = "紀錄來源無效，請重新查詢。"; return; }
        fromText = From ?? today.AddDays(-6).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        toText = To ?? today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        if (!DateOnly.TryParseExact(fromText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var from) ||
            !DateOnly.TryParseExact(toText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var to) ||
            to == DateOnly.MaxValue)
        { dateError = "請選擇有效的日期。"; return; }
        if (from > to) { dateError = "開始日期不能晚於結束日期。"; return; }
        if (to.DayNumber - from.DayNumber >= 31) { dateError = "一次最多查詢 31 天。"; return; }
        var page = 1;
        if (Page is not null && (!int.TryParse(Page, NumberStyles.None, CultureInfo.InvariantCulture, out page) || page is < 1 or > 1000))
        { pageError = "頁碼無效，請重新查詢。"; return; }
        var query = new OperationAuditQuery(new DateTimeOffset(from.ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc)),
            new DateTimeOffset(to.AddDays(1).ToDateTime(TimeOnly.MinValue, DateTimeKind.Utc)), page);
        if (!OperationAuditQueryService.Valid(query)) { dateError = "請選擇有效的日期範圍。"; return; }
        try
        {
            Guid[] ids;
            if (sourceText is "speed" or "ping" or "agent-replay")
            {
                result = sourceText == "ping" ? await Audit.QueryPingAsync(query, HttpContext.RequestAborted) : sourceText == "agent-replay" ? await Audit.QueryAgentReplayAsync(query, HttpContext.RequestAborted) : await Audit.QueryAsync(query, HttpContext.RequestAborted);
                ids = result.Items.Select(x => x.ActorId).Distinct().ToArray();
            }
            else
            {
                feedResult = await Feeds.QueryAsync(selected!.Value, query, HttpContext.RequestAborted);
                ids = feedResult.Items.Where(x => x.ActorId.HasValue).Select(x => x.ActorId!.Value).Distinct().ToArray();
            }
            try
            {
                actors = await Users.Users.AsNoTracking().Where(x => ids.Contains(x.Id) && x.UserName != null)
                    .ToDictionaryAsync(x => x.Id, x => x.UserName!, HttpContext.RequestAborted);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            { actorLookupFailed = true; Logger.LogWarning("Audit actor lookup failed: {ExceptionType}", ex.GetType().Name); }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        { unavailable = true; Logger.LogWarning("Audit query failed: {ExceptionType}", ex.GetType().Name); }
    }

    private string Actor(Guid id) => actors.TryGetValue(id, out var name) ? name : id.ToString("D");
    private string PageUrl(int page) => $"/settings/audit?source={Uri.EscapeDataString(sourceText)}&from={Uri.EscapeDataString(fromText)}&to={Uri.EscapeDataString(toText)}&page={page}";
    private static string Enabled(bool value) => value ? "啟用" : "停用";
    private static string ReplayPhase(AgentReplayPhase value) => value switch { AgentReplayPhase.Disabled => "尚未啟用期限", AgentReplayPhase.Grace => "過渡期間", AgentReplayPhase.Enforced => "期限已啟用", _ => "未知" };
    private static string OutcomeText(AuditFeedOutcome outcome) => outcome switch
    {
        AuditFeedOutcome.Recorded => "已記錄", AuditFeedOutcome.Started => "已開始", AuditFeedOutcome.Accepted => "已接受",
        AuditFeedOutcome.Pending => "待套用", AuditFeedOutcome.Rejected => "已拒絕", _ => "未知"
    };
    private static string ActionText(AuditFeedAction action) => action switch
    {
        AuditFeedAction.AccountCreated => "建立帳號", AuditFeedAction.AccountRenamed => "變更帳號名稱", AuditFeedAction.AccountRoleChanged => "變更角色", AuditFeedAction.AccountDeleted => "刪除帳號",
        AuditFeedAction.PasswordResetIssued => "核發重設密碼", AuditFeedAction.PasswordResetCompleted => "完成密碼重設", AuditFeedAction.PasswordChanged => "變更密碼",
        AuditFeedAction.TwoFactorEnrollmentStarted => "開始雙重驗證設定", AuditFeedAction.TwoFactorEnabled => "啟用雙重驗證", AuditFeedAction.TwoFactorDisabled => "停用雙重驗證", AuditFeedAction.TwoFactorResetByAdministrator => "管理員重設雙重驗證",
        AuditFeedAction.InitialAdministratorCreated => "建立首位管理員", AuditFeedAction.LocalAdministratorRecovery => "本機復原管理員",
        AuditFeedAction.ApiCredentialIssued => "核發 API 憑證", AuditFeedAction.ApiCredentialRevoked => "撤銷 API 憑證",
        AuditFeedAction.DeviceCreated => "建立設備", AuditFeedAction.DeviceUpdated => "更新設備", AuditFeedAction.DeviceArchived => "封存設備", AuditFeedAction.DeviceRestored => "還原設備",
        AuditFeedAction.EnrollmentIssued => "核發 Agent 註冊", AuditFeedAction.EnrollmentRevoked => "撤銷 Agent 註冊", AuditFeedAction.AgentEnrolled => "Agent 加入", AuditFeedAction.AgentRevoked => "撤銷 Agent", AuditFeedAction.RotationStarted => "開始憑證輪替", AuditFeedAction.RotationFinished => "完成憑證輪替",
        AuditFeedAction.AgentSettingsChanged => "變更 Agent 設定", AuditFeedAction.AgentQueueCapacityChanged => "變更 Agent 佇列容量", AuditFeedAction.ScheduleSettingsChanged => "變更排程設定", AuditFeedAction.JobDeleteRequested => "刪除工作", AuditFeedAction.JobRequeueRequested => "重新排入工作", AuditFeedAction.JobEnqueueRequested => "排入工作", AuditFeedAction.RecurringJobRemoveRequested => "移除週期工作", AuditFeedAction.RecurringJobTriggerRequested => "觸發週期工作",
        _ => "未支援的紀錄"
    };
}
