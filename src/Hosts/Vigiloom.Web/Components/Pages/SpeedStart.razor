@page "/speed-tests/start"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.BuildingBlocks.Identifiers
@using Vigiloom.Modules.NetworkMonitoring.Application.SpeedTests
@inject SpeedSettings Settings
@inject SpeedQueue Queue
@inject NavigationManager Navigation
@inject ILogger<SpeedStart> Logger
<PageTitle>手動測速 - Vigiloom</PageTitle>
<main class="device-page device-form-page">
    <a href="/speed-tests">← 返回測速紀錄</a><header class="device-heading"><h1>手動測速</h1></header>
    <section class="device-panel">
        @if (error) { <p role="alert">無法讀取測速設定，請稍後重新整理。</p> }
        else if (settings is { Consent: false }) { <h2>尚未啟用 Speedtest.net 測試</h2><p>請先由設定頁了解測速及第三方使用條件，再啟用測試。</p><a class="device-primary" href="/settings/speed-tests">前往測速設定</a> }
        else if (settings is not null)
        {
            <p>從中央 Worker 執行一次測試，參考流量預算為 @settings.MaxMiB MiB、最長 @settings.TimeoutSeconds 秒，會占用上下傳頻寬；實際線路流量可能高於預算。測試連線會到 Speedtest.net 服務端；這不是每台設備的連線速度。</p>
            <p>最近 24 小時已保留 @settings.ReservedToday 次；執行中不能再新增另一筆。</p>
            @if (message is not null) { <p role="status">@message</p> }
            <EditForm Model="Input" FormName="speed-start" method="post" OnValidSubmit="StartAsync">
                <InputHidden @bind-Value="Input.RequestId" />
                <label><InputCheckbox @bind-Value="Input.Confirm" /> 我確認現在從中央位置進行測試及上述流量影響。</label>
                <div class="device-actions"><button type="submit">開始測速</button></div>
            </EditForm>
        }
    </section>
</main>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "speed-start")] private StartForm Input { get; set; } = default!;
    private Vigiloom.Contracts.SpeedTests.SpeedSettingsSnapshot? settings;
    private bool error;
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (HttpMethods.IsGet(HttpContext.Request.Method)) Input.RequestId = ResourceIds.Create().ToString("D");
        try { settings = await Settings.GetAsync(HttpContext.RequestAborted); }
        catch (Exception ex) { Logger.LogWarning("Could not load speed settings: {ExceptionType}", ex.GetType().Name); error = true; }
    }
    private async Task StartAsync()
    {
        if (!Input.Confirm) { message = "請先確認測試影響。"; return; }
        if (!Guid.TryParse(Input.RequestId, out var request) || request == Guid.Empty || !Guid.TryParse(HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var actor)) { message = "請重新整理後再試。"; return; }
        SpeedRequestResult? result = null;
        try { result = await Queue.RequestAsync(request, actor, false, HttpContext.RequestAborted); }
        catch (Exception ex) { Logger.LogWarning("Could not queue speed test: {ExceptionType}", ex.GetType().Name); message = "無法確認排程結果，請重新整理後檢查紀錄。"; }
        if (result?.Status == SpeedRequestStatus.Accepted) Navigation.NavigateTo($"/speed-tests/{result.RunId:D}", forceLoad: true);
        else if (result is not null) message = result.Status switch
        {
            SpeedRequestStatus.ConsentRequired => "同意已撤回或條件已更新，請先到設定頁確認。",
            _ => "已有待執行或進行中的測試，請從紀錄查看結果。"
        };
    }
    private sealed class StartForm { public string? RequestId { get; set; } public bool Confirm { get; set; } }
}
