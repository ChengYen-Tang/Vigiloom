@page "/settings/speed-tests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Contracts.SpeedTests
@using Vigiloom.Modules.NetworkMonitoring.Application.SpeedTests
@inject SpeedSettings Settings
@inject ILogger<SpeedSettingsPage> Logger
<PageTitle>網路測速設定 - Vigiloom</PageTitle>
<main class="device-page device-form-page">
    <header class="device-heading"><div><h1>網路測速設定</h1><p>從中央 Worker 的位置量測對外路徑，與各設備的 Ping 分開。</p></div></header>
    <section class="device-panel">
        <h2>Speedtest.net 測試</h2>
        <p>測試會連線至 Speedtest.net 伺服器，並占用上下傳頻寬。資料處理方式請參閱服務提供者的條款與隱私政策。</p>
        <p><a href="https://www.speedtest.net/about/terms" target="_blank" rel="noopener noreferrer">Speedtest.net 使用條款</a> · <a href="https://www.speedtest.net/about/privacy" target="_blank" rel="noopener noreferrer">隱私政策</a></p>
        @if (error) { <p role="alert">無法讀取設定，請稍後重新整理。</p> }
        else
        {
            @if (message is not null) { <p role="status">@message</p> }
            <EditForm Model="Input" FormName="speed-settings" method="post" OnSubmit="SaveAsync">
                <DataAnnotationsValidator /><ValidationSummary /><InputHidden @bind-Value="Input.Version" /><InputHidden @bind-Value="Input.Policy" />
                <label class="device-checkbox"><InputCheckbox @bind-Value="Input.Consent" /> 我了解測試將連線至第三方服務及產生流量，並啟用中央測速。</label>
                <label class="device-checkbox"><InputCheckbox @bind-Value="Input.Automatic" /> 啟用自動測速（預設關閉）</label>
                <label for="speed-hours">自動間隔（6～168 小時，加入 ±20% 抖動）</label><InputNumber id="speed-hours" @bind-Value="Input.Hours" min="6" max="168" />
                <label for="speed-budget">每次參考流量預算（2～200 MiB，上下傳合計）</label><InputNumber id="speed-budget" @bind-Value="Input.MaxMiB" min="2" max="200" />
                <label for="speed-timeout">每次最長時間（5～60 秒）</label><InputNumber id="speed-timeout" @bind-Value="Input.Timeout" min="5" max="60" />
                <p>每個中央位置同時只執行一筆。關閉中央測速會取消待執行與進行中測試；關閉自動只停止自動測試。</p>
                <p>流量預算控制上下傳測試的負載；實際流量可能因進行中的請求及通訊開銷超過預算。</p>
                <div class="device-actions"><button type="submit">儲存測速設定</button><a href="/speed-tests">查看測速紀錄</a></div>
            </EditForm>
            @if (snapshot is not null)
            {
                <p>最近 24 小時已保留 @snapshot.ReservedToday 次，其中自動 @snapshot.AutomaticToday 次。</p>
                <p>下次自動排程（UTC）：@(snapshot.NextAutomaticAt?.ToString("u") ?? "未啟用")</p>
            }
        }
    </section>
</main>
@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "speed-settings")] private SpeedForm Input { get; set; } = default!;
    private SpeedSettingsSnapshot? snapshot;
    private bool error;
    private string? message;
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        try
        {
            snapshot = await Settings.GetAsync(HttpContext.RequestAborted);
            if (HttpMethods.IsGet(HttpContext.Request.Method)) Input = new() { Automatic = snapshot.Automatic, Hours = snapshot.IntervalHours,
                MaxMiB = snapshot.MaxMiB, Timeout = snapshot.TimeoutSeconds, Consent = snapshot.Consent, Version = snapshot.Version, Policy = snapshot.ConsentPolicy };
        }
        catch (Exception ex) { Logger.LogWarning("Could not load speed settings: {ExceptionType}", ex.GetType().Name); error = true; }
    }
    private async Task SaveAsync(EditContext context)
    {
        if (!context.Validate() || !Guid.TryParse(HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var actor)) return;
        var input = new SpeedSettingsInput(Input.Automatic, Input.Hours, Input.MaxMiB, Input.Timeout, Input.Consent, Input.Version, Input.Policy);
        if (!SpeedSettings.Valid(input)) { message = "請檢查數值範圍；啟用自動測試前須先同意使用條件。"; return; }
        try
        {
            if (await Settings.UpdateAsync(input, actor, HttpContext.RequestAborted) is { } saved)
            {
                snapshot = saved; Input.Version = saved.Version; message = "設定已儲存；中央 Worker 會使用新設定，同意撤回即阻止新的測試。";
            }
            else message = "設定已被其他操作變更，請重新整理後再試。";
        }
        catch (Exception ex) { Logger.LogWarning("Could not save speed settings: {ExceptionType}", ex.GetType().Name); message = "無法確認儲存結果，請重新整理後檢查。"; }
    }
    private sealed class SpeedForm
    {
        public bool Automatic { get; set; }
        public int Hours { get; set; } = 6;
        public int MaxMiB { get; set; } = 200;
        public int Timeout { get; set; } = 60;
        public bool Consent { get; set; }
        public string? Policy { get; set; }
        public string? Version { get; set; }
    }
}
