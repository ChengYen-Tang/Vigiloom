@page "/settings/service-deployments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Contracts.Services
@using Vigiloom.Modules.Resources.Application
@using Vigiloom.Modules.ServiceObservability.Application
@using Vigiloom.Web.ServiceDetails
@inject IDeploymentLinks Links
@inject IDeviceManagement Devices
@inject Vigiloom.Web.Services.InstanceManagement Instances
@inject Vigiloom.Web.Services.IApplicationManagement Applications
@inject ILogger<ServiceDeployments> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<ServiceAdminText> L

<PageTitle>@L["部署關聯"] - Vigiloom</PageTitle>
<main class="device-page">
    <header class="device-heading"><div><h1>@L["部署關聯"]</h1><p>@L["依已核實的部署資料，為應用執行個體建立選配的主機導覽。"]</p></div></header>
    @if (error is not null) { <p class="device-alert" role="alert">@error</p> }
    @if (message is not null) { <p role="status">@message</p> }
    @if (selected is not null)
    {
        <p><a href="@($"/services/{selected.Id:D}")">@L["返回 {0}", selected.Name]</a></p>
        <section class="device-panel">
            <h2>@L["目前關聯"]</h2>
            <p>@L["關聯不代表即時部署狀態，也不改變服務或設備的公開設定。請勿在確認依據中輸入密碼或憑證。"]</p>
            @if (links is null) { <p>@L["無法載入關聯。"]</p> }
            else if (links.Items.Count == 0) { <p>@L["此頁沒有尚未解除的關聯。"]</p> }
            else
            {
                <p class="scroll-hint">@L["左右滑動查看完整關聯資訊。"]</p>
                <div class="table-scroll" tabindex="0" role="region" aria-label="@L["部署關聯，可左右捲動"]"><table><thead><tr><th>@L["主機"]</th><th>@L["服務執行個體"]</th><th>@L["確認依據"]</th><th>@L["狀態"]</th></tr></thead><tbody>
                    @foreach (var item in links.Items)
                    {
                        <tr @key="item.Id"><td>@item.DeviceName</td><td>@item.InstanceName</td><td>@item.Evidence</td><td>@(item.DeviceArchived || item.InstanceRetired || item.SourceRevoked || item.ServiceStopped ? L["來源或資源已停用，請檢查"].Value : L["未解除"].Value)</td></tr>
                    }
                </tbody></table></div>
                <EditForm Model="EndForm" FormName="deployment-end" OnSubmit="EndAsync">
                    <label for="end-link">@L["要結束的關聯"]</label>
                    <InputSelect id="end-link" @bind-Value="EndForm.Selection"><option value="">@L["請選擇"]</option>@foreach (var item in links.Items) { <option value="@($"{item.Id:D}|{item.Version}")">@item.DeviceName · @item.InstanceName</option> }</InputSelect>
                    <button type="submit">@L["結束關聯"]</button>
                </EditForm>
            }
            <nav aria-label="@L["關聯分頁"]">@if (linkPage > 1) { <a href="@PageUrl(linkPage - 1, devicePage, instancePage)">@L["上一頁"]</a> } <span>@L["第 {0} 頁", linkPage]</span> @if (links?.HasMore == true) { <a href="@PageUrl(linkPage + 1, devicePage, instancePage)">@L["下一頁"]</a> }</nav>
        </section>
        <section class="device-panel">
            <h2>@L["建立關聯"]</h2>
            <EditForm Model="CreateForm" FormName="deployment-create" OnSubmit="CreateAsync">
                <label for="deployment-device">@L["主機設備"]</label>
                <InputSelect id="deployment-device" @bind-Value="CreateForm.DeviceId"><option value="">@L["請選擇"]</option>@foreach (var device in devices) { <option value="@device.Id">@device.Name</option> }</InputSelect>
                <label for="deployment-instance">@L["服務執行個體"]</label>
                <InputSelect id="deployment-instance" @bind-Value="CreateForm.InstanceId"><option value="">@L["請選擇"]</option>@foreach (var instance in instances.Where(x => x.RetiredAt is null)) { <option value="@instance.Id">@instance.ExternalInstanceId</option> }</InputSelect>
                <label for="deployment-evidence">@L["確認依據"]</label>
                <InputText id="deployment-evidence" @bind-Value="CreateForm.Evidence" maxlength="512" />
                <button type="submit">@L["建立關聯"]</button>
            </EditForm>
            <nav aria-label="@L["主機設備分頁"]">@L["設備："]@if (devicePage > 1) { <a href="@PageUrl(linkPage, devicePage - 1, instancePage)">@L["上一頁"]</a> } <span>@L["第 {0} 頁", devicePage]</span> @if (moreDevices) { <a href="@PageUrl(linkPage, devicePage + 1, instancePage)">@L["下一頁"]</a> }</nav>
            <nav aria-label="@L["服務執行個體分頁"]">@L["執行個體："]@if (instancePage > 1) { <a href="@PageUrl(linkPage, devicePage, instancePage - 1)">@L["上一頁"]</a> } <span>@L["第 {0} 頁", instancePage]</span> @if (instances.Count == 50 && instancePage < 1000) { <a href="@PageUrl(linkPage, devicePage, instancePage + 1)">@L["下一頁"]</a> }</nav>
        </section>
    }
</main>
