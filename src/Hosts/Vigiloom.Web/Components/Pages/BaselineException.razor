@page "/devices/{DeviceId:guid}/baseline-exception"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Vigiloom.Contracts.Agent.Baseline
@using Vigiloom.Modules.SecurityAnalysis.Application.Baseline
@inject BaselineQuery Query
@inject BaselineExceptions Exceptions
@inject NavigationManager Navigation
@inject ILogger<BaselineException> Logger

<PageTitle>新增基準例外說明 - Vigiloom</PageTitle>
<main class="device-page">
    <header class="device-heading"><div><h1>新增基準例外說明</h1><p>記錄此設備的原因；不會變更檢查結果或停止檢查。</p></div></header>
    <p><a href="@($"/devices/{DeviceId:D}")">返回設備</a></p>
    @if (message is not null) { <p class="device-alert" role="alert">@message</p> }
    @if (check is not null)
    {
        <section class="device-panel">
            <h2>@check.Title</h2>
            <p>檢查版本：@RevisionId</p>
            <EditForm Model="Input" FormName="baseline-exception" method="post" OnValidSubmit="SaveAsync" class="baseline-exception-form">
                <DataAnnotationsValidator /><ValidationSummary />
                <label for="baseline-exception-reason">例外原因</label>
                <InputTextArea id="baseline-exception-reason" @bind-Value="Input.Reason" rows="4" maxlength="200" />
                <p>請勿填入密碼或其他機密。唯讀使用者也能查看此說明。</p>
                <button type="submit">儲存說明</button>
            </EditForm>
        </section>
    }
</main>

@code {
    [Parameter] public Guid DeviceId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "source")] private string? SourceKey { get; set; }
    [SupplyParameterFromQuery(Name = "revision")] private Guid? RevisionId { get; set; }
    [SupplyParameterFromForm(FormName = "baseline-exception")] private ExceptionForm Input { get; set; } = default!;
    private BaselineCheckView? check;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (string.IsNullOrWhiteSpace(SourceKey) || RevisionId is null) { message = "請從設備頁選擇基準版本。"; return; }
        var view = await Query.GetAsync(DeviceId, HttpContext.RequestAborted);
        check = view?.Checks.SingleOrDefault(x => x.SourceKey == SourceKey && x.ActiveRevisionId == RevisionId);
        if (check is null) message = "基準版本已變更或無法使用，請回設備頁重新選擇。";
    }

    private async Task SaveAsync()
    {
        if (check is null || RevisionId is not { } revision || !Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor))
        { message = "登入或基準版本已失效，請重新整理。"; return; }
        try
        {
            var result = await Exceptions.RecordAsync(DeviceId, SourceKey!, revision, Input.Reason, actor, HttpContext.RequestAborted);
            if (result == BaselineExceptionStatus.Recorded) { Navigation.NavigateTo($"/devices/{DeviceId:D}"); return; }
            message = result == BaselineExceptionStatus.VersionChanged ? "基準版本已變更，請回設備頁重新選擇。" : "無法儲存說明，請檢查內容後再試。";
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            Logger.LogWarning("Unable to record baseline explanation: {ErrorType}", ex.GetType().Name);
            message = "無法儲存說明，請稍後再試。";
        }
    }

    private sealed class ExceptionForm { [Required, StringLength(200)] public string Reason { get; set; } = ""; }
}
