@page "/settings/audit/retention"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Vigiloom.Contracts.Operations
@using Vigiloom.Modules.AlertingOperations.Application.Retention
@inject AuditRetentionSettings Retention
@inject ILogger<AuditRetentionPage> Logger

<PageTitle>操作紀錄保存 - Vigiloom</PageTitle>
<main class="device-page device-form-page">
    <header class="device-heading"><div><h1>操作紀錄保存</h1><p>管理中央設定、設備、背景工作、帳號與 API 憑證操作紀錄的保存期限。</p></div></header>
    <section class="device-panel">
        <p>此期限適用於中央設定、設備、背景工作、帳號與 API 憑證操作紀錄；Agent 等其他來源不在此期限內。首次管理員初始化紀錄與尚未結束的背景工作操作會保留。到期後定期清理，延長期限無法還原已刪除資料。</p>
        @if (loadError) { <p class="device-alert" role="alert">無法讀取保存設定，請重新整理後再試。</p> }
        else if (snapshot is not null)
        {
            @if (message is not null) { <p role="status">@message</p> }
            <EditForm Model="Input" FormName="audit-retention" method="post" OnValidSubmit="SubmitAsync">
                <InputHidden @bind-Value="Input.Version" />
                <InputHidden @bind-Value="Input.ConfirmationToken" />
                <label for="audit-retention-days">保存天數（1～3650 天）</label>
                <InputNumber id="audit-retention-days" @bind-Value="Input.Days" min="1" max="3650" required />
                @if (preview is { } impact)
                {
                    <p role="status">以 @impact.PreviewedAt.ToString("u") 為準，預計有 @impact.AffectedRecords 筆操作紀錄符合清理條件；實際數量可能變動。</p>
                    <p>確認後將依排程清理；預覽在 5 分鐘內有效。</p>
                    <div class="device-actions"><button type="submit">確認儲存</button><a href="/settings/audit/retention">取消</a></div>
                }
                else { <div class="device-actions"><button type="submit">預覽變更</button><a href="/settings/audit">返回操作稽核</a></div> }
            </EditForm>
        }
    </section>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "audit-retention")] private RetentionForm Input { get; set; } = default!;
    private AuditRetentionSnapshot? snapshot;
    private AuditRetentionPreview? preview;
    private bool loadError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        try
        {
            snapshot = await Retention.GetAsync(HttpContext.RequestAborted);
            if (HttpMethods.IsGet(HttpContext.Request.Method)) Input = new() { Days = snapshot.Days, Version = snapshot.Version };
        }
        catch (Exception ex) { Logger.LogWarning("Could not load audit retention: {ErrorType}", ex.GetType().Name); loadError = true; }
    }

    private async Task SubmitAsync()
    {
        if (!Guid.TryParse(HttpContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var actor)) return;
        if (!AuditRetentionLimits.IsValid(Input.Days) || Input.Version is null) { message = "請輸入有效的保存天數。"; return; }
        try
        {
            if (string.IsNullOrEmpty(Input.ConfirmationToken))
            {
                preview = await Retention.PreviewAsync(new(Input.Days, Input.Version), actor, HttpContext.RequestAborted);
                if (preview is null) { message = "設定已被其他操作變更，請重新整理後再試。"; return; }
                Input.ConfirmationToken = preview.ConfirmationToken;
            }
            else if (await Retention.UpdateAsync(new(Input.Days, Input.Version, Input.ConfirmationToken), actor, HttpContext.RequestAborted) is { } saved)
            {
                snapshot = saved;
                Input = new() { Days = saved.Days, Version = saved.Version };
                message = "保存設定已儲存。";
            }
            else { Input.ConfirmationToken = null; message = "設定已被其他操作變更，請重新整理後再試。"; }
        }
        catch (ArgumentException) { Input.ConfirmationToken = null; message = "預覽已過期或天數已變更，請重新預覽。"; }
        catch (Exception ex) { Logger.LogWarning("Could not update audit retention: {ErrorType}", ex.GetType().Name); message = "無法確認儲存結果，請重新整理後檢查。"; }
    }

    private sealed class RetentionForm
    {
        public int Days { get; set; } = 365;
        public string? Version { get; set; }
        public string? ConfirmationToken { get; set; }
    }
}
