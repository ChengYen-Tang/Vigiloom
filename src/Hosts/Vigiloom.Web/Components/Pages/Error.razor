@page "/Error"
@using System.Diagnostics
@inject Microsoft.Extensions.Localization.IStringLocalizer<PageShellText> L

<PageTitle>@L["錯誤"]</PageTitle>

<h1 class="text-danger">@L["錯誤"]</h1>
<h2 class="text-danger">@L["處理要求時發生錯誤。"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["要求 ID："]</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["開發模式"]</h3>
<p>
    @L["切換至 Development 環境會顯示更詳細的錯誤資訊。"]
</p>
<p>
    <strong>@L["已部署的應用程式不應啟用 Development 環境。"]</strong>
    @L["這可能向使用者顯示例外中的敏感資訊。本機偵錯時，可將 ASPNETCORE_ENVIRONMENT 環境變數設為 Development 並重新啟動應用程式。"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
