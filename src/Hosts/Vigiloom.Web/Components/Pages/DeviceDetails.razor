@page "/devices/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.MonitoringRead)]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Components.Authorization
@using Vigiloom.Contracts.Devices
@using Vigiloom.Contracts.Agent
@using DeviceDto = Vigiloom.Contracts.Devices.DeviceDetails
@using Vigiloom.Modules.IdentityAccess.Domain
@using Vigiloom.Modules.Resources.Application
@using Vigiloom.Web.Client.Components
@using Vigiloom.Contracts.Network
@using Vigiloom.Modules.NetworkMonitoring.Application
@using Vigiloom.Modules.AgentManagement.Application
@inject DeviceManagement DevicesService
@inject PingStore Ping
@inject AgentMonitoring AgentMonitoring
@inject AgentSettingsMonitoring AgentSettingsMonitoring
@inject AgentQueueCapacityMonitoring QueueCapacityMonitoring
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject ILogger<DeviceDetails> Logger

<PageTitle>設備詳情 - Vigiloom</PageTitle>
<main class="device-page">
    <a href="/devices">← 返回設備清單</a>
    @if (error) { <p class="device-alert" role="alert">無法載入設備，請稍後重試。</p> }
    else if (device is null) { <section class="device-panel"><h1>找不到設備</h1><p>此設備不存在，請返回清單。</p></section> }
    else
    {
        <header class="device-heading"><div><h1>@device.Name</h1><p>@(device.DeepMonitoring ? "深入監控" : "僅 Ping") · @(device.Archived ? "已封存" : device.Enabled ? "監控已啟用" : "監控已停用")</p></div>
            <AuthorizeView Policy="Administrator"><Authorized>@if (!device.Archived) { <a class="device-primary" href="@($"/devices/{Id:D}/edit")">編輯設備</a> }</Authorized></AuthorizeView>
        </header>
        <section class="device-panel"><h2>監測資訊</h2><dl class="device-details"><div><dt>主要目標</dt><dd>@device.Address</dd></div><div><dt>額外目標</dt><dd>@(device.AdditionalTargets.Count == 0 ? "無" : string.Join("、", device.AdditionalTargets))</dd></div><div><dt>Ping 狀態</dt><dd>@(device.Archived ? "已封存" : !device.Enabled ? "已停用" : pingError ? "無法讀取" : pingStatus?.Targets.FirstOrDefault(x => x.Target == device.Address)?.DisplayState ?? "尚無量測資料")</dd></div><div><dt>建立時間（UTC）</dt><dd>@device.CreatedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
            @if (device.DeepMonitoring)
            {
                <div><dt>Agent 狀態</dt><dd>@(agentError ? "無法讀取" : AgentState(agentStatus?.State))</dd></div>
                <div><dt>Agent 最後回報（UTC）</dt><dd>@(agentStatus?.LastHeartbeatAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "尚無資料")</dd></div>
            }
        </dl>
            @if (device.DeepMonitoring) { <p>Agent 狀態與設備 Ping 分開判斷；@(agentStatus?.OfflineAfterSeconds ?? 90) 秒未回報顯示失聯。重新整理頁面可查看最新狀態。</p><AuthorizeView Policy="Administrator"><Authorized><a href="@($"/devices/{Id:D}/agent")">管理 Agent 身分</a></Authorized></AuthorizeView> }
        </section>
        @if (device.DeepMonitoring)
        {
            <section class="device-panel">
                <h2>Agent 本機傳送佇列</h2>
                @if (capacityError) { <p class="device-alert" role="alert">無法讀取佇列容量設定狀態。</p> }
                else if (capacityStatus is { } capacity)
                {
                    <dl class="device-details">
                        <div><dt>容量設定狀態</dt><dd>@SettingsState(capacity.State)</dd></div>
                        <div><dt>目標容量</dt><dd>@QueueBytes(capacity.Desired.Capacity.PayloadBytes)／@capacity.Desired.Capacity.BatchCount 批</dd></div>
                        <div><dt>Agent 已套用容量</dt><dd>@(capacity.Applied is { } appliedCapacity ? $"{QueueBytes(appliedCapacity.Capacity.PayloadBytes)}／{appliedCapacity.Capacity.BatchCount} 批" : "尚無已套用回報")</dd></div>
                    </dl>
                    @if (capacity.Failure is { } capacityFailure) { <p class="device-alert" role="status">@SettingsFailure(capacityFailure)</p> }
                }
                @if (agentError) { <p role="alert">無法讀取傳送狀態，請稍後重新整理。</p> }
                else
                {
                    <dl class="device-details"><div><dt>目前 Agent 最後提交批次（UTC）</dt><dd>@(agentStatus?.LastCommittedBatchAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "保留範圍內無資料")</dd></div></dl>
                    <p>顯示平台已提交的批次，不代表 Agent 已收到確認；重送相同批次不會更新時間。</p>
                    @if (agentStatus?.Queue is not { } queue) { <p>尚無佇列回報。</p> }
                    else
                    {
                    var observedAt = Clock.GetUtcNow();
                    <dl class="device-details">
                        <div><dt>最後佇列回報（UTC）</dt><dd>@queue.ReportedAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
                        @if (queue.Snapshot is { } snapshot)
                        {
                            <div><dt>等待傳送</dt><dd>@(snapshot.TotalBatches - snapshot.QuarantinedBatches) 批</dd></div>
                            <div><dt>已隔離</dt><dd>@snapshot.QuarantinedBatches 批</dd></div>
                            <div><dt>佇列容量</dt><dd>@QueueBytes(snapshot.TotalBytes) / @QueueBytes(snapshot.CapacityBytes)</dd></div>
                            <div><dt>批次容量</dt><dd>@snapshot.TotalBatches / @snapshot.CapacityBatches 批</dd></div>
                        }
                    </dl>
                    @if (queue.Snapshot is null) { <p class="device-alert" role="status">Agent 無法讀取佇列，資料狀態未知。</p> }
                    else if (queue.Snapshot.TotalBytes >= queue.Snapshot.CapacityBytes || queue.Snapshot.TotalBatches >= queue.Snapshot.CapacityBatches)
                    { <p class="device-alert" role="status">佇列已達容量，新資料可能需要等待空間。</p> }
                    @if (queue.Snapshot is { QuarantinedBatches: > 0 })
                    {
                        @if (queue.Quarantine is not { } reasons) { <p>隔離原因摘要尚未提供。</p> }
                        else
                        {
                            <p>隔離批次仍保留在 Agent，暫停自動傳送：</p>
                            <ul>
                                @if (reasons.InvalidLocalBatch > 0) { <li>本機批次格式無效：@reasons.InvalidLocalBatch 批</li> }
                                @if (reasons.BadRequest > 0) { <li>平台拒絕無效內容：@reasons.BadRequest 批</li> }
                                @if (reasons.Conflict > 0) { <li>批次內容衝突：@reasons.Conflict 批</li> }
                                @if (reasons.PayloadTooLarge > 0) { <li>批次超過平台大小限制：@reasons.PayloadTooLarge 批</li> }
                                @if (reasons.UnsupportedMediaType > 0) { <li>平台不支援批次格式：@reasons.UnsupportedMediaType 批</li> }
                                @if (reasons.Expired > 0) { <li>平台拒絕過期批次：@reasons.Expired 批</li> }
                                @if (reasons.Other > 0) { <li>其他或未知原因：@reasons.Other 批</li> }
                            </ul>
                        }
                    }
                    <p>數值是 Agent 最後一次回報的快照，可能不是目前狀態；隔離批次仍占用容量。</p>
                    @if (queue.ReportedAt > observedAt || observedAt - queue.ReportedAt >= TimeSpan.FromSeconds(agentStatus.OfflineAfterSeconds))
                    { <p class="device-alert" role="status">佇列回報已過時或時間異常，請確認 Agent 傳送狀態。</p> }
                    }
                }
            </section>
            <section class="device-panel">
                <h2>Agent 設定同步</h2>
                @if (settingsError) { <p role="alert">無法讀取設定狀態，請稍後重新整理。</p> }
                else if (settingsStatus is null) { <p>尚無設定狀態。</p> }
                else
                {
                    <dl class="device-details">
                        <div><dt>同步狀態</dt><dd>@SettingsState(settingsStatus.State)</dd></div>
                        <div><dt>期望心跳間隔</dt><dd>@settingsStatus.Desired.Settings.HeartbeatSeconds 秒</dd></div>
                        <div><dt>Agent 已套用心跳間隔</dt><dd>@(settingsStatus.Applied?.Settings.HeartbeatSeconds is { } seconds ? $"{seconds} 秒" : "尚無資料")</dd></div>
                        <div><dt>Agent 已套用設定同步間隔</dt><dd>@(settingsStatus.Applied?.Settings.SettingsPollSeconds is { } poll ? $"{poll} 秒" : "尚無資料")</dd></div>
                        <div><dt>Agent 已套用資料傳送間隔</dt><dd>@(settingsStatus.Applied?.Settings.BatchIntervalSeconds is { } batch ? $"{batch} 秒" : "尚無資料")</dd></div>
                        <div><dt>最後設定回報（UTC）</dt><dd>@(settingsStatus.ReportedAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "尚無資料")</dd></div>
                    </dl>
                    @if (settingsStatus.Failure is { } failure) { <p class="device-alert" role="status">@SettingsFailure(failure)</p> }
                    <p>設定由 Agent 定期同步；離線時顯示最後回報的狀態，不代表設定已更新。</p>
                }
                <AuthorizeView Policy="Administrator"><Authorized><a href="@($"/devices/{Id:D}/agent-settings")">編輯此設備的 Agent 設定</a></Authorized></AuthorizeView>
            </section>
        }
        <section class="device-panel"><h2>Ping 量測</h2>
            <p>每個目標分別量測，DNS 或監測器錯誤不代表設備不可達。</p>
            @if (pingStatus?.Policy is { } policy) { <p>目前每 @policy.IntervalSeconds 秒一次，逾時 @policy.TimeoutSeconds 秒；連續 @policy.FailureThreshold 次失敗判不可達、@policy.SuccessThreshold 次成功恢復。</p> }
            @if (pingError) { <p role="alert">無法讀取 Ping 資料，請稍後再試。</p> }
            else if (device.Archived || !device.Enabled) { <p>設備@(device.Archived ? "已封存" : "已停用")，不排入新量測。</p> }
            else if (pingStatus is not null)
            {
                <div class="device-table-wrap"><table><thead><tr><th>目標</th><th>實際位址</th><th>目前狀態</th><th>最近結果</th><th>成功延遲</th><th>量測時間（UTC）</th><th>位置</th></tr></thead><tbody>
                @foreach (var result in pingStatus.Targets)
                {
                    <tr><td>@result.Target</td><td>@(result.ResolvedAddress ?? "—")</td><td><PingStatusBadge Status="result" /></td><td>@Outcome(result.LastOutcome)</td><td>@(result.LatencyMilliseconds is { } latency ? $"{latency:0.###} ms" : "—")</td><td>@(result.MeasuredAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "尚無資料")</td><td>@result.Location</td></tr>
                }
                </tbody></table></div>
            }
        </section>
        <AuthorizeView Policy="Administrator"><Authorized Context="administrator">
            <section class="device-panel"><h2>@(device.Archived ? "恢復設備" : "封存設備")</h2>
                <p>@(device.Archived ? "恢復後保留原設備身分，監控維持停用；需要時可編輯啟用。" : "封存會停止後續監測並保留設備與歷史資料。應用服務不會因此刪除。")</p>
                @if (actionError is not null) { <p class="device-alert" role="alert">@actionError</p> }
                <EditForm Model="Action" FormName="device-archive" method="post" OnValidSubmit="ChangeArchiveAsync">
                    <InputHidden @bind-Value="Action.Version" />
                    <label><InputCheckbox @bind-Value="Action.Confirm" /> 我了解以上影響</label>
                    <button type="submit">@(device.Archived ? "確認恢復" : "確認封存")</button>
                </EditForm>
            </section>
        </Authorized></AuthorizeView>
    }
</main>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "device-archive")] private ArchiveInput Action { get; set; } = default!;
    private DeviceDto? device;
    private bool error;
    private DevicePingStatus? pingStatus;
    private bool pingError;
    private AgentConnectionStatus? agentStatus;
    private bool agentError;
    private AgentSettingsStatus? settingsStatus;
    private bool settingsError;
    private AgentQueueCapacityStatus? capacityStatus;
    private bool capacityError;
    private string? actionError;
    protected override async Task OnInitializedAsync()
    {
        HttpContext.Response.Headers.CacheControl = "no-store";
        Action ??= new();
        try
        {
            device = await DevicesService.GetAsync(Id, HttpContext.RequestAborted);
            if (device is not null && HttpMethods.IsGet(HttpContext.Request.Method)) Action.Version = device.Version;
            if (device?.DeepMonitoring == true)
            {
                try { agentStatus = await AgentMonitoring.GetAsync(Id, HttpContext.RequestAborted); }
                catch (Exception exception) { Logger.LogWarning("Could not load Agent status: {ExceptionType}", exception.GetType().Name); agentError = true; }
                try { settingsStatus = await AgentSettingsMonitoring.GetAsync(Id, HttpContext.RequestAborted); }
                catch (Exception exception) { Logger.LogWarning("Could not load Agent settings status: {ExceptionType}", exception.GetType().Name); settingsError = true; }
                try { capacityStatus = await QueueCapacityMonitoring.GetAsync(Id, HttpContext.RequestAborted); }
                catch (Exception exception) { Logger.LogWarning("Could not load Agent queue capacity status: {ExceptionType}", exception.GetType().Name); capacityError = true; }
            }
            if (device is { Archived: false, Enabled: true })
            {
                try { pingStatus = await Ping.GetStatusAsync(Id, device.AdditionalTargets.Prepend(device.Address).ToArray(), device.Version, HttpContext.RequestAborted); }
                catch (Exception exception) { Logger.LogWarning("Could not load Ping status: {ExceptionType}", exception.GetType().Name); pingError = true; }
            }
        }
        catch (Exception exception) { Logger.LogWarning("Could not load a device: {ExceptionType}", exception.GetType().Name); error = true; }
    }
    private async Task ChangeArchiveAsync()
    {
        if (!HttpContext.User.IsInRole(BuiltInRoles.Administrator) || device is null ||
            !Guid.TryParse(HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var actor)) return;
        if (!Action.Confirm) { actionError = "請先確認操作影響。"; return; }
        var succeeded = false;
        try
        {
            var result = await DevicesService.SetArchivedAsync(Id, !device.Archived, Action.Version, actor, HttpContext.RequestAborted);
            if (result.Status == DeviceResultStatus.Success) succeeded = true;
            else actionError = "設備狀態已變更，請重新整理後再試。";
        }
        catch (Exception exception) { Logger.LogWarning("Could not change device archival state: {ExceptionType}", exception.GetType().Name); actionError = "無法確認操作結果，請重新整理並檢查設備狀態。"; }
        if (succeeded) Navigation.NavigateTo($"/devices/{Id:D}", forceLoad: true);
    }
    private sealed class ArchiveInput { public string? Version { get; set; } public bool Confirm { get; set; } }
    private static string Outcome(PingOutcome? outcome) => outcome switch
    {
        PingOutcome.Success => "成功", PingOutcome.Timeout => "逾時", PingOutcome.Unreachable => "無法到達", PingOutcome.DnsError => "DNS 失敗",
        PingOutcome.PermissionDenied => "權限不足", PingOutcome.MonitorError => "監測器錯誤", _ => "尚無資料"
    };
    private static string AgentState(AgentConnectionState? state) => state switch
    {
        AgentConnectionState.Disabled => "監控已停用", AgentConnectionState.NotRegistered => "未註冊或已撤銷",
        AgentConnectionState.AwaitingFirstHeartbeat => "等待首次回報", AgentConnectionState.Online => "已連線",
        AgentConnectionState.Offline => "已失聯", AgentConnectionState.ClockUncertain => "系統時間異常",
        _ => "尚無資料"
    };
    private static string SettingsState(AgentSettingsApplyState state) => state switch
    {
        AgentSettingsApplyState.Disabled => "監控已停用", AgentSettingsApplyState.NotRegistered => "尚未註冊 Agent",
        AgentSettingsApplyState.WaitingForHeartbeat => "等待首次心跳", AgentSettingsApplyState.WaitingForReport => "等待設定回報",
        AgentSettingsApplyState.Pending => "待同步", AgentSettingsApplyState.Applied => "已套用",
        AgentSettingsApplyState.Failed => "同步失敗", AgentSettingsApplyState.Offline => "Agent 已失聯",
        AgentSettingsApplyState.ReportStale => "設定回報已過期",
        AgentSettingsApplyState.ClockUncertain => "系統時間異常", _ => "尚無資料"
    };
    private static string SettingsFailure(AgentConfigurationFailure failure) => failure switch
    {
        AgentConfigurationFailure.Unavailable => "無法連線至平台，Agent 會保留上次設定並重試。",
        AgentConfigurationFailure.Invalid => "收到的設定無法套用，Agent 會保留上次設定。",
        AgentConfigurationFailure.Unauthorized => "Agent 身分未獲授權，請檢查註冊狀態。",
        AgentConfigurationFailure.LocalStorage => "Agent 無法讀寫本機設定，請檢查 Agent 狀態。",
        AgentConfigurationFailure.Conflict => "設定同步發生衝突，Agent 會再次嘗試。",
        _ => "Agent 回報設定同步異常。"
    };
    private static string QueueBytes(long bytes) => bytes < 1024 * 1024
        ? $"{bytes:N0} 位元組" : $"{bytes / 1048576d:N2} MiB";
}
