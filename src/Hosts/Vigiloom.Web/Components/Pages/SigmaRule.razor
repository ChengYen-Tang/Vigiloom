@page "/settings/sigma/rule"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.Administrator)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Contracts.Intelligence
@using Vigiloom.Contracts.Agent
@using Vigiloom.Modules.SecurityAnalysis.Application.Detection
@using Vigiloom.Modules.AgentManagement.Application
@using Vigiloom.Modules.Resources.Application
@inject Vigiloom.Web.HostMonitoring.SigmaRuleAccess Inventory
@inject Vigiloom.Web.HostMonitoring.SigmaRuleAccess Rules
@inject IDeviceManagement Devices
@inject IHostLogHistory Logs
@inject TimeProvider Clock
@inject ILogger<SigmaRule> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<ServiceAdminText> L

<PageTitle>@L["規則管理"] - Vigiloom</PageTitle>
<main class="device-page sigma-rule-page">
    <a href="@BackUrl">← @L["返回行為規則"]</a>
    <header class="device-heading"><div><h1>@(rule?.Source.Title ?? L["規則管理"].Value)</h1><p>@L["使用已收集的日誌試跑規則，確認結果後再啟用。"]</p></div></header>
    @if (error is not null) { <p class="device-alert" role="alert">@error</p> }
    @if (message is not null) { <p class="sigma-message" role="status">@message</p> }
    @if (testResults is { Count: > 0 })
    {
        <section class="device-panel">
            <h2>@L["試跑結果"]</h2>
            <ul>
                @foreach (var result in testResults)
                {
                    var sample = TestInput.Selected.FirstOrDefault(x => x.AgentId == result.AgentId && x.MessageId == result.MessageId);
                    <li>@L["{0}：預期 {1}，實際 {2}", sample?.Label ?? result.MessageId.ToString(), ExpectedLabel(result.Expected.ToString()), ExpectedLabel(result.Actual.ToString())]</li>
                }
            </ul>
        </section>
    }
    @if (rule is not null && page?.Source.SourceId is { } sourceId)
    {
        <section class="device-panel">
            <h2>@L["規則狀態"]</h2>
            <p>@rule.Source.Path</p>
            <p>@L["支援狀態：{0}", rule.Supported ? L["支援試跑"].Value : L["尚不支援此規則"].Value]</p>
            <p>@L["最近試跑：{0}", rule.LatestTestPassed switch { true => L["通過"].Value, false => L["未通過"].Value, _ => L["尚未試跑"].Value }]</p>
            <p>@L["啟用狀態：{0}", rule.EnabledForCurrentSource ? L["已啟用"].Value : rule.Enabled ? L["來源或版本已變更，尚未評估"].Value : L["未啟用"].Value]</p>
            @if (rule.EnabledForCurrentSource)
            {
                <p>@L["目前生效的排除條件："]</p>
                @if (rule.ActiveExceptions is { Count: > 0 })
                {
                    <ul>@foreach (var item in rule.ActiveExceptions) { <li>@item.Field = @item.Value</li> }</ul>
                }
                else { <p>@L["無。"]</p> }
            }
            <p>@L["規則已啟用不代表設備已收集所需日誌。"]</p>
            @if (rule.Enabled || rule.Supported && rule.LatestTestPassed == true)
            {
                <EditForm Model="StateInput" FormName="sigma-rule-state" method="post" OnSubmit="ChangeStateAsync">
                    <input type="hidden" name="StateInput.SourceId" value="@StateInput.SourceId" />
                    <input type="hidden" name="StateInput.Path" value="@StateInput.Path" />
                    <input type="hidden" name="StateInput.TestId" value="@StateInput.TestId" />
                    <input type="hidden" name="StateInput.Version" value="@StateInput.Version" />
                    <input type="hidden" name="StateInput.Enable" value="@(StateInput.Enable ? "true" : "false")" />
                    <button type="submit">@(rule.Enabled ? L["停用規則"].Value : L["啟用規則"].Value)</button>
                    @if (rule.Enabled && rule.LatestTestPassed == true && rule.LatestTestId != rule.ActiveTestId)
                    {
                        <button type="submit" name="StateInput.Apply" value="true">@L["套用通過的試跑"]</button>
                    }
                </EditForm>
            }
            else if (rule.Supported) { <p>@L["請先完成通過的試跑，才能啟用。"]</p> }
        </section>
        @if (rule.Supported)
        {
            <section class="device-panel">
                <h2>@L["選擇測試日誌"]</h2>
                @if (logs is null)
                {
                <form method="get" action="/settings/sigma/rule" class="sigma-device-filter">
                    <input type="hidden" name="path" value="@Path" />
                    @if (Cursor is not null) { <input type="hidden" name="cursor" value="@Cursor" /> }
                    <label for="sigma-search">@L["搜尋設備"]</label><input id="sigma-search" name="search" value="@Search" />
                    <label for="sigma-range">@L["日誌時間"]</label><select id="sigma-range" name="hours"><option value="24" selected="@(SelectedHours == 24)">@L["最近 24 小時"]</option><option value="168" selected="@(SelectedHours == 168)">@L["最近 7 天"]</option><option value="720" selected="@(SelectedHours == 720)">@L["最近 30 天"]</option></select>
                    <button type="submit">@L["搜尋"]</button>
                    @if (devices is not null)
                    {
                        <label for="sigma-device">@L["設備"]</label><select id="sigma-device" name="device"><option value="">@L["請選擇設備"]</option>@foreach (var device in devices.Items) { <option value="@device.Id" selected="@(DeviceId == device.Id)">@device.Name</option> }</select>
                        <button type="submit">@L["查看日誌"]</button>
                    }
                </form>
                }
                @if (devices is { Total: > 50 }) { <p>@L["搜尋設備名稱可縮小範圍，目前顯示前 50 筆。"]</p> }
                @if (DeviceId is not null && logs is { Items.Count: 0 }) { <p>@L["這段時間沒有主機日誌。"]</p> }
                @if (logs is not null)
                {
                    <p>@L["對每筆案例選擇預期結果，至少包含「應命中」及「不應命中」；一次最多 20 筆。"]</p>
                    <EditForm Model="TestInput" FormName="sigma-rule-test" method="post" OnSubmit="TestAsync">
                        <input type="hidden" name="TestInput.Path" value="@TestInput.Path" />
                        <label for="sigma-exceptions">@L["本機排除條件（選填）"]</label>
                        <p>@L["每行輸入一組「欄位=值」，值以不區分大小寫的完整內容比對；符合任一條件的事件會被排除。關聯規則會在計數前排除。變更後請重新試跑並啟用。"]</p>
                        <textarea id="sigma-exceptions" name="TestInput.Exceptions" rows="3">@TestInput.Exceptions</textarea>
                        <input type="hidden" name="TestInput.LogCursor" value="@LogCursor" />
                        <input type="hidden" name="TestInput.DeviceId" value="@DeviceId" />
                        @if (TestInput.Selected.Count > 0)
                        {
                            <h3>@L["已選案例"]</h3><p>@L["可跨頁挑選；勾選移除後，按「更新案例」即可移除。"]</p>
                            <ul>@for (var selectedIndex = 0; selectedIndex < TestInput.Selected.Count; selectedIndex++)
                            {
                                var selected = TestInput.Selected[selectedIndex];
                                <li>
                                    <input type="hidden" name="@($"TestInput.Selected[{selectedIndex}].AgentId")" value="@selected.AgentId" />
                                    <input type="hidden" name="@($"TestInput.Selected[{selectedIndex}].MessageId")" value="@selected.MessageId" />
                                    <input type="hidden" name="@($"TestInput.Selected[{selectedIndex}].Expected")" value="@selected.Expected" />
                                    <input type="hidden" name="@($"TestInput.Selected[{selectedIndex}].Label")" value="@selected.Label" />
                                    <label><input type="checkbox" name="@($"TestInput.Selected[{selectedIndex}].Remove")" value="true" /> @L["移除"]</label>
                                    @selected.Label · @ExpectedLabel(selected.Expected)
                                </li>
                            }</ul>
                        }
                        <p class="sigma-scroll-hint">@L["左右滑動查看完整日誌資訊。"]</p>
                        <div class="sigma-table-wrap" role="region" tabindex="0" aria-label="@L["測試日誌，可左右捲動"]">
                            <table class="sigma-table"><thead><tr><th>@L["接收時間（UTC）"]</th><th>@L["來源與內容"]</th><th>@L["預期結果"]</th></tr></thead><tbody>
                            @for (var index = 0; index < logs.Items.Count; index++)
                            {
                                var item = logs.Items[index];
                                <tr @key="(item.AgentId, item.MessageId)"><td>@item.ReceivedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td><strong>@item.SourceName</strong>@if (item.Gap is not null) { <div>@L["採集缺口"]</div> }<pre>@item.Content</pre></td><td>
                                    <input type="hidden" name="@($"TestInput.Samples[{index}].AgentId")" value="@item.AgentId" />
                                    <input type="hidden" name="@($"TestInput.Samples[{index}].MessageId")" value="@item.MessageId" />
                                    <input type="hidden" name="@($"TestInput.Samples[{index}].Label")" value="@($"{item.SourceName} · {item.ReceivedAt:yyyy-MM-dd HH:mm:ss} UTC")" />
                                    <label for="@($"sample-{index}")">@L["案例 {0}", index + 1]</label>
                                    <select id="@($"sample-{index}")" name="@($"TestInput.Samples[{index}].Expected")"><option value="">@L["不使用"]</option><option value="Match" selected="@(SelectedExpected(item) == "Match")">@L["應命中"]</option><option value="NoMatch" selected="@(SelectedExpected(item) == "NoMatch")">@L["不應命中"]</option><option value="Unknown" selected="@(SelectedExpected(item) == "Unknown")">@L["應為未評估"]</option></select>
                                </td></tr>
                            }
                            </tbody></table>
                        </div>
                        <div class="sigma-actions">
                            <button type="submit" name="TestInput.Action" value="update">@L["更新案例"]</button>
                            @if (logs.NextCursor is not null) { <button type="submit" name="TestInput.Action" value="next">@L["加入所選並查看較早日誌"]</button> }
                            <button type="submit" name="TestInput.Action" value="run">@L["執行試跑"]</button>
                        </div>
                        @if (devices is not null)
                        {
                            <div class="sigma-device-filter">
                                <label for="sigma-next-range">@L["日誌時間"]</label><select id="sigma-next-range" name="TestInput.RangeHours"><option value="24" selected="@(SelectedHours == 24)">@L["最近 24 小時"]</option><option value="168" selected="@(SelectedHours == 168)">@L["最近 7 天"]</option><option value="720" selected="@(SelectedHours == 720)">@L["最近 30 天"]</option></select>
                                <button type="submit" name="TestInput.Action" value="range">@L["變更時間並保留案例"]</button>
                                <label for="sigma-next-search">@L["搜尋其他設備"]</label><input id="sigma-next-search" name="TestInput.DeviceSearch" value="@Search" />
                                <button type="submit" name="TestInput.Action" value="search">@L["搜尋並保留案例"]</button>
                                <label for="sigma-next-device">@L["其他設備"]</label><select id="sigma-next-device" name="TestInput.NextDevice"><option value="">@L["請選擇設備"]</option>@foreach (var device in devices.Items) { <option value="@device.Id">@device.Name</option> }</select>
                                <button type="submit" name="TestInput.Action" value="switch">@L["切換設備並保留案例"]</button>
                            </div>
                        }
                    </EditForm>
                }
            </section>
        }
    }
</main>
