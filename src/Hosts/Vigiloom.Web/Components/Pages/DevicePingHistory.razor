@page "/devices/{Id:guid}/ping-history"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.MonitoringRead)]
@attribute [ExcludeFromInteractiveRouting]
@using Vigiloom.Modules.Resources.Application
@using DeviceDto = Vigiloom.Contracts.Devices.DeviceDetails
@inject DeviceManagement Devices
@inject ILogger<DevicePingHistory> Logger

<PageTitle>設備 Ping 歷史 - Vigiloom</PageTitle>
<main class="device-page">
    <a href="@($"/devices/{Id:D}")">← 返回設備詳情</a>
    @if (error) { <p class="device-alert" role="alert">無法載入設備，請稍後再試。</p> }
    else if (device is null) { <section class="device-panel"><h1>找不到設備</h1><p>此設備不存在。</p></section> }
    else
    {
        <header class="device-heading"><div><h1>設備 Ping 歷史</h1><p class="history-device-name">@device.Name</p></div></header>
        <Vigiloom.Web.Client.Components.PingHistory.PingHistoryPanel DeviceId="Id" InitialTarget="@device.Address" @rendermode="InteractiveAuto" />
    }
</main>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private DeviceDto? device;
    private bool error;
    protected override async Task OnParametersSetAsync()
    {
        device = null; error = false;
        try { device = await Devices.GetAsync(Id, HttpContext.RequestAborted); }
        catch (OperationCanceledException) when (HttpContext.RequestAborted.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning(ex, "Unable to load device for Ping history"); error = true; }
    }
}
