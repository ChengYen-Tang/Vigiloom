@page "/devices/{DeviceId:guid}/host-logs/{AgentId:guid}/{MessageId:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Vigiloom.Web.Authentication.AccessPolicies.MonitoringRead)]
@attribute [ExcludeFromInteractiveRouting]
@using System.Security.Claims
@using Vigiloom.Contracts.Agent
@using Vigiloom.Contracts.Operations
@using Vigiloom.Web.Events
@inject Vigiloom.Web.HostMonitoring.HostLogEvidenceReader EvidenceReader
@inject EventTimelineAudit Audit
@inject ILogger<HostLogEvidence> Logger

<PageTitle>主機日誌證據 - Vigiloom</PageTitle>
<main class="evidence-page">
    <a href="@($"/devices/{DeviceId:D}?tab=logs")">← 返回設備日誌</a>
    <h1>主機日誌證據</h1>
    @if (error is not null) { <p role="alert">@error</p> }
    else if (entry is null) { <p>找不到此事件；資料可能已超過保存期限。</p> }
    else
    { <section class="evidence-panel">
        <p>來源：@entry.SourceName · 解析版本：@entry.ParserVersion · 平台接收：@entry.ReceivedAt.ToUniversalTime().ToString("u")</p>
        <p>Agent：@AgentId · 事件：@MessageId</p>
        <pre class="evidence-content">@entry.Content</pre>
      </section>
    }
</main>

@code {
    [Parameter] public Guid DeviceId { get; set; }
    [Parameter] public Guid AgentId { get; set; }
    [Parameter] public Guid MessageId { get; set; }
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    private HostLogEvidenceView? entry;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        HttpContext.Response.Headers.CacheControl = "private, no-store";
        try
        {
            entry = await EvidenceReader.GetAsync(DeviceId, AgentId, MessageId, HttpContext.RequestAborted);
            if (entry is not null)
            {
                if (!Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var actor) || actor == Guid.Empty) throw new InvalidOperationException("Missing actor.");
                await Audit.RecordEvidenceAsync(actor, new EventEvidenceAccessed("host-log", MessageId, DeviceId, AgentId), HttpContext.RequestAborted);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning("Host log evidence query failed: {ExceptionType}", ex.GetType().Name);
            error = "無法載入事件，請稍後再試。";
        }
    }

}
