@inherits LayoutComponentBase

<header class="main-header">
    <a href="/" class="main-brand">Vigiloom</a>
    <Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
        <Authorized>
            <nav class="main-account" aria-label="帳號">
                <Microsoft.AspNetCore.Components.Authorization.AuthorizeView Policy="@Vigiloom.Web.Authentication.AccessPolicies.Administrator">
                    <Authorized Context="adminState"><a href="/account/manage">帳號管理</a></Authorized>
                </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
                <a href="/account/two-factor-settings">雙重驗證</a><a href="/account/change-password">修改密碼</a><a href="/account/logout">登出</a>
            </nav>
        </Authorized>
        <NotAuthorized><a href="/account/login">登入</a></NotAuthorized>
    </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
</header>
@Body

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
