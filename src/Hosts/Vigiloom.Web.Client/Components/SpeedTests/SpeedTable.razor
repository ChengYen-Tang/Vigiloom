@inject Microsoft.Extensions.Localization.IStringLocalizer<Vigiloom.Web.Client.Components.SpeedTests.SpeedText> L
@using Vigiloom.Contracts.SpeedTests
<p>@L["共 {0} 筆紀錄 · 第 {1} 頁", Page.Total, Page.Page]</p>
<div class="device-table-wrap"><table><thead><tr><th>@L["時間（UTC）"]</th><th>@L["狀態"]</th><th>@L["下載"]</th><th>@L["上傳"]</th><th>@L["延遲"]</th><th>@L["服務端"]</th><th></th></tr></thead><tbody>
@foreach (var run in Page.Items)
{
    <tr @key="run.Id"><td>@run.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss")<br />@(run.Automatic ? L["自動"].Value : L["手動"].Value) · @run.Location</td><td><SpeedStateBadge State="run.State" /></td><td>@SpeedPresentation.Value(run.DownloadMbps, "Mbps")</td><td>@SpeedPresentation.Value(run.UploadMbps, "Mbps")</td><td>@SpeedPresentation.Value(run.LatencyMilliseconds, "ms")</td><td>@(run.Server ?? L["未選定"].Value)</td><td><a href="@($"/speed-tests/{run.Id:D}?returnUrl={Uri.EscapeDataString(ReturnUrl)}")">@L["查看結果"]</a></td></tr>
}
</tbody></table></div>
<nav class="device-pagination" aria-label="@L["測速分頁"]">
    <button type="button" disabled="@(Busy || Page.Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page.Page - 1)">@L["上一頁"]</button>
    <span>@L["第 {0} 頁", Page.Page]</span>
    <button type="button" disabled="@(Busy || (long)Page.Page * Page.PageSize >= Page.Total)" @onclick="() => PageChanged.InvokeAsync(Page.Page + 1)">@L["下一頁"]</button>
</nav>
@code {
    [Parameter, EditorRequired] public SpeedHistoryPage Page { get; set; } = default!;
    [Parameter] public string ReturnUrl { get; set; } = "/speed-tests";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
}
