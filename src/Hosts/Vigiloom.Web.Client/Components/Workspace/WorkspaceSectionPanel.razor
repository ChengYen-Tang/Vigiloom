@using Vigiloom.Contracts.Workspace

<section class="overview-panel" aria-labelledby="@HeadingId">
    <div class="overview-heading"><div><h2 id="@HeadingId">@Title</h2><p>@Description</p></div><a href="@AllHref">@AllLabel</a></div>
    @if (Section.Unavailable) { <p role="alert">無法讀取此區資料，請稍後重新整理。</p> }
    else if (Section.Total == 0) { <p>@EmptyText</p> }
    else
    {
        <p>共 @Section.Total 筆 · @Section.Attention 筆需要留意</p>
        <ul class="overview-list">
        @foreach (var item in Section.Items)
        {
            <li @key="item.Id"><div class="overview-name"><a href="@($"{ItemPath}/{item.Id:D}")">@item.Name</a><span>@item.Detail</span></div>
                <div class="overview-status"><strong class="@(item.Priority == 0 ? "danger" : item.Priority == 1 ? "attention" : item.Priority == 2 ? "good" : "muted")">@item.State</strong>
                <span>@TimeLabel：@(item.ObservedAt?.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "尚無資料") @(item.ObservedAt is null ? "" : "UTC")</span></div></li>
        }
        </ul>
        @if (Section.Total > Section.Items.Count) { <p>以上顯示優先關注的 @Section.Items.Count 筆。</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public WorkspaceSection Section { get; set; } = default!;
    [Parameter, EditorRequired] public string HeadingId { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter, EditorRequired] public string EmptyText { get; set; } = "";
    [Parameter, EditorRequired] public string TimeLabel { get; set; } = "";
    [Parameter, EditorRequired] public string ItemPath { get; set; } = "";
    [Parameter, EditorRequired] public string AllHref { get; set; } = "";
    [Parameter, EditorRequired] public string AllLabel { get; set; } = "";
}
