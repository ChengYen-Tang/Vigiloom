@using Vigiloom.Contracts.Publishing
@implements IAsyncDisposable
@inject IPublicationClient Client
@inject ILogger<TemplateManager> Logger

<div class="templates @(mode is null ? "" : "editing")" data-runtime="@RendererInfo.Name" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    @if (loading) { <p role="status">正在載入公開範本…</p> }
    else
    {
        @if (message is not null) { <p class="notice" role="@(success ? "status" : "alert")">@message</p> }
        <p class="notice guidance">設為預設不會重新指派設備；IP 位址一律不公開。</p>
        <section class="panel">
            <div class="panel-heading"><div><h2>公開範本</h2><p>設定設備可公開的欄位；更換預設不會改變既有設備。</p></div><button disabled="@Disabled" @onclick="New">新增範本</button></div>
            @if (loadFailed) { <p>無法讀取範本。</p><button disabled="@Disabled" @onclick="ReloadAsync">重試</button> }
            else if (items.Count == 0) { <p>尚無公開範本，可先新增一個。</p> }
            else
            {
                <p class="scroll-hint">左右滑動以查看設備數與操作。</p>
                <div class="table-scroll" tabindex="0" aria-label="公開範本清單，可左右捲動"><table><thead><tr><th>範本名稱</th><th>公開欄位</th><th>指派設備</th><th>操作</th></tr></thead><tbody>
                    @foreach (var item in items)
                    {
                        <tr class="@(selected?.Id == item.Id ? "selected-row" : "")"><td>@item.Name @if (item.IsDefault) { <span class="badge">預設</span> }</td><td>名稱、狀態@(item.ShowLatency ? "、延遲" : "")@(item.ShowObservedAt ? "、觀測時間" : "")</td><td>@item.AssignedCount</td>
                            <td><div class="actions"><button disabled="@Disabled" @onclick="() => Edit(item)">編輯</button><button disabled="@(Disabled || item.IsDefault)" @onclick="() => SetDefaultAsync(item)">設為預設</button><button disabled="@Disabled" @onclick="() => Retire(item)">刪除</button></div></td></tr>
                    }
                </tbody></table></div>
                @if (more) { <button disabled="@Disabled" @onclick="LoadMoreAsync">載入更多範本</button> }
            }
        </section>
        @if (mode is "new" or "edit")
        {
            <section class="panel" aria-labelledby="template-edit-heading">
                <h2 id="template-edit-heading">@(mode == "new" ? "新增範本" : "編輯範本")</h2>
                @if (selected is not null) { <p class="selection-summary">@selected.Name @if (selected.IsDefault) { <span class="badge">預設</span> } · 已指派 @selected.AssignedCount 台設備</p> }
                @if (updatePreview is null)
                {
                    <label for="template-name">範本名稱</label><input id="template-name" @bind="name" maxlength="256" disabled="@Disabled" />
                    <fieldset><legend>可公開的設備欄位</legend><p>公開名稱與簡易狀態固定顯示。</p>
                        <label><input type="checkbox" @bind="showLatency" disabled="@Disabled" /> 延遲時間</label>
                        <label><input type="checkbox" @bind="showObservedAt" disabled="@Disabled" /> 觀測時間</label>
                    </fieldset>
                    <p>IP 與主機進階資訊不會公開；歷史資料尚未開放。</p>
                    <div class="actions"><button disabled="@Disabled" @onclick="SaveOrPreviewAsync">@(mode == "new" ? "建立範本" : "預覽變更")</button><button disabled="@Disabled" @onclick="Cancel">取消</button></div>
                }
                else
                {
                    <h3>確認變更</h3><p>影響 @updatePreview.Impact.Count 台指派設備，其中 @updatePreview.Impact.PublicCount 台目前公開。</p>
                    @ImpactList()
                    <p>延遲時間：@Enabled(updatePreview.Current.ShowLatency) → @Enabled(updatePreview.Proposed.ShowLatency)；觀測時間：@Enabled(updatePreview.Current.ShowObservedAt) → @Enabled(updatePreview.Proposed.ShowObservedAt)。</p>
                    <p>範本名稱：@updatePreview.Current.Name → @updatePreview.Proposed.Name</p>
                    @SamplePreview(updatePreview.Current.ShowLatency, updatePreview.Current.ShowObservedAt, updatePreview.Proposed.ShowLatency, updatePreview.Proposed.ShowObservedAt)
                    <div class="actions"><button disabled="@Disabled" @onclick="ConfirmUpdateAsync">確認儲存</button><button disabled="@Disabled" @onclick="BackToEdit">返回修改</button></div>
                }
            </section>
        }
        @if (mode == "retire" && selected is not null)
        {
            <section class="panel" aria-labelledby="template-retire-heading"><h2 id="template-retire-heading">刪除「@selected.Name」</h2>
                @if (retirementPreview is null)
                {
                    <p>使用此範本的設備將停止匿名輸出，不會自動套用其他範本。</p>
                    @if (selected.IsDefault && items.Any(x => x.Id != selected.Id))
                    {
                        <label for="replacement">替代預設範本</label><select id="replacement" @bind="replacement" disabled="@Disabled"><option value="">請選擇</option>@foreach (var item in items.Where(x => x.Id != selected.Id)) { <option value="@item.Id.ToString()">@item.Name</option> }</select>
                        <p>替代預設只影響未指定範本的預選，不會重新指派設備。</p>
                    }
                    else if (selected.IsDefault && !more) { <p>這是最後一個範本，刪除後將清除預設。</p> }
                    @if (more) { <button disabled="@Disabled" @onclick="LoadMoreAsync">載入更多範本</button> }
                    <div class="actions"><button disabled="@Disabled" @onclick="PreviewRetirementAsync">預覽影響</button><button disabled="@Disabled" @onclick="Cancel">取消</button></div>
                }
                else
                {
                    <p>共有 @retirementPreview.Impact.Count 台設備指派此範本，其中 @retirementPreview.Impact.PublicCount 台目前公開，刪除後將停止匿名輸出。</p>
                    @ImpactList()
                    @if (retirementPreview.Current.IsDefault) { <p>替代預設：@(retirementPreview.ReplacementDefault?.Name ?? "無，將清除預設")；設備不會自動重新指派。</p> }
                    <div class="actions"><button disabled="@Disabled" @onclick="ConfirmRetirementAsync">確認刪除</button><button disabled="@Disabled" @onclick="BackToRetire">返回修改</button></div>
                }
            </section>
        }
    }
</div>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private readonly List<PublicationTemplateItem> items = [];
    private bool loading = true, busy, more, loadFailed, success;
    private int page;
    private string? message, mode, name, replacement;
    private bool showLatency, showObservedAt;
    private PublicationTemplateItem? selected, currentDefault;
    private PublicationTemplateUpdatePreview? updatePreview;
    private PublicationTemplateRetirementPreview? retirementPreview;
    private PublicationImpact? impactPage;
    private PublicationSettings? sampleSettings;
    private PublicationPreview? sample;
    private bool Disabled => busy || !RendererInfo.IsInteractive;
    protected override Task OnInitializedAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true; loadFailed = false; items.Clear(); page = 0; more = false;
        try { currentDefault = await Client.DefaultTemplateAsync(lifetime.Token); await ReadPageAsync(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning(ex, "Unable to load templates"); loadFailed = true; message = "無法載入公開範本，請重試。"; success = false; }
        finally { loading = false; }
    }
    private async Task ReadPageAsync()
    { var result = await Client.TemplatesAsync(page + 1, lifetime.Token); foreach (var item in result.Items) if (!items.Any(x => x.Id == item.Id)) items.Add(item); page = result.Page; more = result.HasMore; }
    private Task LoadMoreAsync() => RunAsync(async () => await ReadPageAsync());
    private void ClearPreview() { updatePreview = null; retirementPreview = null; impactPage = null; sample = null; sampleSettings = null; }
    private void New() { ClearPreview(); mode = "new"; selected = null; name = ""; showLatency = showObservedAt = false; message = null; }
    private void Edit(PublicationTemplateItem item) { ClearPreview(); selected = item; mode = "edit"; name = item.Name; showLatency = item.ShowLatency; showObservedAt = item.ShowObservedAt; message = null; }
    private void Retire(PublicationTemplateItem item) { ClearPreview(); selected = item; mode = "retire"; replacement = null; message = null; }
    private void Cancel() { ClearPreview(); mode = null; selected = null; }
    private void BackToEdit() => ClearPreview();
    private void BackToRetire() => ClearPreview();
    private Task SetDefaultAsync(PublicationTemplateItem item) => RunAsync(async () =>
    {
        var result = await Client.SetDefaultTemplateAsync(item.Id, new(item.Version, currentDefault?.Id, currentDefault?.Version), lifetime.Token);
        if (!Accept(result.Status)) return; message = "預設範本已更新。"; success = true; await ReloadAsync();
    });
    private Task SaveOrPreviewAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(name)) { message = "請輸入範本名稱。"; return; }
        if (mode == "new")
        {
            var result = await Client.CreateTemplateAsync(new(name, showLatency, showObservedAt), lifetime.Token);
            if (!Accept(result.Status)) return; Cancel(); message = "範本已建立。"; success = true; await ReloadAsync(); return;
        }
        if (selected is null) return;
        ClearPreview();
        var preview = await Client.PreviewTemplateUpdateAsync(selected.Id, new(name, showLatency, showObservedAt), lifetime.Token);
        if (!Accept(preview.Status) || preview.Value is null) return;
        updatePreview = preview.Value; impactPage = updatePreview.Impact;
        await LoadSampleAsync(updatePreview.Impact);
    });
    private async Task LoadSampleAsync(PublicationImpact impact)
    {
        sample = null; sampleSettings = null;
        var firstPublic = impact.Items.FirstOrDefault(x => x.Public);
        if (firstPublic is not null)
        {
            try
            {
                sampleSettings = await Client.GetAsync("devices", firstPublic.Id, lifetime.Token);
                if (sampleSettings is { Public: true } && sampleSettings.TemplateId == selected?.Id && sampleSettings.TemplateVersion == impact.TemplateVersion)
                    sample = await Client.PreviewAsync("devices", firstPublic.Id, lifetime.Token);
                else { sampleSettings = null; sample = null; }
            }
            catch (Exception ex) when (ex is not OperationCanceledException) { Logger.LogWarning(ex, "Unable to load public sample"); sample = null; sampleSettings = null; }
        }
    }
    private Task ConfirmUpdateAsync() => RunAsync(async () =>
    {
        if (selected is null || updatePreview is null) return;
        var result = await Client.ConfirmTemplateUpdateAsync(selected.Id, new(updatePreview.Confirmation), lifetime.Token);
        if (!Accept(result.Status)) { updatePreview = null; return; } Cancel(); message = "範本已更新。"; success = true; await ReloadAsync();
    });
    private Task PreviewRetirementAsync() => RunAsync(async () =>
    {
        if (selected is null) return;
        var target = items.FirstOrDefault(x => x.Id.ToString() == replacement);
        var result = await Client.PreviewTemplateRetirementAsync(selected.Id, new(target?.Id, target?.Version), lifetime.Token);
        if (Accept(result.Status)) { retirementPreview = result.Value; impactPage = retirementPreview?.Impact; }
    });
    private Task ConfirmRetirementAsync() => RunAsync(async () =>
    {
        if (selected is null || retirementPreview is null) return;
        var result = await Client.ConfirmTemplateRetirementAsync(selected.Id, new(retirementPreview.Confirmation), lifetime.Token);
        if (!Accept(result.Status)) { retirementPreview = null; return; } Cancel(); message = "範本已刪除。"; success = true; await ReloadAsync();
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return; busy = true; message = null; success = false;
        try { await action(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (UnauthorizedAccessException) { message = "登入已過期或權限已變更，請重新登入。"; }
        catch (Exception ex) { Logger.LogWarning(ex, "Template operation failed"); message = "無法完成操作，請重新整理後再試。"; }
        finally { busy = false; }
    }
    private bool Accept(TemplateOperationStatus status)
    {
        if (status == TemplateOperationStatus.Success) return true;
        message = status switch { TemplateOperationStatus.Invalid => "請檢查輸入或重新預覽。刪除預設範本時，若有其他範本請選擇替代預設。", TemplateOperationStatus.Conflict => "範本或受影響設備已變更，請重新整理並預覽。", _ => "範本不存在或已刪除，請重新整理。" };
        return false;
    }
    private static string Enabled(bool enabled) => enabled ? "公開" : "不公開";
    private static string StateText(string state) => state switch { "Operational" => "可達", "Unavailable" => "不可達", _ => "未知或尚無資料" };
    private Task ChangeImpactPageAsync(int target) => RunAsync(async () =>
    {
        var original = updatePreview?.Impact ?? retirementPreview?.Impact;
        if (selected is null || original is null) return;
        var result = await Client.TemplateImpactAsync(selected.Id, target, lifetime.Token);
        if (!Accept(result.Status) || result.Value is null || result.Value.Fingerprint != original.Fingerprint || result.Value.TemplateVersion != original.TemplateVersion)
        { ClearPreview(); message = "範本或受影響設備已變更，請重新預覽。"; return; }
        impactPage = result.Value;
        if (updatePreview is not null) await LoadSampleAsync(impactPage);
    });
    private RenderFragment ImpactList() => @<div class="impact-list">
        <h4>受影響設備</h4>
        @if (impactPage is null || impactPage.Count == 0) { <p>沒有指派設備。</p> }
        else
        {
            <ul>@foreach (var item in impactPage.Items) { <li>@item.Name（@(item.Public ? "目前公開" : "不公開")）</li> }</ul>
            <div class="actions"><button disabled="@(Disabled || impactPage.Page <= 1)" @onclick="() => ChangeImpactPageAsync(impactPage.Page - 1)">上一頁</button><span>第 @impactPage.Page 頁</span><button disabled="@(Disabled || impactPage.Page * 50 >= impactPage.Count)" @onclick="() => ChangeImpactPageAsync(impactPage.Page + 1)">下一頁</button></div>
        }
    </div>;
    private RenderFragment SamplePreview(bool oldLatency, bool oldTime, bool newLatency, bool newTime) => @<div class="comparison">
        @if (sample is null || sampleSettings is null || !sampleSettings.Public) { <p>目前這一頁沒有可顯示的公開設備資料。</p> }
        else { <div><strong>變更前</strong><p>@sampleSettings.DisplayName · @StateText(sample.State) @if (oldLatency && sample.LatencyMilliseconds is { } before) { <span>· @before.ToString("0.##") ms</span> } @if (oldTime && sample.ObservedAt is { } beforeTime) { <span>· @beforeTime.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span> }</p></div>
               <div><strong>變更後</strong><p>@sampleSettings.DisplayName · @StateText(sample.State) @if (newLatency && sample.LatencyMilliseconds is { } after) { <span>· @after.ToString("0.##") ms</span> } @if (newTime && sample.ObservedAt is { } afterTime) { <span>· @afterTime.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span> }</p></div> }
    </div>;
    public ValueTask DisposeAsync() { lifetime.Cancel(); lifetime.Dispose(); return ValueTask.CompletedTask; }
}
