@using Vigiloom.Contracts.Publishing
@implements IAsyncDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<TemplateText> L
@inject IPublicationClient Client
@inject ILogger<TemplateManager> Logger

<div class="templates @(mode is null ? "" : "editing")" data-runtime="@RendererInfo.Name" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    @if (loading) { <p role="status">@L["正在載入公開範本…"]</p> }
    else
    {
        @if (message is not null) { <p class="notice" role="@(success ? "status" : "alert")">@message</p> }
        <p class="notice guidance">@L["設為預設不會重新指派設備；IP 位址一律不公開。"]</p>
        <section class="panel">
            <div class="panel-heading"><div><h2>@L["公開範本"]</h2><p>@L["設定設備可公開的欄位；更換預設不會改變既有設備。"]</p></div><button disabled="@Disabled" @onclick="New">@L["新增範本"]</button></div>
            @if (loadFailed) { <p>@L["無法讀取範本。"]</p><button disabled="@Disabled" @onclick="ReloadAsync">@L["重試"]</button> }
            else if (items.Count == 0) { <p>@L["尚無公開範本，可先新增一個。"]</p> }
            else
            {
                <p class="scroll-hint">@L["左右滑動以查看設備數與操作。"]</p>
                <div class="table-scroll" tabindex="0" aria-label="@L["公開範本清單，可左右捲動"]"><table><thead><tr><th>@L["範本名稱"]</th><th>@L["公開欄位"]</th><th>@L["指派設備"]</th><th>@L["操作"]</th></tr></thead><tbody>
                    @foreach (var item in items)
                    {
                        <tr class="@(selected?.Id == item.Id ? "selected-row" : "")"><td>@item.Name @if (item.IsDefault) { <span class="badge">@L["預設"]</span> }</td><td>@L["名稱、狀態"]@(item.ShowLatency ? L["、目前延遲"].Value : "")@(item.ShowObservedAt ? L["、觀測時間"].Value : "")@(item.HistoryDays > 0 ? L["、歷史平均延遲（{0} 天）", item.HistoryDays].Value : "") @if (item.HistoryDays > 0 && !item.HistoryReady) { <span>@L["（歷史尚未就緒）"]</span> }</td><td>@item.AssignedCount</td>
                            <td><div class="actions"><button disabled="@Disabled" @onclick="() => Edit(item)">@L["編輯"]</button><button disabled="@(Disabled || item.IsDefault)" @onclick="() => SetDefaultAsync(item)">@L["設為預設"]</button><button disabled="@Disabled" @onclick="() => Retire(item)">@L["刪除"]</button></div></td></tr>
                    }
                </tbody></table></div>
                @if (more) { <button disabled="@Disabled" @onclick="LoadMoreAsync">@L["載入更多範本"]</button> }
            }
        </section>
        @if (mode is "new" or "edit")
        {
            <section class="panel" aria-labelledby="template-edit-heading">
                <h2 id="template-edit-heading">@(mode == "new" ? L["新增範本"].Value : L["編輯範本"].Value)</h2>
                @if (selected is not null) { <p class="selection-summary">@selected.Name @if (selected.IsDefault) { <span class="badge">@L["預設"]</span> } · @L["已指派 {0} 台設備", selected.AssignedCount]</p> }
                @if (updatePreview is null)
                {
                    <label for="template-name">@L["範本名稱"]</label><input id="template-name" @bind="name" maxlength="256" disabled="@Disabled" />
                    <fieldset><legend>@L["可公開的設備欄位"]</legend><p>@L["公開名稱與簡易狀態固定顯示。"]</p>
                        <label><input type="checkbox" @bind="showLatency" disabled="@Disabled" /> @L["目前延遲時間"]</label>
                        <label><input type="checkbox" @bind="showObservedAt" disabled="@Disabled" /> @L["觀測時間"]</label>
                    </fieldset>
                    <label for="template-history">@L["歷史平均延遲"]</label>
                    <select id="template-history" @bind="historyDays" disabled="@Disabled">
                        <option value="0">@L["不公開歷史"]</option>
                        @for (var day = 1; day <= 7; day++) { <option value="@day">@L["最近 {0} 天", day]</option> }
                    </select>
                    <div class="history-guidance">
                        <p>@L["歷史平均延遲與目前延遲可分開設定。"]</p>
                        <ul><li>@L["啟用或擴大範圍後，從變更生效時開始顯示。"]</li><li>@L["縮短範圍不重設起點。"]</li><li>@L["IP 與主機進階資訊不會公開。"]</li></ul>
                    </div>
                    <div class="actions"><button disabled="@Disabled" @onclick="SaveOrPreviewAsync">@(mode == "new" ? L["建立範本"].Value : L["預覽變更"].Value)</button><button disabled="@Disabled" @onclick="Cancel">@L["取消"]</button></div>
                }
                else
                {
                    <h3>@L["確認變更"]</h3><p>@L["影響 {0} 台指派設備，其中 {1} 台目前公開。", updatePreview.Impact.Count, updatePreview.Impact.PublicCount]</p>
                    @ImpactList()
                    <p>@L["延遲時間：{0} → {1}；觀測時間：{2} → {3}。", Enabled(updatePreview.Current.ShowLatency), Enabled(updatePreview.Proposed.ShowLatency), Enabled(updatePreview.Current.ShowObservedAt), Enabled(updatePreview.Proposed.ShowObservedAt)]</p>
                    <p>@L["範本名稱：{0} → {1}", updatePreview.Current.Name, updatePreview.Proposed.Name ?? ""]</p>
                    <p>@L["歷史平均延遲：{0} → {1}。", HistoryText(updatePreview.Current.HistoryDays), HistoryText(updatePreview.Proposed.HistoryDays ?? updatePreview.Current.HistoryDays)]</p>
                    @if (updatePreview.Proposed.HistoryDays > updatePreview.Current.HistoryDays)
                    { <p class="notice guidance">@L["啟用或擴大歷史範圍後，從變更生效時開始累積可公開資料，不會回填之前的歷史。"]</p> }
                    @SamplePreview(updatePreview.Current.ShowLatency, updatePreview.Current.ShowObservedAt, updatePreview.Proposed.ShowLatency, updatePreview.Proposed.ShowObservedAt)
                    @HistoryPreview()
                    <div class="actions"><button disabled="@Disabled" @onclick="ConfirmUpdateAsync">@L["確認儲存"]</button><button disabled="@Disabled" @onclick="BackToEdit">@L["返回修改"]</button></div>
                }
            </section>
        }
        @if (mode == "retire" && selected is not null)
        {
            <section class="panel" aria-labelledby="template-retire-heading"><h2 id="template-retire-heading">@L["刪除「{0}」", selected.Name]</h2>
                @if (retirementPreview is null)
                {
                    <p>@L["使用此範本的設備將停止匿名輸出，不會自動套用其他範本。"]</p>
                    @if (selected.IsDefault && items.Any(x => x.Id != selected.Id))
                    {
                        <label for="replacement">@L["替代預設範本"]</label><select id="replacement" @bind="replacement" disabled="@Disabled"><option value="">@L["請選擇"]</option>@foreach (var item in items.Where(x => x.Id != selected.Id)) { <option value="@item.Id.ToString()">@item.Name</option> }</select>
                        <p>@L["替代預設只影響未指定範本的預選，不會重新指派設備。"]</p>
                    }
                    else if (selected.IsDefault && !more) { <p>@L["這是最後一個範本，刪除後將清除預設。"]</p> }
                    @if (more) { <button disabled="@Disabled" @onclick="LoadMoreAsync">@L["載入更多範本"]</button> }
                    <div class="actions"><button disabled="@Disabled" @onclick="PreviewRetirementAsync">@L["預覽影響"]</button><button disabled="@Disabled" @onclick="Cancel">@L["取消"]</button></div>
                }
                else
                {
                    <p>@L["共有 {0} 台設備指派此範本，其中 {1} 台目前公開，刪除後將停止匿名輸出。", retirementPreview.Impact.Count, retirementPreview.Impact.PublicCount]</p>
                    @ImpactList()
                    @if (retirementPreview.Current.IsDefault) { <p>@L["替代預設：{0}；設備不會自動重新指派。", retirementPreview.ReplacementDefault?.Name ?? L["無，將清除預設"].Value]</p> }
                    <div class="actions"><button disabled="@Disabled" @onclick="ConfirmRetirementAsync">@L["確認刪除"]</button><button disabled="@Disabled" @onclick="BackToRetire">@L["返回修改"]</button></div>
                }
            </section>
        }
    }
</div>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private readonly List<PublicationTemplateItem> items = [];
    private bool loading = true, busy, more, loadFailed, success;
    private int page;
    private string? message, mode, name, replacement;
    private bool showLatency, showObservedAt;
    private int historyDays;
    private PublicationTemplateItem? selected, currentDefault;
    private PublicationTemplateUpdatePreview? updatePreview;
    private PublicationTemplateRetirementPreview? retirementPreview;
    private PublicationImpact? impactPage;
    private PublicationSettings? sampleSettings;
    private PublicationPreview? sample;
    private PublicDeviceHistory? sampleHistory;
    private bool historyPreviewUnavailable;
    private bool Disabled => busy || !RendererInfo.IsInteractive;
    protected override Task OnInitializedAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        loading = true; loadFailed = false; items.Clear(); page = 0; more = false;
        try { currentDefault = await Client.DefaultTemplateAsync(lifetime.Token); await ReadPageAsync(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning(ex, "Unable to load templates"); loadFailed = true; message = L["無法載入公開範本，請重試。"].Value; success = false; }
        finally { loading = false; }
    }
    private async Task ReadPageAsync()
    { var result = await Client.TemplatesAsync(page + 1, lifetime.Token); foreach (var item in result.Items) if (!items.Any(x => x.Id == item.Id)) items.Add(item); page = result.Page; more = result.HasMore; }
    private Task LoadMoreAsync() => RunAsync(async () => await ReadPageAsync());
    private void ClearPreview() { updatePreview = null; retirementPreview = null; impactPage = null; sample = null; sampleSettings = null; sampleHistory = null; historyPreviewUnavailable = false; }
    private void New() { ClearPreview(); mode = "new"; selected = null; name = ""; showLatency = showObservedAt = false; historyDays = 0; message = null; }
    private void Edit(PublicationTemplateItem item) { ClearPreview(); selected = item; mode = "edit"; name = item.Name; showLatency = item.ShowLatency; showObservedAt = item.ShowObservedAt; historyDays = item.HistoryDays; message = null; }
    private void Retire(PublicationTemplateItem item) { ClearPreview(); selected = item; mode = "retire"; replacement = null; message = null; }
    private void Cancel() { ClearPreview(); mode = null; selected = null; }
    private void BackToEdit() => ClearPreview();
    private void BackToRetire() => ClearPreview();
    private Task SetDefaultAsync(PublicationTemplateItem item) => RunAsync(async () =>
    {
        var result = await Client.SetDefaultTemplateAsync(item.Id, new(item.Version, currentDefault?.Id, currentDefault?.Version), lifetime.Token);
        if (!Accept(result.Status)) return; message = L["預設範本已更新。"].Value; success = true; await ReloadAsync();
    });
    private Task SaveOrPreviewAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(name)) { message = L["請輸入範本名稱。"].Value; return; }
        if (mode == "new")
        {
            var result = await Client.CreateTemplateAsync(new(name, showLatency, showObservedAt, historyDays), lifetime.Token);
            if (!Accept(result.Status)) return; Cancel(); message = result.Value is { HistoryDays: > 0, HistoryReady: false } ? L["範本已建立，但歷史尚未就緒；請稍後編輯並重新儲存。"].Value : L["範本已建立。"].Value; success = true; await ReloadAsync(); return;
        }
        if (selected is null) return;
        ClearPreview();
        var preview = await Client.PreviewTemplateUpdateAsync(selected.Id, new(name, showLatency, showObservedAt, historyDays), lifetime.Token);
        if (!Accept(preview.Status) || preview.Value is null) return;
        updatePreview = preview.Value; impactPage = updatePreview.Impact;
        await LoadSampleAsync(updatePreview.Impact);
    });
    private async Task LoadSampleAsync(PublicationImpact impact)
    {
        sample = null; sampleSettings = null; sampleHistory = null; historyPreviewUnavailable = false;
        var firstPublic = impact.Items.FirstOrDefault(x => x.Public);
        if (firstPublic is not null)
        {
            try
            {
                sampleSettings = await Client.GetAsync("devices", firstPublic.Id, lifetime.Token);
                if (sampleSettings is { Public: true } && sampleSettings.TemplateId == selected?.Id && sampleSettings.TemplateVersion == impact.TemplateVersion)
                {
                    sample = await Client.PreviewAsync("devices", firstPublic.Id, lifetime.Token);
                    if (updatePreview?.Current is { HistoryDays: > 0, HistoryReady: true })
                    {
                        try
                        {
                            var now = DateTimeOffset.UtcNow;
                            sampleHistory = await Client.PublishedDeviceHistoryAsync(firstPublic.Id, now.AddDays(-7), now, lifetime.Token);
                            var current = await Client.GetAsync("devices", firstPublic.Id, lifetime.Token);
                            if (current is null || !current.Public || current.Version != sampleSettings.Version ||
                                current.TemplateId != sampleSettings.TemplateId || current.TemplateVersion != sampleSettings.TemplateVersion)
                            { sampleHistory = null; sample = null; sampleSettings = null; historyPreviewUnavailable = true; }
                        }
                        catch (Exception ex) when (ex is not OperationCanceledException)
                        { Logger.LogWarning(ex, "Unable to load published history preview"); sampleHistory = null; historyPreviewUnavailable = true; }
                    }
                }
                else { sampleSettings = null; sample = null; }
            }
            catch (Exception ex) when (ex is not OperationCanceledException) { Logger.LogWarning(ex, "Unable to load public sample"); sample = null; sampleSettings = null; }
        }
    }
    private Task ConfirmUpdateAsync() => RunAsync(async () =>
    {
        if (selected is null || updatePreview is null) return;
        var result = await Client.ConfirmTemplateUpdateAsync(selected.Id, new(updatePreview.Confirmation), lifetime.Token);
        if (!Accept(result.Status)) { updatePreview = null; return; } Cancel(); message = result.Value is { HistoryDays: > 0, HistoryReady: false } ? L["範本已更新，但歷史尚未就緒；請稍後編輯並重新儲存。"].Value : L["範本已更新。"].Value; success = true; await ReloadAsync();
    });
    private Task PreviewRetirementAsync() => RunAsync(async () =>
    {
        if (selected is null) return;
        var target = items.FirstOrDefault(x => x.Id.ToString() == replacement);
        var result = await Client.PreviewTemplateRetirementAsync(selected.Id, new(target?.Id, target?.Version), lifetime.Token);
        if (Accept(result.Status)) { retirementPreview = result.Value; impactPage = retirementPreview?.Impact; }
    });
    private Task ConfirmRetirementAsync() => RunAsync(async () =>
    {
        if (selected is null || retirementPreview is null) return;
        var result = await Client.ConfirmTemplateRetirementAsync(selected.Id, new(retirementPreview.Confirmation), lifetime.Token);
        if (!Accept(result.Status)) { retirementPreview = null; return; } Cancel(); message = L["範本已刪除。"].Value; success = true; await ReloadAsync();
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return; busy = true; message = null; success = false;
        try { await action(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (UnauthorizedAccessException) { message = L["登入已過期或權限已變更，請重新登入。"].Value; }
        catch (Exception ex) { Logger.LogWarning(ex, "Template operation failed"); message = L["無法完成操作，請重新整理後再試。"].Value; }
        finally { busy = false; }
    }
    private bool Accept(TemplateOperationStatus status)
    {
        if (status == TemplateOperationStatus.Success) return true;
        message = status switch { TemplateOperationStatus.Invalid => L["請檢查輸入或重新預覽。刪除預設範本時，若有其他範本請選擇替代預設。"].Value, TemplateOperationStatus.Conflict => L["範本或受影響設備已變更，請重新整理並預覽。"].Value, _ => L["範本不存在或已刪除，請重新整理。"].Value };
        return false;
    }
    private string Enabled(bool enabled) => enabled ? L["公開"].Value : L["不公開"].Value;
    private string HistoryText(int days) => days == 0 ? L["不公開"].Value : L["最近 {0} 天", days].Value;
    private string StateText(string state) => state switch { "Operational" => L["可達"].Value, "Unavailable" => L["不可達"].Value, _ => L["未知或尚無資料"].Value };
    private Task ChangeImpactPageAsync(int target) => RunAsync(async () =>
    {
        var original = updatePreview?.Impact ?? retirementPreview?.Impact;
        if (selected is null || original is null) return;
        var result = await Client.TemplateImpactAsync(selected.Id, target, lifetime.Token);
        if (!Accept(result.Status) || result.Value is null || result.Value.Fingerprint != original.Fingerprint || result.Value.TemplateVersion != original.TemplateVersion)
        { ClearPreview(); message = L["範本或受影響設備已變更，請重新預覽。"].Value; return; }
        impactPage = result.Value;
        if (updatePreview is not null) await LoadSampleAsync(impactPage);
    });
    private RenderFragment ImpactList() => @<div class="impact-list">
        <h4>@L["受影響設備"]</h4>
        @if (impactPage is null || impactPage.Count == 0) { <p>@L["沒有指派設備。"]</p> }
        else
        {
            <ul>@foreach (var item in impactPage.Items) { <li>@item.Name（@(item.Public ? L["目前公開"].Value : L["不公開"].Value)）</li> }</ul>
            <div class="actions"><button disabled="@(Disabled || impactPage.Page <= 1)" @onclick="() => ChangeImpactPageAsync(impactPage.Page - 1)">@L["上一頁"]</button><span>@L["第 {0} 頁", impactPage.Page]</span><button disabled="@(Disabled || impactPage.Page * 50 >= impactPage.Count)" @onclick="() => ChangeImpactPageAsync(impactPage.Page + 1)">@L["下一頁"]</button></div>
        }
    </div>;
    private RenderFragment SamplePreview(bool oldLatency, bool oldTime, bool newLatency, bool newTime) => @<div class="comparison">
        @if (sample is null || sampleSettings is null || !sampleSettings.Public) { <p>@L["目前這一頁沒有可顯示的公開設備資料。"]</p> }
        else { <div><strong>@L["變更前"]</strong><p>@sampleSettings.DisplayName · @StateText(sample.State) @if (oldLatency && sample.LatencyMilliseconds is { } before) { <span>· @before.ToString("0.##") ms</span> } @if (oldTime && sample.ObservedAt is { } beforeTime) { <span>· @beforeTime.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span> }</p></div>
               <div><strong>@L["變更後"]</strong><p>@sampleSettings.DisplayName · @StateText(sample.State) @if (newLatency && sample.LatencyMilliseconds is { } after) { <span>· @after.ToString("0.##") ms</span> } @if (newTime && sample.ObservedAt is { } afterTime) { <span>· @afterTime.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</span> }</p></div> }
    </div>;
    private RenderFragment HistoryPreview() => @<div class="history-comparison">
        <div><strong>@L["目前公開的歷史"]</strong>
            @if (updatePreview?.Current.HistoryDays is not > 0) { <p>@L["目前不公開歷史。"]</p> }
            else if (historyPreviewUnavailable || sampleHistory is null) { <p>@L["目前無法取得可公開的歷史預覽。"]</p> }
            else if (sampleHistory.Points.Count == 0) { <p>@L["目前沒有可顯示的歷史資料。"]</p> }
            else { var point = sampleHistory.Points[^1]; <p>@point.From.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @(point.AverageLatencyMilliseconds is { } value ? $"{value:0.##} ms" : L["無延遲資料"].Value)</p> }
        </div>
        <div><strong>@L["變更後"]</strong>
            @if (updatePreview?.Proposed.HistoryDays is not > 0) { <p>@L["不公開歷史。"]</p> }
            else if (updatePreview.Proposed.HistoryDays > updatePreview.Current.HistoryDays) { <p>@L["最多 {0} 天；從變更生效後開始累積，不公開之前的歷史。", updatePreview.Proposed.HistoryDays.Value]</p> }
            else if (historyPreviewUnavailable || sampleHistory?.AsOf is null) { <p>@L["目前無法取得可公開的歷史預覽。"]</p> }
            else if (sampleHistory.Points.LastOrDefault(x => x.From >= sampleHistory.AsOf.Value.AddDays(-updatePreview.Proposed.HistoryDays.Value)) is { } after)
            { <p>@after.From.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC · @(after.AverageLatencyMilliseconds is { } value ? $"{value:0.##} ms" : L["無延遲資料"].Value)</p> }
            else { <p>@L["此範圍沒有可顯示的歷史資料。"]</p> }
            <p>@L["顯示已結束的五分鐘平均延遲；資料可能持續彙整。"]</p>
        </div>
    </div>;
    public ValueTask DisposeAsync() { lifetime.Cancel(); lifetime.Dispose(); return ValueTask.CompletedTask; }
}
