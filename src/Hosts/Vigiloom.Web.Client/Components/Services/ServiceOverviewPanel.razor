@using Vigiloom.Contracts.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject IServiceDetailsClient Client
@inject ILogger<ServiceOverviewPanel> Logger
@inject Microsoft.Extensions.Localization.IStringLocalizer<ServiceText> L

<div class="service-overview" data-runtime="@(OperatingSystem.IsBrowser() ? "WebAssembly" : "Server")" data-interactive="@(interactive ? "true" : "false")">
@if (loading)
{
    <p role="status">@L["正在載入服務資料…"]</p>
}
else if (error is not null)
{
    <p class="service-error" role="alert">@error</p>
    <button type="button" @onclick="LoadAsync">@L["重新載入"]</button>
}
else if (service is null)
{
    <section class="service-card"><h1>@L["找不到服務"]</h1><p>@L["服務不存在或已無法存取。"]</p></section>
}
else
{
    <header class="service-heading"><h1>@service.Name</h1><p>@L["環境："]@service.Environment · @(service.CollectionStopped ? L["收集已停止"].Value : service.SourceRevoked ? L["來源已撤銷"].Value : L["已加入"].Value)</p><p><a href="@($"/services/connect?service={ServiceId:D}")">@L["查看接入導引"]</a></p></header>
    <section class="service-card" aria-labelledby="health-heading">
        <h2 id="health-heading">@L["服務健康"]</h2>
        <p>@L["健康歷史保存 {0} 天；超過期限的資料可能已清除。進行中的狀態區間仍會保留。", service.HealthRetentionDays]</p>
        <p class="service-state">@L["目前狀態："]<strong class="@HealthClass(health?.State)">@(healthError ? L["無法讀取"].Value : HealthName(health?.State))</strong></p>
        @if (health is { UnknownReasons: not ServiceHealthUnknownReason.None }) { <p>@HealthReasons(health.UnknownReasons)</p> }
        <p>@L["健康狀態依已設定的檢查判斷，不代表主機或網路狀態。"]@(health is { UnknownParticipants: > 0 } ? L["有 {0} 個檢查資料不足。", health.UnknownParticipants].Value : "")</p>
        <AuthorizeView Roles="Administrator"><Authorized><p><a href="@($"/settings/service-health?service={ServiceId:D}")">@L["管理健康檢查"]</a></p></Authorized></AuthorizeView>
        <button type="button" class="health-evidence-button" disabled="@(!interactive || healthEvidenceLoading)" @onclick="() => LoadHealthEvidenceAsync(1)">@L["查看健康檢查依據"]</button>
        @if (healthEvidenceLoading) { <p role="status">@L["正在載入健康檢查依據…"]</p> }
        @if (healthEvidenceError) { <p role="alert">@L["無法讀取健康檢查依據，請稍後再試。"]</p> }
        @if (healthEvidence is not null)
        {
            <p>@L["以下為每個檢查最近一次觀察，可能已過期，請以目前狀態為準。"]</p>
            @if (healthEvidence.Items.Count == 0) { <p>@L["此頁尚無健康檢查觀察。"]</p> }
            else { <div class="service-table" tabindex="0" role="region" aria-label="@L["健康檢查依據表格，可左右滑動"]"><table><thead><tr><th>@L["檢查識別碼"]</th><th>@L["最近觀察"]</th><th>@L["觀察時間（UTC）"]</th><th>@L["接收時間（UTC）"]</th></tr></thead><tbody>
                @foreach (var observation in healthEvidence.Items) { <tr @key="observation.TargetId"><td>@observation.TargetId</td><td>@ObservationName(observation.Kind)</td><td>@Format(observation.ObservedAt)</td><td>@Format(observation.ReceivedAt)</td></tr> }
            </tbody></table></div> }
            @if (healthEvidencePage > 1 || healthEvidence.HasMore) { <div class="service-actions"><button type="button" disabled="@(healthEvidenceLoading || healthEvidencePage == 1)" @onclick="() => LoadHealthEvidenceAsync(healthEvidencePage - 1)">@L["上一頁"]</button><span>@L["第 {0} 頁", healthEvidencePage]</span><button type="button" disabled="@(healthEvidenceLoading || !healthEvidence.HasMore)" @onclick="() => LoadHealthEvidenceAsync(healthEvidencePage + 1)">@L["下一頁"]</button></div> }
        }
        <div class="service-actions range-actions"><button type="button" aria-pressed="@(selectedRange == 1 ? "true" : "false")" disabled="@(!interactive)" @onclick="() => ChangeRangeAsync(1)">@L["最近 1 小時"]</button><button type="button" aria-pressed="@(selectedRange == 24 ? "true" : "false")" disabled="@(!interactive)" @onclick="() => ChangeRangeAsync(24)">@L["最近 24 小時"]</button><button type="button" aria-pressed="@(selectedRange == 168 ? "true" : "false")" disabled="@(!interactive)" @onclick="() => ChangeRangeAsync(168)">@L["最近 7 天"]</button></div>
        <div class="service-actions"><label>@L["開始時間（UTC）"]<input type="datetime-local" step="1" disabled="@(!interactive)" value="@startText" @onchange="ChangeStart" /></label><label>@L["結束時間（UTC）"]<input type="datetime-local" step="1" disabled="@(!interactive)" value="@endText" @onchange="ChangeEnd" /></label><button type="button" disabled="@(!interactive)" @onclick="ApplyRangeAsync">@L["查詢"]</button></div>
        @if (rangeError is not null) { <p class="service-error" role="alert">@rangeError</p> }
        @if (historyError) { <p role="alert">@L["無法載入健康歷史，請縮短時間範圍或重新整理。"]</p> }
        else if (history is null) { <p>@L["尚無健康歷史資料。"]</p> }
        else
        {
            <p>@L["資料涵蓋率 {0}；可用率 {1}。時間為 UTC。", history.Coverage.ToString("P1"), history.Availability is { } value ? value.ToString("P2") : L["資料不足"].Value]</p>
            @if (history.Intervals.Count == 0) { <p>@L["此時間範圍沒有健康狀態資料。"]</p> }
            else {
                @if (history.Intervals.Count <= 200) {
                    <div class="health-timeline" aria-hidden="true">@foreach (var interval in history.Intervals) { <span class="@HealthClass(interval.State)" style="@TimelineWidth(interval)" title="@($"{Format(interval.Start)} – {Format(interval.End)}：{HealthName(interval.State)}")"></span> }</div>
                    <p class="health-legend"><span class="health-healthy">@L["正常"]</span><span class="health-degraded">@L["降級"]</span><span class="health-unhealthy">@L["異常"]</span><span class="health-unknown">@L["未知或資料不足"]</span>@L["；詳細時間與文字狀態如下。"]</p>
                }
                <details><summary>@L["以表格查看健康歷史（{0} 個區間）", history.Intervals.Count]</summary>
                <p class="scroll-hint">@L["表格可左右滑動查看完整內容。"]</p><div class="service-table" tabindex="0" role="region" aria-label="@L["健康歷史表格，可左右滑動"]"><table><thead><tr><th>@L["開始"]</th><th>@L["結束"]</th><th>@L["狀態"]</th><th>@L["資料不足的檢查"]</th></tr></thead><tbody>
                @foreach (var interval in history.Intervals.Skip((historyPage - 1) * 50).Take(50)) { <tr><td>@Format(interval.Start)</td><td>@Format(interval.End)</td><td>@HealthName(interval.State)</td><td>@interval.UnknownParticipants</td></tr> }
            </tbody></table></div>
            @if (history.Intervals.Count > 50) { <div class="service-actions"><button type="button" disabled="@(!interactive || historyPage == 1)" @onclick="() => historyPage--">@L["上一頁"]</button><span>@L["第 {0} 頁", historyPage]</span><button type="button" disabled="@(!interactive || historyPage * 50 >= history.Intervals.Count)" @onclick="() => historyPage++">@L["下一頁"]</button></div> }
            </details>
            }
        }
    </section>
    <section class="service-card" aria-labelledby="deployments-heading">
        <h2 id="deployments-heading">@L["部署關聯"]</h2>
        <p>@L["關聯由管理員依據部署資料確認，僅供導覽；不代表目前服務健康，也不會公開主機資訊。"]</p>
        <AuthorizeView Roles="Administrator"><Authorized><p><a href="@($"/settings/service-deployments?service={ServiceId:D}")">@L["管理部署關聯"]</a></p></Authorized></AuthorizeView>
        <button type="button" class="health-evidence-button" disabled="@(!interactive || deploymentsLoading)" @onclick="() => LoadDeploymentsAsync(1)">@L["查看關聯主機"]</button>
        @if (deploymentsLoading) { <p role="status">@L["正在載入部署關聯…"]</p> }
        @if (deploymentsError) { <p role="alert">@L["無法讀取部署關聯，請稍後再試。"]</p> }
        @if (deployments is not null)
        {
            @if (deployments.Items.Count == 0) { <p>@L["目前沒有管理員確認的關聯。"]</p> }
            else
            {
                <p class="scroll-hint">@L["表格可左右滑動查看完整內容。"]</p>
                <div class="service-table" tabindex="0" role="region" aria-label="@L["部署關聯表格，可左右滑動"]"><table><thead><tr><th>@L["主機"]</th><th>@L["執行個體"]</th><th>@L["確認依據"]</th><th>@L["目前狀態"]</th></tr></thead><tbody>
                    @foreach (var item in deployments.Items)
                    {
                        <tr @key="item.Id"><td><a href="@($"/devices/{item.DeviceId:D}")">@item.DeviceName</a></td><td>@item.InstanceName</td><td>@item.Evidence</td><td>@(item.DeviceArchived ? L["設備已封存；"].Value : "")@(item.InstanceRetired ? L["執行個體已退役；"].Value : "")@(item.SourceRevoked ? L["來源已撤銷；"].Value : "")@(item.ServiceStopped ? L["服務已停收；"].Value : "")@(!item.DeviceArchived && !item.InstanceRetired && !item.SourceRevoked && !item.ServiceStopped ? L["未解除"].Value : L["請檢查關聯"].Value)</td></tr>
                    }
                </tbody></table></div>
            }
            @if (deploymentsPage > 1 || deployments.HasMore) { <div class="service-actions"><button type="button" disabled="@(deploymentsLoading || deploymentsPage == 1)" @onclick="() => LoadDeploymentsAsync(deploymentsPage - 1)">@L["上一頁"]</button><span>@L["第 {0} 頁", deploymentsPage]</span><button type="button" disabled="@(deploymentsLoading || !deployments.HasMore)" @onclick="() => LoadDeploymentsAsync(deploymentsPage + 1)">@L["下一頁"]</button></div> }
        }
    </section>
    <section class="service-card" aria-labelledby="http-metrics-heading">
        <h2 id="http-metrics-heading">@L["HTTP 服務指標"]</h2>
        @if (metricsError) { <p role="alert">@L["無法讀取 HTTP 指標，請重新載入。"]</p> }
        else if (httpMetrics is not { State: "Available" }) {
            <p>@MetricStatus(httpMetrics?.State)</p>
            <div class="metric-cards"><div><span>@L["平均回應延遲"]</span><strong>@(httpMetrics?.State == "NoData" ? L["尚無資料"].Value : L["暫無法計算"].Value)</strong></div><div><span>@L["錯誤率"]</span><strong>@(httpMetrics?.State == "NoData" ? L["尚無資料"].Value : L["暫無法計算"].Value)</strong></div></div>
        }
        else
        {
            <p>@L["收到的觀測區間（UTC）：{0} 至 {1}", Format(httpMetrics.ObservedFrom!.Value), Format(httpMetrics.ObservedTo!.Value)]</p>
            <div class="metric-cards"><div><span>@L["請求數"]</span><strong>@httpMetrics.RequestCount</strong></div><div><span>@L["平均回應延遲"]</span><strong>@(httpMetrics.MeanDurationMilliseconds is { } duration ? $"{duration:F2} ms" : L["無有效請求"].Value)</strong></div><div><span>@L["錯誤率"]</span><strong>@(httpMetrics.ErrorRatio is { } ratio ? ratio.ToString("P2") : L["資料不足"].Value)</strong></div></div>
            <p>@L["依收到的 HTTP duration histogram 計算；錯誤包含 HTTP 5xx 或 error.type。資料缺漏或來源重送可能影響觀測，不能保證涵蓋所有請求。"]</p>
        }
    </section>
    <section class="service-card" aria-labelledby="instances-heading">
        <h2 id="instances-heading">@L["服務執行個體"]</h2>
        @if (instancesError) { <p role="alert">@L["無法讀取執行個體，請重新載入。"]</p> }
        else if (instances is null || instances.Items.Count == 0) { <p>@L["目前沒有已識別的執行個體。"]</p> }
        else { <p class="scroll-hint">@L["表格可左右滑動查看完整內容。"]</p><div class="service-table" tabindex="0" role="region" aria-label="@L["服務執行個體表格，可左右滑動"]"><table><thead><tr><th>@L["來源識別"]</th><th>@L["狀態"]</th><th>@L["建立時間（UTC）"]</th></tr></thead><tbody>
            @foreach (var instance in instances.Items) { <tr @key="instance.Id"><td>@instance.Name</td><td>@(instance.Retired ? L["已退役"].Value : L["未退役"].Value)</td><td>@Format(instance.CreatedAt)</td></tr> }
        </tbody></table></div> }
        @if (page > 1 || instances?.HasMore == true) { <div class="service-actions"><button type="button" disabled="@(!interactive || page == 1)" @onclick="PreviousAsync">@L["上一頁"]</button><span>@L["第 {0} 頁", page]</span><button type="button" disabled="@(!interactive || instances?.HasMore != true)" @onclick="NextAsync">@L["下一頁"]</button></div> }
    </section>
    <section class="service-card" aria-labelledby="evidence-heading">
        <h2 id="evidence-heading">@L["觀測與證據"]</h2>
        <p>@L["最後接收（UTC）：Logs {0} · Metrics {1} · Traces {2}", service.LastLogReceivedAt is { } logTime ? LastReceived(logTime) : L["尚無資料或目前無法取得"].Value, LastReceived(service.LastMetricReceivedAt), LastReceived(service.LastTraceReceivedAt)]</p>
        <p>@L["使用上方 UTC 時間範圍查詢日誌或追蹤；每次最多 31 天。Logs 保存 {0} 天，Traces 保存 {1} 天；實際資料依接收及清理狀況而定。", service.LogRetentionDays, service.TraceRetentionDays]</p>
        <div class="service-actions"><button type="button" disabled="@(!interactive)" @onclick="() => LoadEvidenceAsync(false, 1)">@L["查看 Logs"]</button><button type="button" disabled="@(!interactive)" @onclick="() => LoadEvidenceAsync(true, 1)">@L["查看 Traces"]</button></div>
        @if (evidenceLoading) { <p role="status">@L["正在載入證據…"]</p> }
        @if (evidenceError is not null) { <p role="alert">@evidenceError</p> }
        @if (logs is not null)
        {
            <h3>@L["Logs（日誌）"]</h3>
            @if (activeTraceId is not null) { <p>Trace ID：@activeTraceId <button type="button" @onclick="() => LoadEvidenceAsync(false, 1)">@L["清除篩選"]</button></p> }
            @if (logs.Items.Count == 0) { <p>@L["這段時間沒有日誌資料。"]</p> }
            else { <p class="scroll-hint">@L["表格可左右滑動查看完整內容。"]</p><div class="service-table" tabindex="0" role="region" aria-label="@L["服務日誌表格，可左右滑動"]"><table><thead><tr><th>@L["時間（UTC）與來源"]</th><th>@L["等級"]</th><th>@L["內容"]</th><th>Trace ID</th></tr></thead><tbody>
                @foreach (var item in logs.Items) { <tr><td>@Format(item.OccurredAt)<br /><small>@(item.UsedReceivedTime ? L["接收時間"].Value : item.UsedObservedTime ? L["觀察時間"].Value : L["來源時間"].Value)</small></td><td>@item.Severity</td><td class="evidence-body">@item.Body @if (item.BodyTruncated) { <span>@L["（內容已截短）"]</span> }</td><td>@(item.TraceId ?? "—")</td></tr> }
            </tbody></table></div> }
            @if (logs.Truncated) { <p>@L["結果達到查詢上限，請縮短時間範圍。"]</p> }
        }
        @if (traces is not null)
        {
            <h3>@L["Traces（追蹤）"]</h3>
            @if (traces.Items.Count == 0) { <p>@L["這段時間沒有追蹤資料。"]</p> }
            else { <p class="scroll-hint">@L["表格可左右滑動查看完整內容。"]</p><div class="service-table" tabindex="0" role="region" aria-label="@L["服務追蹤表格，可左右滑動"]"><table><thead><tr><th>@L["開始時間（UTC）"]</th><th>@L["操作"]</th><th>@L["狀態"]</th><th>Trace ID</th><th>Span ID</th><th>@L["相關證據"]</th></tr></thead><tbody>
                @foreach (var item in traces.Items) { <tr><td>@Format(item.StartedAt)</td><td>@item.Name</td><td>@item.Status</td><td>@item.TraceId</td><td>@item.SpanId</td><td><button type="button" @onclick="() => LoadEvidenceAsync(false, 1, item.TraceId)">@L["查看相關 Logs"]</button></td></tr> }
            </tbody></table></div> }
            @if (traces.Truncated) { <p>@L["結果達到查詢上限，請縮短時間範圍。"]</p> }
        }
        @if (logs is not null || traces is not null)
        {
            <div class="service-actions"><button type="button" disabled="@(evidencePage == 1)" @onclick="() => LoadEvidenceAsync(showTraces, evidencePage - 1, activeTraceId)">@L["上一頁"]</button><span>@L["第 {0} 頁", evidencePage]</span><button type="button" disabled="@(!EvidenceHasMore)" @onclick="() => LoadEvidenceAsync(showTraces, evidencePage + 1, activeTraceId)">@L["下一頁"]</button></div>
        }
    </section>
}
</div>
