@using Vizor.ECharts
@inject Microsoft.Extensions.Localization.IStringLocalizer<ChartText> L

<figure class="time-series-chart" data-runtime="@RendererInfo.Name">
    <figcaption>@Title @if (!string.IsNullOrWhiteSpace(Unit)) { <span>(@Unit)</span> }</figcaption>
    @if (Points.Count == 0)
    {
        <p>@L["目前沒有資料。"]</p>
    }
    else
    {
        <div role="img" aria-label="@Title"><EChart @key="options" Options="options" Width="auto" Height="280px" /></div>
        <details>
            <summary>@L["以表格查看資料"]</summary>
            <table><thead><tr><th scope="col">@L["時間（UTC）"]</th><th scope="col">@L["數值"] @Unit</th></tr></thead><tbody>
                @foreach (var point in Points)
                {
                    <tr><td>@point.Time.ToUniversalTime().ToString("u")</td><td>@(point.Value?.ToString("G") ?? L["無資料"].Value)</td></tr>
                }
            </tbody></table>
        </details>
    }
</figure>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public IReadOnlyList<TimeSeriesPoint> Points { get; set; } = [];
    private ChartOptions options = new();
    protected override void OnParametersSet() => options = CreateOptions(Points);
    internal static ChartOptions CreateOptions(IReadOnlyList<TimeSeriesPoint> points) => new()
        {
            UseUTC = true,
            XAxis = new() { Type = AxisType.Time, SplitNumber = 4, AxisLabel = new() { HideOverlap = true } },
            YAxis = new() { Type = AxisType.Value },
            Series = new() { new LineSeries { Data = points.Select(point => new object?[] { point.Time.ToUnixTimeMilliseconds(), point.Value }).ToArray(), ConnectNulls = false } }
        };
}
