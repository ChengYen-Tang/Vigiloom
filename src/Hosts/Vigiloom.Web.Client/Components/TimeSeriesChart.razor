@using Vizor.ECharts

<figure class="time-series-chart">
    <figcaption>@Title @if (!string.IsNullOrWhiteSpace(Unit)) { <span>(@Unit)</span> }</figcaption>
    @if (Points.Count == 0)
    {
        <p>目前沒有資料。</p>
    }
    else
    {
        <div role="img" aria-label="@Title"><EChart Options="options" Width="100%" Height="280px" /></div>
        <details>
            <summary>以表格查看資料</summary>
            <table><thead><tr><th scope="col">時間（UTC）</th><th scope="col">數值 @Unit</th></tr></thead><tbody>
                @foreach (var point in Points)
                {
                    <tr><td>@point.Time.ToUniversalTime().ToString("u")</td><td>@(point.Value?.ToString("G") ?? "無資料")</td></tr>
                }
            </tbody></table>
        </details>
    }
</figure>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public IReadOnlyList<TimeSeriesPoint> Points { get; set; } = [];
    private ChartOptions options = new();
    protected override void OnParametersSet()
    {
        options = new ChartOptions
        {
            XAxis = new() { Type = AxisType.Category, Data = Points.Select(point => point.Time.ToUniversalTime().ToString("u")).ToArray() },
            YAxis = new() { Type = AxisType.Value },
            Series = new() { new LineSeries { Data = Points.Select(point => point.Value).ToArray(), ConnectNulls = false } }
        };
    }
}
