@using Vigiloom.Contracts.Publishing

<section class="public-section" aria-labelledby="public-devices-title">
    <h2 id="public-devices-title">對外網路設備</h2>
    <p>顯示管理員允許公開的連線狀態與延遲。</p>
    @if (Items.Count == 0)
    {
        <p>目前沒有可顯示的公開設備。</p>
    }
    else
    {
        <div class="public-head" aria-hidden="true"><span>設備名稱</span><span>目前狀態</span><span>延遲與觀測時間</span></div>
        <ul class="public-rows">
            @foreach (var device in Items)
            {
                <li @key="device.Id">
                    <button type="button" class="name" aria-label="@device.Name" aria-expanded="@(SelectedId == device.Id ? "true" : "false")" aria-controls="@(SelectedId == device.Id ? $"device-history-{device.Id:D}" : null)" @onclick="() => OnSelect.InvokeAsync(device.Id)">@device.Name<span class="history-hint">查看延遲歷史</span></button>
                    <StatusLabel State="device.State" />
                    @if (device.LatencyMilliseconds is { } latency) { <span>@latency.ToString("0.##") ms</span> }
                    @if (device.ObservedAt is { } observed) { <time datetime="@observed.ToString("O")">@observed.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</time> }
                    @if (SelectedId == device.Id && ChildContent is not null)
                    { <div id="@($"device-history-{device.Id:D}")" class="device-history">@ChildContent</div> }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PublicDevice> Items { get; set; } = [];
    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<Guid> OnSelect { get; set; }
}
