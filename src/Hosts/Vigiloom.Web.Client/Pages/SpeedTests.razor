@inject Microsoft.Extensions.Localization.IStringLocalizer<Vigiloom.Web.Client.Components.SpeedTests.SpeedText> L
@using Microsoft.AspNetCore.Components.Authorization
@page "/speed-tests"
@rendermode InteractiveAuto
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = WorkspaceAccess.MonitoringRead)]
@implements IAsyncDisposable
@using Vigiloom.Contracts.SpeedTests
@using Vigiloom.Contracts.Workspace
@using Vigiloom.Web.Client.Components.SpeedTests
@inject ISpeedHistoryClient History
@inject IWorkspaceIdentityClient Identity
@inject NavigationManager Navigation
@inject ILogger<SpeedTests> Logger
<PageTitle>@L["網路測速"] - Vigiloom</PageTitle>
<main class="device-page" data-runtime="@RendererInfo.Name">
    <header class="device-heading"><div><h1>@L["網路測速"]</h1><p>@L["中央位置的對外路徑品質，與單台設備 Ping／應用服務健康分開。"]</p></div>
        <AuthorizeView Roles="Administrator"><Authorized><div class="device-actions"><a href="/settings/speed-tests">@L["測速設定"]</a></div></Authorized></AuthorizeView>
    </header>
    <section class="device-panel"><SpeedFilters Query="query" Changed="ChangeQuery" Busy="@(loading || !RendererInfo.IsInteractive)" /><p><a href="@FilterUrl">@L["開啟目前篩選的連結"]</a></p></section>
    @if (invalid) { <p class="device-alert" role="alert">@L["日期範圍須在 31 天內，頁碼與排序須有效。"]</p> }
    else if (unauthorized) { <section class="device-panel" role="alert"><h2>@L["登入已過期或權限已變更"]</h2><p>@L["請重新登入後繼續。"]</p><a href="/account/login?returnUrl=%2Fspeed-tests">@L["前往登入"]</a></section> }
    else if (error) { <section class="device-panel" role="alert"><h2>@L["暫時無法載入測速紀錄"]</h2><p>@L["請確認連線後重新嘗試。"]</p><button type="button" @onclick="LoadAsync">@L["重新嘗試"]</button></section> }
    else if (Result is { } result)
    {
        @if (loading) { <p role="status">@L["正在更新…"]</p> }
        <section class="device-panel"><h2>@L["上下傳趨勢"]</h2><SpeedTrends Runs="result.Trend" Truncated="result.TrendTruncated" /></section>
        <section class="device-panel"><h2>@L["測速紀錄"]</h2>
            @if (result.Items.Count == 0) { <p>@L["這段時間沒有符合條件的測速紀錄。系統會依排程自動測速。"]</p> }
            else { <SpeedTable Page="result" ReturnUrl="@FilterUrl" Busy="@(loading || !RendererInfo.IsInteractive)" PageChanged="ChangePage" /> }
            <p>@L["非完成狀態的數值是已觀測的部分結果；缺資料顯示「—」，不代表 0 Mbps。"]</p>
            <p>@L["目前最早可用紀錄（UTC）：{0}", result.EarliestAvailableAt?.ToString("u") ?? L["尚無資料"].Value]</p>
            <p>@L["測速紀錄保存期限：{0} 天。逾期資料在排程清理前可能仍可查詢。", result.RetentionDays]</p>
        </section>
    }
    else { <p role="status">@L["正在載入測速紀錄…"]</p> }
</main>
