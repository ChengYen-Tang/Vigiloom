# Example application SDK configuration; use your deployment platform's secret store.
# Replace the service, environment and Collector endpoint before use.
OTEL_SERVICE_NAME=example-service
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ASP.NET Core application logging filter; not the SDK's internal OTEL_LOG_LEVEL.
Logging__LogLevel__Default=Information

# Supply OTEL_EXPORTER_OTLP_HEADERS separately as a protected secret.
# It must carry the Collector ingress token for the selected trust scope.
