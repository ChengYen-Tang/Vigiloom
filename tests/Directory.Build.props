<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
  </PropertyGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Tests'))">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TestEnvironment.cs" Link="TestEnvironment.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
